# Copy to backend/.env for local development only. Never commit backend/.env.
# --- Required ---
# MongoDB MUST support transactions (replica set / Atlas). A standalone mongod makes grocery checkout return 503.
# Local dev replica set (scripts/mongo/setup.sh): mongodb://127.0.0.1:27018/?replicaSet=rs0
# Docker Compose (infra/mongodb): mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
# Atlas/managed: supply through the secret store only. See docs/mongodb/MONGODB_SETUP.md
MONGO_URL=mongodb://127.0.0.1:27018/?replicaSet=rs0
DB_NAME=comein_dev
# Optional guard: when set, the application refuses to connect to a different database.
MONGO_EXPECTED_DB_NAME=comein_dev
# Production requires an explicitly TLS-enabled URI or MONGO_TLS=true, plus MONGO_EXPECTED_DB_NAME.
# Pool/timeout defaults are bounded in backend/mongo_config.py; override only after load testing.
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=0
MONGO_MAX_CONNECTING=4
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=20000
MONGO_WAIT_QUEUE_TIMEOUT_MS=10000
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
# Set APP_ENV=production only with explicit trusted CORS_ORIGINS (comma-separated; no wildcard).
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
FINANCIAL_TIMEZONE=Asia/Kolkata
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANK_DATA_ENCRYPTION_KEY=
# Public web URL of the frontend (referral links / reset links)
PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_APP_URL=
PASSWORD_RESET_URL=

# --- Optional admin bootstrap (seeds an admin at startup). Use a real-looking domain (not .test) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional: image uploads (Emergent object storage) ---
EMERGENT_LLM_KEY=
INTEGRATION_PROXY_URL=

# --- Optional: Razorpay online payment (use TEST keys) ---
# Explicit mode is mandatory with keys. Non-production rejects LIVE keys;
# production rejects TEST keys. Never put either secret in Expo public variables.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GROCERY_ONLINE_PAYMENTS_ENABLED=false

# --- Optional: password reset email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Optional: CHAND AI assistant (empty provider = catalog-only mode) ---
# Options: openai_compatible or ollama
COMEIN_AI_PROVIDER=
COMEIN_AI_BASE_URL=
COMEIN_AI_API_KEY=
COMEIN_AI_MODEL=
# Optional OpenAI-compatible speech-to-text model; audio is processed in memory only.
COMEIN_STT_MODEL=whisper-1

# --- Optional: Delivery Partner onboarding (use managed secret storage in production) ---
# Generate a distinct Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never reuse BANK_DATA_ENCRYPTION_KEY. Keep this key in a managed secret store and back it up securely.
DELIVERY_PARTNER_DATA_ENCRYPTION_KEY=
# Vendor-specific adapters are intentionally disabled until an authorized provider is selected,
# contract-tested, and implemented. Do not paste Aadhaar/PAN data into the app or environment.
DELIVERY_OTP_PROVIDER_URL=
DELIVERY_OTP_PROVIDER_KEY=
DELIVERY_AADHAAR_PROVIDER_URL=
DELIVERY_AADHAAR_PROVIDER_KEY=
DELIVERY_PAN_PROVIDER_URL=
DELIVERY_PAN_PROVIDER_KEY=
DELIVERY_PARTNER_DOCUMENT_STORAGE_URL=
DELIVERY_PARTNER_DOCUMENT_STORAGE_KEY=
