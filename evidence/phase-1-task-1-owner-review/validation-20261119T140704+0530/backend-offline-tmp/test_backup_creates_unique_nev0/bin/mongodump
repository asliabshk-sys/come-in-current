#!/usr/bin/env python3
import os, pathlib, sys
archive = next(x.split('=',1)[1] for x in sys.argv if x.startswith('--archive='))
config = next(x.split('=',1)[1] for x in sys.argv if x.startswith('--config='))
assert (os.stat(config).st_mode & 0o777) == 0o600
with open(archive, 'xb') as out:
    out.write(b'FAKE_ARCHIVE_NOT_REAL_DATABASE\n')
