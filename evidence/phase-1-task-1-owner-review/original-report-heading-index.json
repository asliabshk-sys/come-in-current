    "report": "PHASE_1_TASK_1_SECURITY_FINDINGS.md",
    "headings": [
      {
        "line": 1,
        "text": "# PHASE 1 TASK 1 \u2014 Security Findings"
      },
      {
        "line": 9,
        "text": "## Severity summary and review boundary"
      },
      {
        "line": 13,
        "text": "## SEC-01 \u2014 HIGH \u2014 Password-reset token consumption and password update are not atomic"
      },
      {
        "line": 22,
        "text": "## SEC-02 \u2014 MEDIUM \u2014 Seven-day access JWTs have no server-side session/password-version revocation"
      },
      {
        "line": 31,
        "text": "## SEC-03 \u2014 MEDIUM \u2014 IP rate-limit identity trusts caller-supplied X-Forwarded-For"
      },
      {
        "line": 40,
        "text": "## SEC-04 \u2014 MEDIUM \u2014 Authentication throttle check and increment are separate operations"
      },
      {
        "line": 49,
        "text": "## SEC-05 \u2014 MEDIUM \u2014 Legacy diagnostic status endpoint permits anonymous persistent writes"
      },
      {
        "line": 58,
        "text": "## SEC-06 \u2014 LOW \u2014 Password character limits exceed bcrypt byte limit"
      },
      {
        "line": 67,
        "text": "## SEC-07 \u2014 LOW \u2014 Blocking provider HTTP inside async payment routes"
      },
      {
        "line": 76,
        "text": "## SEC-08 \u2014 MEDIUM \u2014 Webhook size check occurs after whole request body is buffered"
      },
      {
        "line": 85,
        "text": "## Controls found and limits"
      }
    ],
    "line_count": 94,
    "text_read": true
  }
