+@pytest.mark.parametrize("delimiter", [",", ";", "\t", "|"])
+def test_csv_header_selects_separator_without_reinterpreting_cell_punctuation(delimiter):
+    import csv
+    stream = io.StringIO(newline="")
+    writer = csv.writer(stream, delimiter=delimiter)
+    writer.writerow(["name", "description"])
+    name = '=HYPERLINK("https://untrusted.invalid","click")'
+    description = 'Untrusted , ; | \t punctuation\nand a second line'
+    writer.writerow([name, description])
+
+    result = process_file("source.csv", stream.getvalue().encode("utf-8-sig"))
+
+    assert len(result.records) == 1
+    assert result.records[0]["raw_values"] == {"name": name, "description": description}
+    assert result.records[0]["normalized"]["name"] == name
+    assert result.records[0]["status"] == "NEEDS_REVIEW"
+
+
+def test_csv_quoted_header_punctuation_is_not_a_column_separator():
+    result = process_file("source.csv", b'"Product, label";price\nRice;65\n')
+    assert result.records[0]["raw_values"] == {"Product, label": "Rice", "price": "65"}
+    assert result.records[0]["normalized"]["price"] == "65"
+
