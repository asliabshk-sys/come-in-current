+      <Text style={styles.cardMeta}>Drafts only. Redemption requires an approved campaign and checkout integration.</Text>
+      <Text style={styles.cardMeta}>Enter the campaign name, kind, dates with time zones, limits in paise, funding reference, eligibility and published terms as JSON.</Text>
+      <TextInput accessibilityLabel="Promotion draft JSON" multiline value={draft} onChangeText={setDraft} style={{ color: colors.onSurface }} />
+      <ActionBtn label="Save promotion draft" onPress={async () => {
+        try {
+          await api.post("/admin/financial/promotion-drafts", JSON.parse(draft));
+          setNotice("Draft saved. Redemption remains disabled.");
+          await load();
+        } catch (error: any) { setNotice(error?.message || "Could not save draft."); }
+      }} />
+      {notice ? <Text accessibilityLiveRegion="polite" style={styles.cardMeta}>{notice}</Text> : null}
+      {rows.map((row) => <Text key={row.id} style={styles.cardMeta}>{row.name} · {row.kind} · ₹{(row.budget_paise / 100).toFixed(2)} budget · draft</Text>)}
+    </> : null}
+  </View>;
+}
