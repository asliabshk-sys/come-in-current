+      <Text style={styles.cardMeta}>{JSON.stringify(selected.data.original)}</Text>
+      {selected.data.historical_tax_details ? <Text style={styles.cardMeta}>{JSON.stringify(selected.data.historical_tax_details)}</Text> : null}
+      <Text style={styles.cardMeta}>{selected.data.replacement_actions.join(", ")}</Text>
+      {!rows.find((row) => row.id === selected.id)?.financial_review.professional_tax_status ? <>
+        <TextInput placeholder="Tax treatment and reason" value={reason} onChangeText={setReason} style={{ color: colors.onSurface }} />
+        <TextInput placeholder="Professional guidance reference" value={guidance} onChangeText={setGuidance} style={{ color: colors.onSurface }} />
+        <TextInput placeholder="Proposed document type" value={documentType} onChangeText={setDocumentType} style={{ color: colors.onSurface }} />
+        <ActionBtn label="Approve professional review" onPress={() => decide("approve")} />
+        <ActionBtn label="Reject professional review" onPress={() => decide("reject")} />
+      </> : null}
+    </View> : null}
+    {notice ? <Text style={styles.cardMeta}>{notice}</Text> : null}
+  </ScrollView>;
+}
