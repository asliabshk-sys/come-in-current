+        try { setSelected({ id: row.id, data: await api.get(`/financial/tax-reviews/${row.id}`) }); }
+        catch (error: any) { setNotice(error?.message || "Could not open the case."); }
+      }} />
+      <Text style={styles.cardMeta}>{row.financial_review.professional_tax_status || "Pending professional review"}</Text>
+    </View>)}
+    {selected ? <View style={styles.card}>
