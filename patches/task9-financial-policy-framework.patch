+class PromotionPolicyDraftIn(BaseModel):
+    name: str = Field(min_length=1, max_length=100)
+    kind: Literal["welcome", "shop", "restaurant", "referral", "sponsored", "campaign", "reward"]
+    starts_at: datetime
+    expires_at: datetime
+    budget_paise: int = Field(gt=0, le=100_000_000_000, strict=True)
+    max_benefit_paise: int = Field(gt=0, le=100_000_000_000, strict=True)
+    min_order_paise: int = Field(ge=0, le=100_000_000_000, strict=True)
+    customer_budget_paise: int = Field(gt=0, le=100_000_000_000, strict=True)
+    max_redemptions: int = Field(gt=0, le=10_000_000, strict=True)
+    per_customer_limit: int = Field(gt=0, le=10_000_000, strict=True)
+    funding_reference: str = Field(min_length=1, max_length=150)
+    eligibility: str = Field(min_length=1, max_length=500)
+    terms: str = Field(min_length=1, max_length=2000)
+    cancellation_terms: str = Field(min_length=1, max_length=2000)
+    refund_terms: str = Field(min_length=1, max_length=2000)
+    shop_ids: list[str] = Field(default_factory=list, max_length=100)
+    restaurant_ids: list[str] = Field(default_factory=list, max_length=100)
+    product_ids: list[str] = Field(default_factory=list, max_length=100)
+    category_ids: list[str] = Field(default_factory=list, max_length=100)
+    stacking: bool = False
+    earning_rate_basis_points: Optional[int] = Field(default=None, ge=0, le=10000, strict=True)
+    expiry_rule_reference: Optional[str] = Field(default=None, max_length=200)
+
+
+@api.get("/admin/financial/promotion-drafts")
+async def admin_promotion_policy_drafts(_: dict = Depends(require_role("admin"))):
+    return [doc_out(row) async for row in db.financial_policy_drafts.find().sort("created_at", -1).limit(100)]
+
+
+@api.post("/admin/financial/promotion-drafts")
+async def save_promotion_policy_draft(body: PromotionPolicyDraftIn, user: dict = Depends(require_role("admin"))):
+    if body.starts_at.utcoffset() is None or body.expires_at.utcoffset() is None:
+        raise HTTPException(422, "Campaign dates must include a time zone.")
+    if body.expires_at <= body.starts_at:
+        raise HTTPException(422, "Campaign expiry must follow its start.")
+    if not body.max_benefit_paise <= body.customer_budget_paise <= body.budget_paise or body.per_customer_limit > body.max_redemptions:
+        raise HTTPException(422, "Campaign benefit and redemption caps must fit within their budgets.")
+    payload = body.model_dump()
+    for field in ("shop_ids", "restaurant_ids", "product_ids", "category_ids"):
+        if any(not value.strip() or len(value) > 100 for value in payload[field]):
+            raise HTTPException(422, "Invalid campaign eligibility reference.")
+        payload[field] = sorted(set(payload[field]))
+    digest = hashlib.sha256(json.dumps(payload, sort_keys=True, default=str).encode()).hexdigest()
+    now = now_utc()
+
+    async def apply(session):
+        record = {"_id": digest, **payload, "status": "draft", "redemption_enabled": False,
+                  "created_by": user["id"], "created_at": now}
+        result = await db.financial_policy_drafts.update_one(
+            {"_id": digest}, {"$setOnInsert": record}, upsert=True, session=session,
+        )
+        if result.upserted_id is not None:
+            await db.financial_audit.insert_one({
+                "action": "promotion_policy_drafted", "actor_id": user["id"], "policy_id": digest,
+                "budget_paise": body.budget_paise, "status": "draft", "created_at": now,
+            }, session=session)
+        return doc_out(await db.financial_policy_drafts.find_one({"_id": digest}, session=session))
+
+    # The collection's built-in _id uniqueness is sufficient.
+    return await _run_replacement_transaction(apply)
+
+
+def _verified_tax_reviewer(user: dict) -> bool:
+    ids = {account.strip() for account in os.environ.get("COMEIN_VERIFIED_TAX_REVIEWER_IDS", "").split(",")}
+    return user.get("role") == "tax_professional" and user.get("id") in ids and user.get("tax_review_active") is True
+
