+  const [documentType, setDocumentType] = useState("");
+  const [notice, setNotice] = useState("");
+  const load = useCallback(async () => {
+    try { setRows(await api.get<typeof rows>("/financial/tax-reviews/mine")); }
+    catch (error: any) { setNotice(error?.message || "Could not load assigned cases."); }
+  }, []);
+  useEffect(() => {
+    void api.get<typeof rows>("/financial/tax-reviews/mine").then(setRows).catch((error: any) => setNotice(error?.message || "Could not load assigned cases."));
+  }, []);
+  const decide = async (decision: "approve" | "reject") => {
+    if (!selected) return;
