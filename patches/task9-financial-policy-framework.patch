+        reason, guidance_reference: guidance || undefined, document_type: documentType || undefined,
+      });
+      setNotice("Professional decision recorded.");
+      setSelected(null);
+      await load();
+    } catch (error: any) { setNotice(error?.message || "Could not record decision."); }
+  };
+  return <ScrollView style={{ backgroundColor: colors.surface }} contentContainerStyle={{ padding: spacing.lg, gap: spacing.sm }}>
+    <Text style={styles.cardTitle}>Assigned tax reviews</Text>
+    {rows.map((row) => <View style={styles.card} key={row.id}>
