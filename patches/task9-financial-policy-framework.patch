+        "financial_review.professional_tax_status": 1,
+    }).sort("updated_at", -1).limit(100).to_list(length=100)
+    await db.financial_audit.insert_one({"action": "replacement_tax_queue_access", "actor_id": user["id"], "created_at": now_utc()})
+    return [doc_out(ticket) for ticket in tickets]
