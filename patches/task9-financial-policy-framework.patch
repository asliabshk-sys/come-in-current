+@api.post("/admin/restaurant/support/{ticket_id}/tax-assignment")
+async def assign_replacement_tax_review(ticket_id: str, body: TaxReviewAssignmentIn, user: dict = Depends(require_role("admin"))):
+    oid = _object_id_or_404(ticket_id, "Support ticket")
+
+    async def apply(session):
+        reviewer = doc_out(await db.users.find_one({"_id": ObjectId(body.reviewer_id)}, session=session) or {})
+        if not _verified_tax_reviewer(reviewer):
+            raise HTTPException(422, "Select an active, verified tax professional.")
+        ticket = await db.restaurant_support.find_one({"_id": oid}, session=session)
+        review = (ticket or {}).get("financial_review") or {}
+        if review.get("replacement_id") != body.replacement_id or "historical_tax_review" not in review.get("reasons", []):
+            raise HTTPException(409, "The tax review changed. Refresh the ticket.")
+        if review.get("professional_tax_status"):
+            raise HTTPException(409, "Professional decision already recorded.")
+        if review.get("tax_reviewer_id") == body.reviewer_id:
+            return {"assigned": True}
+        now = now_utc()
+        await db.restaurant_support.update_one({"_id": oid}, {"$set": {
+            "financial_review.tax_reviewer_id": body.reviewer_id, "financial_review.updated_at": now,
+        }}, session=session)
+        await db.financial_audit.insert_one({
+            "action": "replacement_tax_assignment", "ticket_id": ticket_id, "replacement_id": body.replacement_id,
+            "order_kind": ticket["order_kind"], "order_id": ticket["order_id"], "actor_id": user["id"],
+            "previous_reviewer_id": review.get("tax_reviewer_id"), "reviewer_id": body.reviewer_id, "created_at": now,
+        }, session=session)
+        return {"assigned": True}
+
+    return await _run_replacement_transaction(apply)
+
+
+@api.get("/financial/tax-reviews/mine")
