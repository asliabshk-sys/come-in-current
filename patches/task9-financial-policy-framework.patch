+function PromotionDrafts() {
+  const styles = useStyles();
+  const { colors } = useTheme();
+  const [expanded, setExpanded] = useState(false);
+  const [draft, setDraft] = useState("");
+  const [notice, setNotice] = useState("");
+  const [rows, setRows] = useState<{ id: string; name: string; kind: string; budget_paise: number }[]>([]);
+  const load = async () => {
+    try { setRows(await api.get<typeof rows>("/admin/financial/promotion-drafts")); }
+    catch (error: any) { setNotice(error?.message || "Could not load drafts."); }
+  };
+  return <View style={styles.card}>
+    <ActionBtn label={expanded ? "Hide promotion drafts" : "Open promotion drafts"} onPress={() => { setExpanded(!expanded); if (!expanded) void load(); }} />
