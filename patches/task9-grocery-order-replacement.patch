new file mode 100644
--- /dev/null
+++ b/frontend/src/components/GroceryOrderReplacements.tsx
@@ -0,0 +1,142 @@
+import { useRouter } from "expo-router";
+import { useState } from "react";
+import { Pressable, Text, View } from "react-native";
+
+import { api } from "@/src/lib/api";
+import { makeStyles, radius, spacing } from "@/src/theme";
+
+type Line = {
+  product_id: string;
+  variant_id?: string | null;
+  name: string;
+  unit?: string;
+  qty: number;
+  quantity_label?: string | null;
+  price: number;
+  line_total?: number | null;
+};
+type Totals = { subtotal: number; delivery_fee: number; total: number };
+type Offer = { id: string; item: Line; line_difference: number; totals: Totals };
+type ReplacementCase = {
+  id: string;
+  line_index: number;
+  original: Line;
+  original_line_total: number;
+  original_total: number;
+  options: Offer[];
+  keep_totals: Totals | null;
+  state: "awaiting_customer" | "rejected" | "assist_required" | "superseded" | "accepted" | "kept_unavailable";
+  final_totals?: Totals;
+};
+export type ReplacementOrder = {
+  id: string;
+  status: string;
+  customer_id?: string | null;
+  items: Line[];
+  replacements?: ReplacementCase[];
+};
+type Decision = "accept" | "reject" | "keep_unavailable";
+
+export const groceryReplacementOpenStates = ["awaiting_customer", "rejected", "assist_required"];
+const reportStatuses = ["pending_payment", "pending", "accepted", "preparing"];
+const money = (amount: number) => `₹${amount.toFixed(2)}`;
+const describe = (line: Line) => `${line.quantity_label || line.qty} × ${line.name}${line.unit ? ` · ${line.unit}` : ""}`;
+const labels = {
+  awaiting_customer: "Awaiting customer decision",
+  rejected: "Customer declined these options",
+  assist_required: "COME-IN Assist is needed for this order",
+  superseded: "Options updated by the shop",
+  accepted: "Replacement confirmed",
+  kept_unavailable: "Customer continued without this item",
+};
+
+export function GroceryOrderReplacements({ order, onChange, staff = false }: {
+  order: ReplacementOrder;
+  onChange: () => Promise<unknown>;
+  staff?: boolean;
+}) {
+  const router = useRouter();
+  const styles = useStyles();
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const cases = order.replacements ?? [];
+  const active = cases.find((entry) => groceryReplacementOpenStates.includes(entry.state));
+  const canReport = staff && Boolean(order.customer_id) && reportStatuses.includes(order.status);
+  const base = `/orders/${encodeURIComponent(order.id)}/replacements`;
+
+  async function update(path: string, body: object) {
+    if (busy) return;
+    setBusy(true);
+    setError("");
+    try {
+      await api.post(path, body);
+      await onChange();
+    } catch (cause) {
+      setError(cause && typeof cause === "object" && "message" in cause && typeof cause.message === "string"
+        ? cause.message : "Could not confirm the update. Refresh the order and try again.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const report = (line: Line, index: number, refreshCaseId?: string) =>
+    void update(base, { line_index: index, product_id: line.product_id, variant_id: line.variant_id ?? null, qty: line.qty, refresh_case_id: refreshCaseId });
+  const decide = (entry: ReplacementCase, action: Decision, optionId?: string) =>
+    void update(`${base}/${entry.id}/decision`, { action, option_id: optionId });
+  const button = (label: string, action: () => void) => (
+    <Pressable accessibilityRole="button" disabled={busy} onPress={action} style={[styles.button, busy && styles.disabled]}>
+      <Text style={styles.buttonText}>{label}</Text>
+    </Pressable>
+  );
+
+  if (!cases.length && !canReport) return null;
+
+  return <View style={styles.group}>
+    <Text style={styles.title}>Unavailable items</Text>
+    {error ? <Text accessibilityLiveRegion="polite" style={styles.error}>{error}</Text> : null}
+    {canReport && !active && order.items.map((line, index) => <View key={`${line.product_id}:${index}`}>
+      {button(`Report ${line.name}${line.unit ? ` (${line.unit})` : ""} unavailable`, () => report(line, index))}
+    </View>)}
+    {cases.filter((entry) => entry.state !== "superseded").reverse().map((entry) => {
+      const canDecide = !staff && entry === active && reportStatuses.includes(order.status) && entry.state !== "assist_required";
+      return <View style={styles.case} key={entry.id}>
+        <Text style={styles.title}>{describe(entry.original)} · {money(entry.original_line_total)} original</Text>
+        <Text style={styles.text}>{order.status === "cancelled" && entry === active ? "Order cancelled" : labels[entry.state]}</Text>
+        {entry.final_totals ? <Text style={styles.text}>Confirmed order total {money(entry.final_totals.total)} · was {money(entry.original_total)}</Text> : null}
+        {entry === active && entry.state === "awaiting_customer" && reportStatuses.includes(order.status) ? <>
+          {!entry.options.length ? <Text style={styles.text}>The shop has no matching replacements in stock right now.</Text> : null}
+          {entry.options.map((option) => <View key={option.id} style={styles.offer}>
+            <Text style={styles.text}>{describe(option.item)} · {money(option.item.line_total ?? option.item.price * option.item.qty)}</Text>
+            <Text style={styles.text}>Item difference {option.line_difference > 0 ? "+" : option.line_difference < 0 ? "−" : ""}{money(Math.abs(option.line_difference))}</Text>
+            <Text style={styles.text}>New order total {money(option.totals.total)} · delivery {money(option.totals.delivery_fee)}</Text>
+            {canDecide ? button(`Accept ${option.item.name} · ${money(option.totals.total)} total`, () => decide(entry, "accept", option.id)) : null}
+          </View>)}
+          {canDecide && entry.options.length ? button("Reject these replacements", () => decide(entry, "reject")) : null}
+        </> : null}
+        {canDecide && entry.keep_totals ? button(
+          `Keep item unavailable · ${money(entry.keep_totals.total)} total`,
+          () => decide(entry, "keep_unavailable"),
+        ) : null}
+        {canDecide && !entry.keep_totals ? <Text style={styles.text}>Without this item your order would be empty. Contact COME-IN Assist for help.</Text> : null}
+        {canReport && entry === active && entry.state !== "assist_required" && order.items[entry.line_index]
+          ? button("Refresh in-stock options", () => report(order.items[entry.line_index], entry.line_index, entry.id))
+          : null}
+      </View>;
+    })}
+    {!staff && active && reportStatuses.includes(order.status) ? button("Contact COME-IN Assist", () =>
+      router.push({ pathname: "/chand", params: { openHelp: "1", order_id: order.id, order_kind: "grocery" } }),
+    ) : null}
+  </View>;
+}
+
+const useStyles = makeStyles((colors) => ({
+  group: { gap: spacing.sm, paddingVertical: spacing.sm },
+  case: { gap: spacing.sm, padding: spacing.md, borderWidth: 1, borderRadius: radius.md, borderColor: colors.border, backgroundColor: colors.surfaceSecondary },
+  offer: { gap: spacing.sm, padding: spacing.sm, borderWidth: 1, borderRadius: radius.md, borderColor: colors.border },
+  title: { fontWeight: "800", color: colors.onSurface },
+  text: { color: colors.onSurfaceSecondary },
+  error: { color: colors.error },
+  button: { alignSelf: "flex-start", borderRadius: radius.md, backgroundColor: colors.brandPrimary, padding: spacing.sm },
+  buttonText: { color: colors.onBrandPrimary, fontWeight: "700" },
+  disabled: { opacity: 0.55 },
+}));
