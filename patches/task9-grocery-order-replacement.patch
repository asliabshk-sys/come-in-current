+    if user.get("role") not in {"shopkeeper", "admin"}:
+        raise HTTPException(status_code=403, detail="Only authorized shop staff can report an unavailable item")
+    oid = _object_id_or_404(order_id, "Order")
+
+    async def apply(session):
+        order = await db.orders.find_one({"_id": oid}, session=session)
+        if not order:
+            raise HTTPException(status_code=404, detail="Order not found")
