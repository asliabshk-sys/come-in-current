+@api.post("/orders/{order_id}/replacements/{case_id}/decision")
+async def decide_grocery_replacement(order_id: str, case_id: str, body: GroceryReplacementDecisionIn, user: dict = Depends(get_current_user)):
+    if user.get("role") != "customer":
+        raise HTTPException(status_code=403, detail="Only the customer can decide on a replacement")
+    oid = _object_id_or_404(order_id, "Order")
+
+    async def apply(session):
+        order = await db.orders.find_one({"_id": oid, "customer_id": user["id"]}, session=session)
+        cases = (order or {}).get("replacements") or []
+        case = next((entry for entry in cases if entry["id"] == case_id), None)
+        if not case:
+            raise HTTPException(status_code=404, detail="Replacement request not found")
+        decision = case.get("decision") or {}
+        if decision.get("action") == body.action and decision.get("option_id") == body.option_id:
+            return case
+        if case["state"] not in {"awaiting_customer", "rejected"} or order["status"] not in GROCERY_REPLACEMENT_ORDER_STATES:
+            raise HTTPException(status_code=409, detail="This offer is no longer open. Refresh your order or contact COME-IN Assist.")
+        if not _replacement_can_reprice(order):
+            raise HTTPException(status_code=409, detail="Contact COME-IN Assist to handle the payment adjustment.")
+        if (body.action == "accept") != bool(body.option_id):
+            raise HTTPException(status_code=422, detail="Select one offered replacement to accept")
+        if case["state"] == "rejected" and body.action != "keep_unavailable":
+            raise HTTPException(status_code=409, detail="Wait for new options or choose to continue without the item")
+        index = case["line_index"]
+        now = now_utc()
+        updates = {"replacements": cases, "updated_at": now}
+        if body.action == "reject":
+            case["state"] = "rejected"
+        else:
+            line = None
+            if body.action == "accept":
+                option = next((item for item in case["options"] if item["id"] == body.option_id), None)
+                if not option:
+                    raise HTTPException(status_code=422, detail="Select a replacement offered for this order")
+                offered = option["item"]
+                lines, shop_id = await _resolve_grocery_lines(
+                    [QuoteLineIn(product_id=offered["product_id"], variant_id=offered["variant_id"], qty=offered["qty"])], session=session,
+                )
+                line = lines[0]
+                if shop_id != order["shop_id"] or _replacement_snapshot(line) != offered:
+                    raise HTTPException(status_code=409, detail="The replacement changed. Ask the shop to refresh the options.")
+                shown_totals = option["totals"]
+            else:
+                shown_totals = case["keep_totals"]
+            totals = _replacement_totals(order, index, line)
+            if not totals:
+                raise HTTPException(status_code=409, detail="No items would remain. Contact COME-IN Assist or cancel if your order is eligible.")
+            if totals != shown_totals or order["total"] != case["original_total"]:
+                raise HTTPException(status_code=409, detail="The order total changed. Ask the shop to refresh the options.")
+            if line and not await _atomic_decrement_line(session, line):
+                raise HTTPException(status_code=409, detail="Replacement stock changed. Ask the shop for new options.")
+            # The shop confirmed the originally reserved units cannot be supplied.
+            # Do not credit those missing units back into sellable inventory.
+            updates.update({"items": _replacement_items(order, index, line), **totals})
+            case.update({"state": "accepted" if line else "kept_unavailable", "final_totals": totals})
+        case.setdefault("decision_history", []).append({"action": body.action, "option_id": body.option_id, "at": now, "customer_id": user["id"]})
+        case["decision"] = case["decision_history"][-1]
+        await db.orders.update_one({"_id": oid}, {"$set": updates}, session=session)
+        if body.action != "reject":
+            await _replacement_notify(
+                session, order, case, "Replacement confirmed" if line else "Order updated",
+                f"Your decision was saved. Your order total is ₹{totals['total']:.2f} (previously ₹{order['total']:.2f}).",
+            )
+        return case
+
+    return await _run_replacement_transaction(apply)


