+        _assert_shop_owner(shop, user)
+        if not order.get("customer_id") or order["status"] not in GROCERY_REPLACEMENT_ORDER_STATES:
+            raise HTTPException(status_code=409, detail="This order requires manual support for unavailable items")
+        cases = order.get("replacements") or []
+        refreshed = next((case for case in cases if case.get("supersedes") == body.refresh_case_id), None) if body.refresh_case_id else None
+        if refreshed:
+            return refreshed
+        items = order.get("items") or []
+        line = items[body.line_index] if body.line_index < len(items) else {}
+        if (line.get("product_id"), line.get("variant_id"), line.get("qty")) != (body.product_id, body.variant_id, body.qty):
+            raise HTTPException(status_code=409, detail="The order items changed. Refresh before reporting an item.")
+        open_case = next((case for case in cases if case["state"] in GROCERY_REPLACEMENT_OPEN_STATES), None)
+        if open_case and open_case["line_index"] != body.line_index:
+            raise HTTPException(status_code=409, detail="Resolve the existing unavailable item before reporting another")
+        if open_case and not body.refresh_case_id:
+            return open_case
+        if body.refresh_case_id and (not open_case or open_case["id"] != body.refresh_case_id):
+            raise HTTPException(status_code=409, detail="The replacement request changed. Refresh the order.")
+        if len(cases) >= 40:
+            raise HTTPException(status_code=409, detail="Contact COME-IN Assist for further changes to this order")
+        can_reprice = _replacement_can_reprice(order)
+        options = await _replacement_options(session, order, body.line_index) if can_reprice else []
+        keep_totals = _replacement_totals(order, body.line_index) if can_reprice else None
+        if open_case:
+            same_options = [{k: v for k, v in option.items() if k != "id"} for option in options] == [
+                {k: v for k, v in option.items() if k != "id"} for option in open_case["options"]
+            ]
+            if open_case["state"] != "rejected" and same_options and keep_totals == open_case["keep_totals"]:
+                return open_case
+        now = now_utc()
+        case = {
+            "id": uuid.uuid4().hex, "line_index": body.line_index, "original": _replacement_snapshot(line),
+            "original_line_total": round(_line_amount(line), 2), "original_total": order["total"], "options": options,
+            "keep_totals": keep_totals, "state": "awaiting_customer" if can_reprice else "assist_required",
+            "reported_by": user["id"], "reported_at": now, "supersedes": body.refresh_case_id,
+        }
+        if open_case:
+            open_case.update({"state": "superseded", "superseded_at": now})
+        cases.append(case)
+        await db.orders.update_one({"_id": oid}, {"$set": {"replacements": cases, "updated_at": now}}, session=session)
+        message = (
+            "Review your replacement options and choose how to continue." if options else
+            "Review the unavailable item in your order or contact COME-IN Assist."
+        )
+        await _replacement_notify(session, order, case, "An order item is unavailable", f"{line['name']} is unavailable. {message}")
+        return case
+
+    return await _run_replacement_transaction(apply)
+
