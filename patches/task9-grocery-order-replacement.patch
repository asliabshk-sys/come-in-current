+GROCERY_REPLACEMENT_ORDER_STATES = {"pending_payment", "pending", "accepted", "preparing"}
+GROCERY_REPLACEMENT_OPEN_STATES = {"awaiting_customer", "rejected", "assist_required"}
+
+
+class GroceryUnavailableIn(BaseModel):
+    line_index: int = Field(ge=0, lt=100)
+    product_id: str = Field(min_length=1, max_length=80)
+    variant_id: Optional[str] = Field(default=None, max_length=80)
+    qty: int = Field(ge=1, le=MEASURED_QTY_LIMIT)
+    refresh_case_id: Optional[str] = Field(default=None, max_length=40)
+
