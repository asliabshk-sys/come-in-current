+
+def _replacement_can_reprice(order: dict) -> bool:
+    return (
+        (order.get("payment_method"), order.get("payment_status")) in {
+            ("cod", "cod_pending"), ("pickup", "pay_at_pickup_pending"),
+            ("cash_shop", "pay_at_pickup_pending"), ("cash_shop", "pay_at_shop_pending"),
+        }
+        and not any(order.get(key) for key in ("reward_discount", "tax", "tax_amount", "gst", "razorpay_payment_id"))
+    )
+
+
+def _replacement_items(order: dict, index: int, line: Optional[dict] = None) -> list[dict]:
+    items = order["items"]
+    return items[:index] + ([line] if line else []) + items[index + 1:]
+
+
+def _replacement_totals(order: dict, index: int, line: Optional[dict] = None) -> Optional[dict]:
+    items = _replacement_items(order, index, line)
+    return _quote_totals(items, order.get("fulfillment", "delivery")) if items else None
+
+
+def _replacement_snapshot(line: dict) -> dict:
+    return {key: line.get(key) for key in (
+        "product_id", "variant_id", "name", "unit", "qty", "price", "sell_by",
+        "quantity_label", "line_total", "category_id",
+    )}
+
+
+async def _replacement_options(session, order: dict, index: int) -> list[dict]:
+    original = order["items"][index]
+    if not ObjectId.is_valid(original.get("product_id", "")):
+        return []
+    original_id = ObjectId(original["product_id"])
+    original_product = await db.products.find_one({"_id": original_id, "shop_id": order["shop_id"]}, session=session)
+    category = original.get("category_id") or (original_product or {}).get("category_id")
+    # A shared category alone can be broad. Require a shared name token for
+    # different products, and always consider other configurations of this SKU.
+    tokens = {token for token in re.findall(r"[^\W_]+", original.get("name", "").casefold()) if len(token) >= 3 and not token.isdigit()}
+    candidates = [original_product] if original_product else []
+    if category and tokens:
+        pattern = r"\b(?:" + "|".join(re.escape(token) for token in sorted(tokens)[:12]) + r")\b"
+        cursor = db.products.find({
+            "shop_id": order["shop_id"], "category_id": category,
+            "_id": {"$ne": original_id}, "available": True, "name": {"$regex": pattern, "$options": "i"},
+        }, session=session).sort("_id", 1).limit(24)
+        candidates.extend(await cursor.to_list(length=24))
+    options = []
+    for product in candidates:
+        for variant in (product.get("variants") or [{}])[:12]:
+            variant_id = variant.get("id")
+            stock = (variant or product).get("stock", 0)
+            qty = min(int(original["qty"]), int(stock or 0))
+            sell_by = product.get("sell_by") if not product.get("variants") else None
+            measured_kind = sell_by if sell_by in MEASURED_SELL_BY else None
+            if measured_kind != original.get("sell_by"):
+                continue
+            if sell_by in MEASURED_SELL_BY:
+                measure = product.get("measure") or {}
+                minimum = int(measure.get("min_qty", 1))
+                step = max(1, int(measure.get("step", 1)))
+                qty = min(qty, int(measure.get("max_qty", MEASURED_QTY_LIMIT)))
+                qty -= (qty - minimum) % step
+                if qty < minimum:
+                    continue
+            if qty < 1 or (
+                product["_id"] == original_id and variant_id == original.get("variant_id")
+                and qty == original["qty"]
+            ):
+                continue
+            try:
+                lines, _ = await _resolve_grocery_lines(
+                    [QuoteLineIn(product_id=str(product["_id"]), variant_id=variant_id, qty=qty)], session=session,
+                )
+            except HTTPException:
+                continue
+            line = lines[0]
+            options.append({
+                "id": uuid.uuid4().hex, "item": _replacement_snapshot(line),
+                "line_difference": round(_line_amount(line) - _line_amount(original), 2),
+                "totals": _replacement_totals(order, index, line),
+            })
+            if len(options) == 5:
+                return options
+    return options
+
+
+async def _replacement_notify(session, order: dict, case: dict, title: str, body: str):
+    await db.notifications.insert_one({
+        "user_id": order["customer_id"], "kind": "grocery_replacement", "title": title, "body": body[:500],
+        "data": {"order_id": str(order["_id"]), "order_kind": "grocery", "replacement_id": case["id"]},
+        "read": False, "channel": "in_app", "push_status": "not_configured", "created_at": now_utc(),
+    }, session=session)
+
+
+async def _run_replacement_transaction(callback):
+    try:
+        return await run_transaction(client, callback)
+    except HTTPException:
+        raise
+    except Exception as exc:
+        logger.exception("Grocery replacement transaction failed")
+        raise HTTPException(status_code=503, detail="The update could not be confirmed. Refresh the order before retrying.") from exc
+
