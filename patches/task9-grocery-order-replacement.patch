+"""Exercise Task 9 through the HTTP API, including real Mongo transactions."""
+
+import asyncio
+from copy import deepcopy
+import os
+from pathlib import Path
+from uuid import uuid4
+
+import pytest
+
+
+def test_grocery_replacement_http_and_transactions(monkeypatch):
+    if os.environ.get("COMEIN_RUN_LOCAL_PAYMENT_TESTS") != "1":
+        pytest.skip("requires disposable loopback MongoDB")
+    import httpx
+    from bson import ObjectId
+    from motor.motor_asyncio import AsyncIOMotorClient
+    import server
+
+    monkeypatch.setenv("JWT_SECRET", uuid4().hex)
+
+    async def scenario():
+        mongo = AsyncIOMotorClient("mongodb://127.0.0.1:27018/?replicaSet=rs0", serverSelectionTimeoutMS=3000)
+        db = mongo["comein_disposable_replacement_" + uuid4().hex]
+        monkeypatch.setattr(server, "client", mongo)
+        monkeypatch.setattr(server, "db", db)
+        try:
+            headers = {}
+            user_ids = {}
+            for actor, role in {"buyer": "customer", "other": "customer", "seller": "shopkeeper",
+                                "other_seller": "shopkeeper", "support": "support", "admin": "admin"}.items():
+                oid = ObjectId()
+                user_ids[actor] = str(oid)
+                email = f"{actor}@fixture.example"
+                await db.users.insert_one({"_id": oid, "role": role, "email": email})
+                headers[actor] = {"Authorization": "Bearer " + server.create_access_token(str(oid), role, email)}
+            shop = ObjectId()
+            await db.shops.insert_one({"_id": shop, "owner_id": user_ids["seller"], "status": "approved"})
+            product_ids = {}
+
+            async def product(key, title, price, stock=10, **overrides):
+                oid = ObjectId()
+                product_ids[key] = oid
+                await db.products.insert_one({
+                    "_id": oid, "shop_id": str(shop), "name": title, "price": price, "stock": stock,
+                    "available": True, "category_id": "dairy", "unit": "1 L", **overrides,
+                })
+
+            await product("missing", "Green Milk", 130, 0)
+            await product("higher", "Fresh Milk", 160, variants=[{"id": "large", "unit": "500 ml", "price": 160, "stock": 4, "available": True}])
+            await product("lower", "Value Milk", 70, sell_by="pack")
+            await product("unavailable", "Gone Milk", 10, available=False)
+            await product("zero", "Zero Milk", 10, stock=0)
+            await product("foreign", "Foreign Milk", 1, shop_id=str(ObjectId()))
+            await product("unrelated", "Butter", 1)
+            await product("imported", "Imported Milk", 5, catalogue_import_job_id="fixture")
+            await product("other", "Fixture Rice", 50, category_id="grains")
+
+            original = {"product_id": str(product_ids["missing"]), "shop_id": str(shop), "name": "Green Milk",
+                        "price": 130, "qty": 1, "unit": "1 L", "category_id": "dairy"}
+            unaffected = {"product_id": str(product_ids["other"]), "qty": 1, "price": 50, "name": "Fixture Rice",
+                          "unit": "1 kg", "variant_id": None, "instructions": "Leave sealed"}
+
+            async def order(**overrides):
+                oid = ObjectId()
+                await db.orders.insert_one({
+                    "_id": oid, "shop_id": str(shop), "customer_id": user_ids["buyer"], "ref": "FIXTURE",
+                    "status": "preparing", "payment_method": "cod", "payment_status": "cod_pending",
+                    "fulfillment": "delivery", "items": [deepcopy(original), deepcopy(unaffected)],
+                    "subtotal": 180, "delivery_fee": 29, "total": 209, "notes": "Keep the bag sealed",
+                    **overrides,
+                })
+                return oid
+
+            attempt = {"line_index": 0, "product_id": original["product_id"], "qty": 1, "price": 1}
+            async with httpx.AsyncClient(transport=httpx.ASGITransport(app=server.app), base_url="http://local") as http:
+                async def call(method, path, body=None, actor="buyer"):
+                    return await http.request(method, "/api" + path, json=body, headers=headers.get(actor))
+
+                async def report(oid, actor="seller", **extras):
+                    return await call("POST", f"/orders/{oid}/replacements", {**attempt, **extras}, actor)
+
+                async def decide(oid, case, action, option=None, actor="buyer"):
+                    return await call("POST", f"/orders/{oid}/replacements/{case['id']}/decision",
+                                      {"action": action, "option_id": option, "price": 1, "total": 1}, actor)
+
+                async def notices(oid):
+                    return await db.notifications.count_documents({"data.order_id": str(oid)})
+
+                oid = await order()
+                assert (await report(oid, None)).status_code == 401
+                for actor in ("buyer", "other_seller", "support"):
+                    assert (await report(oid, actor)).status_code == 403
+                reports = await asyncio.gather(report(oid), report(oid))
+                assert [response.status_code for response in reports] == [200, 200]
+                case = reports[0].json()
+                assert reports[1].json()["id"] == case["id"]
+                assert case["original_line_total"] == 130
+                assert await notices(oid) == 1
+                offers = {option["item"]["name"]: option for option in case["options"]}
+                assert set(offers) == {"Fresh Milk", "Value Milk"}
+                higher, lower = offers["Fresh Milk"], offers["Value Milk"]
+                assert higher["item"]["variant_id"] == "large"
+                assert higher["line_difference"] == 30
+                assert higher["totals"] == {"subtotal": 210, "delivery_fee": 0, "total": 210}
+                assert lower["line_difference"] == -60
+                assert lower["totals"] == {"subtotal": 120, "delivery_fee": 29, "total": 149}
+                decision_args = (oid, case, "accept", higher["id"])
+                assert (await decide(*decision_args, actor=None)).status_code == 401
+                assert (await decide(*decision_args, actor="other")).status_code == 404
+                for actor in ("seller", "support", "admin"):
+                    assert (await decide(*decision_args, actor=actor)).status_code == 403
+                assert (await decide(oid, case, "accept", uuid4().hex)).status_code == 422
+                assert (await call("PATCH", f"/orders/{oid}/status", {"status": "ready"}, "seller")).status_code == 409
+
+                # Prove the inventory and order updates roll back when a later
+                # write in this transaction cannot be persisted.
+                async def unavailable_notice(*args, **kwargs):
+                    raise RuntimeError("simulated notification store failure")
+
+                with monkeypatch.context() as failing:
+                    failing.setattr(server, "_replacement_notify", unavailable_notice)
+                    assert (await decide(*decision_args)).status_code == 503
+                assert (await db.products.find_one({"_id": product_ids["higher"]}))["variants"][0]["stock"] == 4
+                assert (await db.orders.find_one({"_id": oid}))["total"] == 209
+
+                accepted = await asyncio.gather(decide(*decision_args), decide(*decision_args))
+                assert [response.status_code for response in accepted] == [200, 200]
+                assert (await decide(oid, case, "accept", lower["id"])).status_code == 409
+                assert (await db.products.find_one({"_id": product_ids["higher"]}))["variants"][0]["stock"] == 3
+                assert (await db.products.find_one({"_id": product_ids["missing"]}))["stock"] == 0
+                stored = await db.orders.find_one({"_id": oid})
+                assert stored["items"][1] == unaffected
+                assert stored["notes"] == "Keep the bag sealed"
+                assert stored["payment_status"] == "cod_pending"
+                assert stored["total"] == 210
+                assert len(stored["replacements"][0]["decision_history"]) == 1
+                assert await notices(oid) == 2
+                assert (await call("PATCH", f"/orders/{oid}/status", {"status": "ready"}, "seller")).status_code == 200
+
+                oid = await order()
+                case = (await report(oid, "admin")).json()
+                assert (await decide(oid, case, "reject")).json()["state"] == "rejected"
+                assert (await decide(oid, case, "reject")).json()["state"] == "rejected"
+                assert await notices(oid) == 1
+                refreshed = (await report(oid, refresh_case_id=case["id"])).json()
+                assert refreshed["id"] != case["id"]
+                assert (await report(oid, refresh_case_id=case["id"])).json()["id"] == refreshed["id"]
+                assert (await decide(oid, case, "keep_unavailable")).status_code == 409
+                assert (await decide(oid, refreshed, "keep_unavailable")).json()["final_totals"]["total"] == 79
+                stored = await db.orders.find_one({"_id": oid})
+                assert stored["items"] == [unaffected]
+                assert [entry["state"] for entry in stored["replacements"]] == ["superseded", "kept_unavailable"]
+                assert stored["replacements"][0]["decision"]["action"] == "reject"
+                assert await notices(oid) == 3
+
+                oid = await order()
+                case = (await report(oid)).json()
+                old_price = next(option for option in case["options"] if option["item"]["name"] == "Value Milk")
+                await db.products.update_one({"_id": product_ids["lower"]}, {"$set": {"price": 65}})
+                assert (await decide(oid, case, "accept", old_price["id"])).status_code == 409
+                assert (await db.orders.find_one({"_id": oid}))["total"] == 209
+                case = (await report(oid, refresh_case_id=case["id"])).json()
+                new_price = next(option for option in case["options"] if option["item"]["name"] == "Value Milk")
+                assert (await decide(oid, case, "accept", new_price["id"])).json()["final_totals"]["total"] == 144
+
+                oid = await order(status="pending")
+                await report(oid)
+                assert (await call("POST", f"/orders/{oid}/cancel")).status_code == 200
+                assert (await db.products.find_one({"_id": product_ids["missing"]}))["stock"] == 0
+                assert (await db.products.find_one({"_id": product_ids["other"]}))["stock"] == 11
+
+                oid = await order(items=[deepcopy(original)], subtotal=130, delivery_fee=29, total=159)
+                case = (await report(oid)).json()
+                assert case["keep_totals"] is None
+                assert (await decide(oid, case, "keep_unavailable")).status_code == 409
+
+                for extras in ({"payment_method": "online_razorpay", "payment_status": "paid"}, {"reward_discount": 5}, {"tax_amount": 7}):
+                    oid = await order(**extras)
+                    case = (await report(oid)).json()
+                    assert case["state"] == "assist_required" and case["options"] == []
+                    assert (await decide(oid, case, "keep_unavailable")).status_code == 409
+                    assert (await db.orders.find_one({"_id": oid}))["total"] == 209
+                    ticket = {"order_id": str(oid), "order_kind": "grocery", "category": "wrong_or_missing_item", "message": "Please confirm the actual stock with the shop."}
+                    assert (await call("POST", "/restaurant/support", ticket, "other")).status_code == 404
+                    assert (await call("POST", "/restaurant/support", ticket)).json()["order_id"] == str(oid)
+                    assert (await call("GET", "/seller/support", actor="seller")).status_code == 200
+        finally:
+            await mongo.drop_database(db.name)
+            mongo.close()
+
+    asyncio.run(scenario())
+
+
+def test_grocery_replacement_frontend_contract():
+    root = Path(__file__).resolve().parents[2]
+    widget = (root / "frontend/src/components/GroceryOrderReplacements.tsx").read_text()
+    tracking = (root / "frontend/app/order-tracking.tsx").read_text()
+    seller = (root / "frontend/app/seller/orders.tsx").read_text()
+    assert 'orderKind === "grocery" ? api.get<GroceryOrderDetails>' in tracking
+    assert '<GroceryOrderReplacements order={order} onChange={load}' in tracking
+    assert '<GroceryOrderReplacements order={item} onChange={load} staff' in seller
+    assert "disabled={busy}" in widget and "await onChange()" in widget
+    assert 'decide(entry, "accept", option.id)' in widget
+    assert 'decide(entry, "reject")' in widget
+    assert 'decide(entry, "keep_unavailable")' in widget
+    assert "option.totals.total" in widget and "option.line_difference" in widget
+    assert 'openHelp: "1", order_id: order.id, order_kind: "grocery"' in widget
