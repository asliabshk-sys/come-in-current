+class ReplacementFinancialReviewIn(BaseModel):
+    replacement_id: str = Field(min_length=1, max_length=40)
+    stage: Literal["reward", "professional_tax", "admin_tax"]
+    decision: Literal["approve", "reject"]
+    reason: str = Field(min_length=5, max_length=500)
+    guidance_reference: Optional[str] = Field(default=None, max_length=300)
+    document_type: Optional[str] = Field(default=None, max_length=100)
+
+
+@api.get("/admin/restaurant/support/{ticket_id}/financial-review")
+async def replacement_financial_review_details(ticket_id: str, user: dict = Depends(require_role("admin"))):
+    ticket = await db.restaurant_support.find_one({"_id": _object_id_or_404(ticket_id, "Support ticket")})
+    review = (ticket or {}).get("financial_review")
+    if not review:
+        raise HTTPException(404, "Financial review not found")
+    collection = db.orders if ticket["order_kind"] == "grocery" else db.restaurant_orders
+    order = await collection.find_one({"_id": _object_id_or_404(ticket["order_id"], "Order"), "customer_id": ticket["user_id"]})
+    if not order:
+        raise HTTPException(404, "Linked order not found")
+    audit = db.financial_audit.find({
+        "action": "replacement_financial_review", "ticket_id": ticket_id,
+        "replacement_id": review["replacement_id"],
+    }).sort("created_at", 1)
+    case = next((row for row in order.get("replacements", []) if row["id"] == review["replacement_id"]), {})
+    return {
+        "customer_id": ticket["user_id"], "merchant_id": order.get("shop_id") or order.get("restaurant_id"),
+        "shopping_reward_balance": await _available_shopping_reward_balance(ticket["user_id"]) if "reward_review" in review["reasons"] else None,
+        "original_invoice_reference": order.get("invoice_number") or order.get("invoice_id"),
+        "historical_tax_details": order.get("tax_details"), "replacement_history": case.get("decision_history", []),
+        "audit": [doc_out(row) async for row in audit],
+        "can_review_as_professional": user["id"] in {account.strip() for account in os.environ.get("COMEIN_VERIFIED_TAX_REVIEWER_IDS", "").split(",")},
+    }
+
+
+@api.post("/admin/restaurant/support/{ticket_id}/financial-review")
+async def decide_replacement_financial_review(ticket_id: str, body: ReplacementFinancialReviewIn,
+                                              user: dict = Depends(require_role("admin"))):
+    oid = _object_id_or_404(ticket_id, "Support ticket")
+    if body.stage == "professional_tax":
+        # Provision only externally verified professional accounts. An Admin
+        # role by itself cannot attest to a professional review.
+        verified = {account.strip() for account in os.environ.get("COMEIN_VERIFIED_TAX_REVIEWER_IDS", "").split(",")}
+        if user["id"] not in verified:
+            raise HTTPException(403, "A verified tax professional account is required.")
+        if body.decision == "approve" and not (body.guidance_reference or "").strip():
+            raise HTTPException(422, "Supply the applicable professional guidance reference.")
+
+    async def apply(session):
+        ticket = await db.restaurant_support.find_one({"_id": oid}, session=session)
+        review = (ticket or {}).get("financial_review") or {}
+        if review.get("replacement_id") != body.replacement_id:
+            raise HTTPException(409, "The replacement review changed. Refresh the ticket.")
+        reason = "reward_review" if body.stage == "reward" else "historical_tax_review"
+        if reason not in review["reasons"]:
+            raise HTTPException(409, "The selected review does not apply to this replacement.")
+        prior = await db.financial_audit.find_one({
+            "action": "replacement_financial_review", "ticket_id": ticket_id,
+            "replacement_id": body.replacement_id, "stage": body.stage,
+        }, session=session)
+        if prior:
+            if (prior["actor_id"], prior["decision"], prior["reason"], prior.get("guidance_reference"), prior.get("document_type")) == (
+                user["id"], body.decision, body.reason, body.guidance_reference, body.document_type
+            ):
+                return {"status": prior["status"], "financial_action_confirmed": False}
+            raise HTTPException(409, "This review stage already has a recorded decision.")
+        if body.stage == "admin_tax":
+            professional = await db.financial_audit.find_one({
+                "action": "replacement_financial_review", "ticket_id": ticket_id,
+                "replacement_id": body.replacement_id, "stage": "professional_tax", "decision": "approve",
+            }, session=session)
+            if not professional:
+                raise HTTPException(409, "A verified professional review is required before Admin approval.")
+            if professional["actor_id"] == user["id"]:
+                raise HTTPException(403, "A different Admin must decide after professional review.")
+        status = "rejected" if body.decision == "reject" else {
+            "reward": "ledger_preservation_approved",
+            "professional_tax": "pending_admin_tax_approval",
+            "admin_tax": "approved_pending_accounting_procedure",
+        }[body.stage]
+        now = now_utc()
+        await db.restaurant_support.update_one({"_id": oid}, {
+            "$set": {f"financial_review.{body.stage}_status": status, "financial_review.updated_at": now},
+        }, session=session)
+        await db.financial_audit.insert_one({
+            "action": "replacement_financial_review", "stage": body.stage, "status": status,
+            "actor_id": user["id"], "decision": body.decision, "reason": body.reason,
+            "guidance_reference": body.guidance_reference, "document_type": body.document_type,
+            "ticket_id": ticket_id, "replacement_id": body.replacement_id,
+            "order_kind": ticket["order_kind"], "order_id": ticket["order_id"], "customer_id": ticket["user_id"],
+            "created_at": now,
+        }, session=session)
+        if body.stage != "professional_tax":
+            message = (
+                "Your reward review is complete. Your existing reward ledger was preserved."
+                if body.stage == "reward" else "Your invoice review was updated. The original invoice was preserved."
+            )
+            await db.notifications.insert_one({
+                "user_id": ticket["user_id"], "kind": "order_help",
+                "title": f"{'Reward' if body.stage == 'reward' else 'Invoice'} review {'approved' if body.decision == 'approve' else 'rejected'}",
+                "body": message, "data": {"ticket_id": ticket_id, "order_id": ticket["order_id"], "order_kind": ticket["order_kind"]},
+                "read": False, "channel": "in_app", "push_status": "not_configured", "created_at": now,
+            }, session=session)
+        return {"status": status, "financial_action_confirmed": False}
+
+    return await _run_replacement_transaction(apply)
+

