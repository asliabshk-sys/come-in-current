+async def _replacement_removal_totals(session, order, index, kind):
+    """Price from reserved order lines and recheck that remaining lines can be supplied."""
+    remaining = _replacement_items(order, index)
+    if not remaining:
+        return None
+    try:
+        if kind == "grocery":
+            lines, shop_id = await _resolve_grocery_lines(
+                [QuoteLineIn(product_id=line["product_id"], qty=line["qty"], variant_id=line.get("variant_id")) for line in remaining],
+                check_stock=False, session=session,
+            )
+            # Existing Grocery units have already been reserved at checkout.
+            if not lines or shop_id != order["shop_id"]:
+                return None
+            return _quote_totals(remaining, order.get("fulfillment", "delivery"))
+        restaurant = await _restaurant_replacement_context(order, session)
+        for line in remaining:
+            current = await _restaurant_resolve_line(order["restaurant_id"], RestaurantOrderLineIn(
+                menu_item_id=line["menu_item_id"], quantity=line["quantity"],
+                variant_id=(line.get("variant") or {}).get("id"),
+                add_on_ids=[option["id"] for option in line.get("add_ons") or []],
+            ), session=session)
+            await db.restaurant_menu.update_one({"_id": ObjectId(current["menu_item_id"])},
+                                               {"$set": {"replacement_checked_at": now_utc()}}, session=session)
+        totals = _restaurant_replacement_totals(order, restaurant, remaining)
+        if not totals or totals["subtotal"] < float(restaurant.get("min_order", 0)):
+            return None
+        await db.restaurants.update_one({"_id": restaurant["_id"]},
+                                        {"$set": {"replacement_checked_at": now_utc()}}, session=session)
+        return totals
+    except (HTTPException, ValueError, KeyError, TypeError):
+        return None
+
+
+async def _decide_rejected_removal(session, order, case, kind, body, user):
+    if (case.get("decision") or {}).get("action") != "reject":
+        raise HTTPException(409, "Reject the replacement offer before requesting removal.")
+    collection = db.orders if kind == "grocery" else db.restaurant_orders
+    now = now_utc()
+    reasons = _replacement_adjustment_reasons(order, kind)
+    totals = None if {"historical_tax_review", "reward_review"}.intersection(reasons) else await _replacement_removal_totals(
+        session, order, case["line_index"], kind,
+    )
+    reason = next(iter(reasons), None) or case.get("assist_reason")
+    updates = {"replacements": order["replacements"], "updated_at": now}
+    if totals and not reason and totals == case.get("keep_totals") and order["total"] == case["original_total"]:
+        case.update({"state": "kept_unavailable", "final_totals": totals})
+        updates.update({"items": _replacement_items(order, case["line_index"]), **totals})
+        await _replacement_notify(session, order, case, "Unavailable item removed",
+                                  f"Your order will continue. New total ₹{totals['total']:.2f}.", kind)
+    else:
+        case.update({"state": "assist_required", "assist_reason": reason or "no_alternative"})
+        if totals and reason == "payment_review" and order.get("payment_status") in {"paid", "cash_collected"}:
+            # A quote is evidence for review only. Existing provider routes do
+            # not authorize a partial refund on a continuing order.
+            case["removal_quote"] = {
+                **totals, "potential_refund_paise": max(0, int((money(order["total"]) - money(totals["total"])) * 100)),
+            }
+        await _replacement_escalate(session, order, case, kind, case)
+    _replacement_decision(case, order, body, user, now)
+    if case["state"] == "assist_required":
+        await _replacement_financial_review(session, order, case, kind)
+    await collection.update_one({"_id": order["_id"]}, {"$set": updates}, session=session)
+    return case
+
