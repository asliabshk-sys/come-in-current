diff --git a/backend/tests/test_task9_coupon_checkout.py b/backend/tests/test_task9_coupon_checkout.py
new file mode 100644
--- /dev/null
+++ b/backend/tests/test_task9_coupon_checkout.py
@@ -0,0 +1,95 @@
+import asyncio
+from datetime import timedelta
+import os
+from uuid import uuid4
+
+import pytest
+
+
+def test_grocery_coupon_budget_and_cancellation_are_atomic(monkeypatch):
+    if os.environ.get("COMEIN_RUN_LOCAL_PAYMENT_TESTS") != "1":
+        pytest.skip("requires disposable loopback MongoDB")
+    import httpx
+    from bson import ObjectId
+    from motor.motor_asyncio import AsyncIOMotorClient
+    import server
+
+    monkeypatch.setenv("JWT_SECRET", uuid4().hex)
+
+    async def run():
+        client = AsyncIOMotorClient("mongodb://127.0.0.1:27018/?replicaSet=rs0")
+        db = client["comein_disposable_coupon_" + uuid4().hex]
+        monkeypatch.setattr(server, "db", db)
+        monkeypatch.setattr(server, "client", client)
+        try:
+            auth = {}
+            for label, role in (("admin", "admin"), ("first", "customer"), ("second", "customer")):
+                uid = ObjectId()
+                email = f"{label}@fixture.example"
+                await db.users.insert_one({"_id": uid, "role": role, "email": email})
+                auth[label] = {"Authorization": "Bearer " + server.create_access_token(str(uid), role, email)}
+            shop = (await db.shops.insert_one({"status": "approved", "delivery_available": True, "payment_methods": ["cod"]})).inserted_id
+            products = (await db.products.insert_many([{"shop_id": str(shop), "category_id": "dairy",
+                "name": "Coupon item", "unit": "pack", "price": 100, "stock": 10, "available": True} for _ in range(2)])).inserted_ids
+            now = server.now_utc()
+            draft = {"name": "Test sponsored offer", "kind": "campaign", "starts_at": (now - timedelta(days=1)).isoformat(),
+                "expires_at": (now + timedelta(days=1)).isoformat(), "budget_paise": 2000, "max_benefit_paise": 2000,
+                "customer_budget_paise": 2000, "min_order_paise": 5000, "max_redemptions": 10,
+                "per_customer_limit": 1, "funding_reference": "Fixture funding", "eligibility": "Signed-in customers",
+                "terms": "Coupon on eligible items", "cancellation_terms": "Unpaid cancellations restore eligibility",
+                "refund_terms": "No automatic cash refund", "discount_model": "fixed", "fixed_discount_paise": 2000,
+                "funding_allocation_basis_points": {"come_in": 10000}}
+            async with httpx.AsyncClient(transport=httpx.ASGITransport(app=server.app), base_url="http://local") as http:
+                async def post(path, data, actor):
+                    return await http.post("/api" + path, json=data, headers=auth[actor])
+
+                saved = await post("/admin/financial/promotion-drafts", draft, "admin")
+                path = f"/admin/financial/promotion-drafts/{saved.json()['id']}/activate-grocery-coupon"
+                activation = {"code": "TEST20", "customer_scope": "all_signed_in", "release_unpaid_cancellation": True}
+                assert (await post(path, activation, "first")).status_code == 403
+                assert (await post(path, activation, "admin")).status_code == 200
+                assert (await post(path, activation, "admin")).status_code == 200
+                assert await db.financial_audit.count_documents({"action": "grocery_coupon_activated"}) == 1
+
+                def items(index):
+                    return [{"product_id": str(products[index]), "qty": 1}]
+
+                async def quote(actor, index, **extra):
+                    return await post("/grocery/quotes", {"items": items(index), "coupon_code": "TEST20", **extra}, actor)
+
+                async def place(actor, index, token):
+                    return await post("/orders", {"items": [{"product_id": str(products[index]), "qty": 1, "name": "Item",
+                        "price": 1, "unit": "pack", "shop_id": str(shop)}], "delivery_address": "Fixture address",
+                        "payment_method": "cod", "quote_token": token, "idempotency_key": f"fixture-coupon-{actor}"}, actor)
+                assert (await quote("first", 0, use_rewards=True)).status_code == 422
+                quotes = [await quote("first", 0), await quote("second", 1)]
+                assert all(result.status_code == 200 and result.json()["total"] == 109 for result in quotes)
+                tokens = [result.json()["quote_token"] for result in quotes]
+                assert quotes[0].json()["coupon"]["funded_by"] == "COME-IN"
+                with monkeypatch.context() as failure:
+                    async def fail(*args, **kwargs):
+                        raise RuntimeError("fixture failure after stock decrement")
+                    failure.setattr(server, "_record_grocery_coupon_event", fail)
+                    assert (await place("first", 0, tokens[0])).status_code == 503
+                assert await db.orders.count_documents({}) == 0
+                assert (await db.products.find_one({"_id": products[0]}))["stock"] == 10
+                results = await asyncio.gather(place("first", 0, tokens[0]), place("second", 1, tokens[1]))
+                assert sorted(result.status_code for result in results) == [200, 409]
+                winner = next(index for index, result in enumerate(results) if result.status_code == 200)
+                actor = ("first", "second")[winner]
+                order = results[winner].json()
+                assert (await place(actor, winner, tokens[winner])).json()["id"] == order["id"]
+                assert await db.financial_audit.count_documents({"action": "grocery_coupon_spent"}) == 1
+                assert (await quote("second", 1)).status_code == 409
+                cancelled = await post(f"/orders/{order['id']}/cancel", {}, actor)
+                assert cancelled.status_code == 200 and cancelled.json()["coupon_redemption"]["state"] == "released"
+                assert (await post(f"/orders/{order['id']}/cancel", {}, actor)).status_code == 200
+                assert await db.financial_audit.count_documents({"action": "grocery_coupon_released"}) == 1
+                assert (await quote("second", 1)).status_code == 200
+                await db.financial_policy_drafts.update_one({"_id": "coupon:TEST20"}, {"$set": {"expires_at": now}})
+                assert (await quote("second", 1)).status_code == 409
+        finally:
+            await client.drop_database(db.name)
+            client.close()
+
+    asyncio.run(run())
