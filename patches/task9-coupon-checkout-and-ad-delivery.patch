+@api.post("/admin/financial/promotion-drafts/{draft_id}/activate-grocery-coupon")
+async def activate_grocery_coupon(draft_id: str, body: GroceryCouponActivationIn, user: dict = Depends(require_role("admin"))):
+    if (body.customer_scope == "allowlist") != bool(body.customer_ids) or any(not ObjectId.is_valid(value) for value in body.customer_ids):
+        raise HTTPException(422, "Specify a valid customer audience")
+
+    async def apply(session):
+        draft = await db.financial_policy_drafts.find_one({"_id": draft_id, "status": "draft"}, session=session)
+        if (not draft or draft.get("kind") not in {"shop", "campaign", "sponsored"}
+                or draft.get("restaurant_ids") or draft.get("stacking") or not draft.get("discount_model")
+                or draft.get("funding_allocation_basis_points") != {"come_in": 10000}):
+            raise HTTPException(422, "This checkout supports only explicitly configured, nonstacking COME-IN-funded Grocery campaigns")
+        if utc(draft["expires_at"]) <= now_utc():
+            raise HTTPException(409, "Coupon campaign expired")
+        key = f"coupon:{body.code}"
+        settings = body.model_dump()
+        settings["customer_ids"] = sorted(set(settings["customer_ids"]))
+        existing = await db.financial_policy_drafts.find_one({"_id": key}, session=session)
+        if existing:
+            if existing.get("draft_id") == draft_id and existing.get("activation") == settings:
+                return {"code": body.code, "status": existing["status"]}
+            raise HTTPException(409, "Coupon code is already assigned")
+        if draft.get("activated_coupon_code"):
+            raise HTTPException(409, "This draft already has an activated coupon")
+        updated = await db.financial_policy_drafts.update_one(
+            {"_id": draft_id, "activated_coupon_code": {"$exists": False}},
+            {"$set": {"activated_coupon_code": body.code}}, session=session,
+        )
+        if updated.modified_count != 1:
+            raise HTTPException(409, "This draft already has an activated coupon")
+        record = {**draft, "_id": key, "draft_id": draft_id, "status": "active", "activation": settings,
+                  "spent_paise": 0, "redemptions": 0, "activated_by": user["id"], "activated_at": now_utc()}
+        await db.financial_policy_drafts.insert_one(record, session=session)
+        await db.financial_audit.insert_one({"action": "grocery_coupon_activated", "coupon_code": body.code,
+            "draft_id": draft_id, "actor_id": user["id"], "created_at": now_utc()}, session=session)
+        return {"code": body.code, "status": "active"}
+
+    return await _run_replacement_transaction(apply)
+
+
+async def _grocery_coupon_terms(code, user, lines, shop_id, totals, *, session=None):
+    if not user or user.get("role") != "customer":
+        raise HTTPException(403, "Sign in as a customer to apply a coupon")
+    campaign = await db.financial_policy_drafts.find_one({"_id": f"coupon:{code}", "status": "active"}, session=session)
+    now = now_utc()
+    if not campaign or not utc(campaign["starts_at"]) <= now < utc(campaign["expires_at"]):
+        raise HTTPException(409, "Coupon is unavailable or outside its valid dates")
+    activation = campaign["activation"]
+    if activation["customer_scope"] == "allowlist" and user["id"] not in activation["customer_ids"]:
+        raise HTTPException(403, "This account is not eligible for the coupon")
+    if campaign["shop_ids"] and shop_id not in campaign["shop_ids"]:
+        raise HTTPException(409, "Coupon is not valid for this shop")
+    amount = sum((money(_line_amount(line)) for line in lines
+                  if (not campaign["product_ids"] or line["product_id"] in campaign["product_ids"])
+                  and (not campaign["category_ids"] or line.get("category_id") in campaign["category_ids"])), Decimal("0"))
+    eligible_paise = int(amount * 100)
+    if not eligible_paise or eligible_paise < campaign["min_order_paise"]:
+        raise HTTPException(409, "Eligible items do not meet the coupon minimum")
+    offered = campaign["fixed_discount_paise"] if campaign["discount_model"] == "fixed" else (
+        eligible_paise * campaign["discount_basis_points"] // 10000
+    )
+    # The current cash workflow cannot accept a zero-payable order.
+    discount = min(offered, eligible_paise, campaign["max_benefit_paise"], int(money(totals["total"]) * 100) - 1)
+    spent = count = 0
+    async for row in db.orders.find({"customer_id": user["id"], "coupon_redemption.code": code,
+                                     "coupon_redemption.state": "spent"}, {"coupon_redemption.discount_paise": 1}, session=session):
+        count += 1
+        spent += row["coupon_redemption"]["discount_paise"]
+    if discount <= 0 or campaign["spent_paise"] + discount > campaign["budget_paise"] or campaign["redemptions"] >= campaign["max_redemptions"]:
+        raise HTTPException(409, "Coupon campaign budget or redemption limit reached")
+    if spent + discount > campaign["customer_budget_paise"] or count >= campaign["per_customer_limit"]:
+        raise HTTPException(409, "Your coupon limit has been reached")
+    return {"code": code, "discount_paise": discount, "funded_by": "COME-IN", "terms": campaign["terms"],
+            "cancellation_terms": campaign["cancellation_terms"], "release_unpaid_cancellation": activation["release_unpaid_cancellation"]}
+
+
+def _apply_grocery_coupon(totals, coupon):
+    if coupon:
+        totals["coupon"] = coupon
+        totals["total"] = float(money(totals["total"]) - Decimal(coupon["discount_paise"]) / 100)
+
+
+async def _record_grocery_coupon_event(session, order, coupon, action):
+    delta = coupon["discount_paise"] if action == "spent" else -coupon["discount_paise"]
+    query = {"_id": f"coupon:{coupon['code']}"}
+    if action == "released":
+        query.update({"spent_paise": {"$gte": -delta}, "redemptions": {"$gte": 1}})
+    else:
+        query["$expr"] = {"$and": [
+            {"$lte": [{"$add": ["$spent_paise", delta]}, "$budget_paise"]},
+            {"$lt": ["$redemptions", "$max_redemptions"]},
+        ]}
+    update = await db.financial_policy_drafts.update_one(query,
+        {"$inc": {"spent_paise": delta, "redemptions": 1 if action == "spent" else -1}}, session=session)
+    if update.matched_count != 1:
+        raise HTTPException(409, "Coupon accounting record is unavailable")
+    await db.financial_audit.insert_one({"action": f"grocery_coupon_{action}", "coupon_code": coupon["code"],
+        "order_id": str(order["_id"]), "actor_id": order["customer_id"], "amount_paise": abs(delta), "created_at": now_utc()}, session=session)
+
+
