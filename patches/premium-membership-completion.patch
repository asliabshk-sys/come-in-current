+async def _premium_rank_context(rows, surface, now):
+    day = now.replace(hour=0, minute=0, second=0, microsecond=0)
+    ids = {row["shop_id"] for row in rows if row.get("premium_until")}
+    if not ids:
+        return {}, day.date().isoformat()
+    counts = await db.premium_exposure.aggregate([
+        {"$match": {"shop_id": {"$in": list(ids)}, "kind": "impression", "surface": surface,
+                    "created_at": {"$gte": day - timedelta(days=14), "$lt": day}}},
+        {"$group": {"_id": "$shop_id", "count": {"$sum": 1}}},
+    ]).to_list(length=len(ids))
+    return {row["_id"]: row["count"] for row in counts}, day.date().isoformat()
+
+
+async def _premium_issue(rows, surface, user, day, counts, now):
+    if not user or user.get("role") != "customer":
+        return
+    viewer = _premium_viewer(user["id"], day)
+    writes = {}
+    for position, row in enumerate(rows, 1):
+        until = row.get("premium_until")
+        if not until:
+            continue
+        shop_id = row["shop_id"]
+        key = _premium_event_id(viewer, surface, shop_id, "opportunity")
+        writes.setdefault(key, UpdateOne({"_id": key}, {"$setOnInsert": {
+            "shop_id": shop_id, "surface": surface, "kind": "opportunity",
+            "product_id": row["id"], "position": position,
+            "prior_impressions": counts.get(shop_id, 0), "created_at": now,
+        }}, upsert=True))
+        end_of_day = now.replace(hour=0, minute=0, second=0, microsecond=0) + timedelta(days=1)
+        row["premium_event_token"] = jwt.encode({
+            "type": "premium_display", "viewer": viewer, "day": day, "surface": surface,
+            "shop": shop_id, "product": row["id"], "exp": min(until, now + timedelta(minutes=15), end_of_day),
+        }, _jwt_secret(), algorithm=JWT_ALG)
+    if writes:
+        await db.premium_exposure.bulk_write(list(writes.values()), ordered=False)
+
