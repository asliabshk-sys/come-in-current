+"""Local-only behavioral coverage with disposable replica-set data and a mocked gateway."""
+import asyncio
+from datetime import datetime, timedelta, timezone
+import hashlib
+import hmac
+import json
+import os
+from pathlib import Path
+from types import SimpleNamespace
+from uuid import uuid4
+
+import pytest
+
+from premium_exposure import customer_offer_key, entitled, featured_feed, ranked_search
+
+
+def test_entitlement_and_rotation():
+    now = datetime.now(timezone.utc)
+    membership = {"status": "active", "starts_at": now - timedelta(days=1), "expires_at": now + timedelta(days=1)}
+    assert entitled(membership, now)
+    assert not entitled({**membership, "expires_at": now}, now)
+    assert not entitled({**membership, "status": "suspended"}, now)
+    rows = [
+        {"id": "a", "shop_id": "one", "name": "Milk", "price": 40, "premium_until": now},
+        {"id": "b", "shop_id": "one", "name": "Milk", "price": 41, "premium_until": now},
+        {"id": "c", "shop_id": "two", "name": "Milk", "price": 43, "premium_until": now},
+        {"id": "d", "shop_id": "three", "name": "Milk", "price": 30},
+        {"id": "e", "shop_id": "two", "name": "Rice", "price": 12, "premium_until": now},
+        {"id": "f", "shop_id": "two", "name": "Fresh Milk", "price": 30, "premium_until": now},
+    ]
+    assert [r["id"] for r in ranked_search(rows, "milk", {"one": 10}, "today")] == ["c", "a", "b", "f", "d"]
+    assert {featured_feed(rows, {}, f"2026-11-{day:02d}")[0]["shop_id"] for day in range(1, 29)} == {"one", "two"}
+    assert featured_feed(rows, {"one": 10}, "today")[0]["shop_id"] == "two"
+    assert featured_feed(rows, {"one": 10}, "today")[2]["id"] == "d"
+    cheap = {"price": 30, "premium": False, "shop_name": "Normal", "product_id": "1"}
+    paid = {"price": 35, "premium": True, "shop_name": "Premium", "product_id": "2"}
+    assert customer_offer_key(cheap) < customer_offer_key(paid)
+    assert customer_offer_key({**paid, "price": 30}) < customer_offer_key(cheap)
+
+
+def test_premium_frontend_boundary():
+    frontend = Path(__file__).resolve().parents[2] / "frontend"
+    card = (frontend / "src/components/ProductCard.tsx").read_text()
+    assert "★ Premium" in card and "premiumCard" in card
+    assert "rating" not in card.lower()
+    search = (frontend / "app/(tabs)/search.tsx").read_text()
+    assert search.index('sectionRows("Premium results"') < search.index('sectionRows("Other available results"')
+    for screen in ("app/(tabs)/index.tsx", "app/(tabs)/search.tsx", "app/category/[slug].tsx"):
+        assert "onViewableItemsChanged" in (frontend / screen).read_text()
+
