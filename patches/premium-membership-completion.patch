+import { useEffect, useRef, useState } from "react";
+import type { Product } from "@/src/data/catalog";
+import { api } from "@/src/lib/api";
+
+export type DisplayToken<T> = { item: T; isViewable: boolean };
+
+type EventKind = "impression" | "click" | "product_view" | "add_to_cart";
+
+export function trackPremium(token: string | undefined, kind: EventKind) {
+  if (token) void api.post("/catalog/premium-events", { token, kind }).catch(() => {});
+}
+
+export const premiumViewability = { itemVisiblePercentThreshold: 50, minimumViewTime: 750 };
+
+export function recordVisibleProducts({ changed }: { changed: DisplayToken<Product>[] }) {
+  for (const row of changed) {
+    if (row.isViewable) trackPremium(row.item.premiumEventToken, "impression");
+  }
+}
+
+export function usePremiumActive(until?: string) {
+  const expiry = until ? Date.parse(until) : 0;
+  const [clock, setClock] = useState(Date.now);
+  useEffect(() => {
+    const now = Date.now();
+    const remaining = expiry - now;
+    if (!(remaining > 0)) return;
+    // A membership can last more than the maximum supported JS timer delay.
+    const timer = setTimeout(() => setClock(Date.now()), Math.min(remaining, 2_147_000_000));
+    return () => clearTimeout(timer);
+  }, [expiry, clock]);
+  return expiry > clock;
+}
+
+
+export function usePremiumCartEvent(productId: string | undefined, token: string | undefined, quantity: number) {
+  const previous = useRef({ productId, quantity });
+  useEffect(() => {
+    if (productId && previous.current.productId === productId && quantity > previous.current.quantity) {
+      trackPremium(token, "add_to_cart");
+    }
+    previous.current = { productId, quantity };
+  }, [productId, token, quantity]);
+}
