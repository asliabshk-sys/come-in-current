+"""Shared eligibility and explainable discovery ranking."""
+from collections import defaultdict
+from datetime import timezone
+from hashlib import sha256
+from itertools import groupby
+from math import asin, cos, isfinite, radians, sin, sqrt
+
+
+def utc(value):
+    return value.replace(tzinfo=timezone.utc) if value and value.tzinfo is None else value
+
+
+def entitlement_filter(now):
+    return {"status": "active", "starts_at": {"$lte": now}, "expires_at": {"$gt": now}}
+
+
+def entitled(row, now):
+    start, expiry = utc(row.get("starts_at")), utc(row.get("expires_at"))
+    return row.get("status") == "active" and start is not None and expiry is not None and start <= now < expiry
+
+
+def normalized(value):
+    return " ".join(str(value or "").casefold().split())
+
+
+def relevance(row, query):
+    name = normalized(row.get("name"))
+    if name == query:
+        return 0
+    if query in name:
+        return 1
+    fields = " ".join(normalized(row.get(key)) for key in ("name", "brand", "description", "category_id"))
+    if all(word in fields for word in query.split()):
+        return 2
+    return None
+
+
+def finite_price(value):
+    if isinstance(value, (int, float)) and isfinite(value) and value >= 0:
+        return value
+    return float("inf")
+
+
+def listing_price(row):
+    variants = row.get("variants") or []
+    if variants:
+        return min((finite_price(v.get("price")) for v in variants
+                    if v.get("available") and v.get("stock", 0) > 0), default=float("inf"))
+    return finite_price(row.get("price"))
+
+
+def ranked_search(rows, query, impressions, day):
+    groups = ([], [])
+    for row in rows:
+        score = relevance(row, query)
+        if score is not None:
+            groups[0 if row.get("premium_until") else 1].append((score, row))
+
+    def customer_band(pair):
+        score, row = pair
+        distance = row.get("distance_km")
+        return score, listing_price(row) // 10, distance is None, (distance or 0) // 2
+
+    premium = []
+    for _, group in groupby(sorted(groups[0], key=customer_band), key=customer_band):
+        premium.extend(rotate([row for _, row in group], impressions, day))
+    ordinary = sorted(groups[1], key=lambda pair: (pair[0], listing_price(pair[1]), pair[1]["id"]))
+    return premium + [row for _, row in ordinary]
+
+
+def rotate(rows, impressions, day):
+    by_shop = defaultdict(list)
+    for row in sorted(rows, key=lambda row: (listing_price(row), row["id"])):
+        by_shop[row["shop_id"]].append(row)
+    shops = sorted(by_shop, key=lambda shop: (
+        impressions.get(shop, 0), sha256(f"{day}:{shop}".encode()).digest()
+    ))
+    ranked = []
+    for index in range(max(map(len, by_shop.values()), default=0)):
+        ranked.extend(by_shop[shop][index] for shop in shops if index < len(by_shop[shop]))
+    return ranked
+
+
+def featured_feed(rows, impressions, day):
+    featured = rotate([row for row in rows if row.get("premium_until")], impressions, day)
+    selected = []
+    seen = set()
+    for row in featured:
+        if row["shop_id"] not in seen and len(selected) < 2:
+            selected.append(row)
+            seen.add(row["shop_id"])
+    ids = {row["id"] for row in selected}
+    remaining = [row for row in rows if row["id"] not in ids]
+    ordinary = [row for row in remaining if not row.get("premium_until")]
+    first = ordinary[:4]
+    first_ids = {row["id"] for row in first}
+    return selected + first + [row for row in remaining if row["id"] not in first_ids]
+
+
+def shop_distance(shop, origin):
+    latitude, longitude = shop.get("latitude"), shop.get("longitude")
+    if not origin or not isinstance(latitude, (int, float)) or not isinstance(longitude, (int, float)):
+        return None
+    if not (-90 <= latitude <= 90 and -180 <= longitude <= 180):
+        return None
+    a, b = map(radians, origin)
+    c, d = map(radians, (latitude, longitude))
+    haversine = sin((a - c) / 2) ** 2 + cos(a) * cos(c) * sin((b - d) / 2) ** 2
+    return 6371 * 2 * asin(min(1, sqrt(haversine)))
+
+
+def customer_offer_key(offer):
+    # An equivalent pack at lower customer cost always wins. Membership breaks ties.
+    distance = offer.get("distance_km")
+    cost = offer.get("total_cost")
+    return (offer["price"] if cost is None else cost, offer["price"],
+            distance is None, distance or 0, not offer["premium"],
+            normalized(offer["shop_name"]), offer["product_id"])
