+    except (jwt.InvalidTokenError, KeyError, TypeError, ValueError):
+        raise HTTPException(status_code=403, detail="Display token is invalid or expired")
+    if not ObjectId.is_valid(shop_id) or not ObjectId.is_valid(product_id):
+        raise HTTPException(status_code=403, detail="Display token has invalid identifiers")
