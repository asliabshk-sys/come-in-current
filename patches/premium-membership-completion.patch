+def _premium_period(start, end):
+    now = now_utc()
+    start = utc(start) or now - timedelta(days=30)
+    end = utc(end) or now
+    if end <= start or end - start > timedelta(days=366) or end > now:
+        raise HTTPException(status_code=422, detail="Use an ordered past date range of up to 366 days")
+    return start, end
+
+
+async def _premium_metrics(start, end, shop_id=None, *, breakdown=False, offset=0, limit=50):
+    query = {"created_at": {"$gte": start, "$lt": end}}
+    if shop_id:
+        query["shop_id"] = shop_id
+    counts = {kind: 0 for kind in ("opportunity", "impression", "click", "product_view", "add_to_cart")}
+    group = {"$group": {"_id": "$kind", "count": {"$sum": 1}}}
+    for row in await db.premium_exposure.aggregate([{"$match": query}, group]).to_list(length=5):
+        counts[row["_id"]] = row["count"]
+    counts["ctr"] = counts["click"] / counts["impression"] if counts["impression"] else None
+    search = await db.premium_exposure.aggregate([
+        {"$match": {**query, "surface": "search"}}, group,
+    ]).to_list(length=5)
+    counts["search"] = {row["_id"]: row["count"] for row in search}
+    if breakdown:
+        counts["by_shop"] = await db.premium_exposure.aggregate([
+            {"$match": query},
+            {"$group": {"_id": {"shop_id": "$shop_id", "kind": "$kind"}, "count": {"$sum": 1}}},
+            {"$group": {"_id": "$_id.shop_id", "metrics": {"$push": {"k": "$_id.kind", "v": "$count"}}}},
+            {"$sort": {"_id": 1}}, {"$skip": offset}, {"$limit": limit},
+            {"$project": {"_id": 0, "shop_id": "$_id", "metrics": {"$arrayToObject": "$metrics"}}},
+        ]).to_list(length=limit)
+    return counts
+
+
+@api.get("/shops/{shop_id}/membership/analytics")
+async def seller_membership_analytics(
