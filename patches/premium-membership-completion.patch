+def _premium_viewer(user_id, day):
+    return hmac.new(_jwt_secret().encode(), f"premium:{day}:{user_id}".encode(), hashlib.sha256).hexdigest()
+
+
+def _premium_event_id(viewer, surface, shop_id, kind):
+    return f"{viewer}:{surface}:{shop_id}:{kind}"
