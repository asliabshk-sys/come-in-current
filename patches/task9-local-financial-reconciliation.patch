+
+class InvoiceCorrectionDraftIn(BaseModel):
+    replacement_id: str = Field(min_length=1, max_length=40)
+    reason: str = Field(min_length=5, max_length=500)
+
+
+@api.post("/admin/restaurant/support/{ticket_id}/invoice-correction-draft")
+async def create_replacement_invoice_correction_draft(ticket_id: str, body: InvoiceCorrectionDraftIn,
+                                                       user: dict = Depends(require_role("admin"))):
+    oid = _object_id_or_404(ticket_id, "Support ticket")
+
+    async def apply(session):
+        ticket = await db.restaurant_support.find_one({"_id": oid}, session=session)
+        review = (ticket or {}).get("financial_review") or {}
+        if (review.get("replacement_id") != body.replacement_id
+                or review.get("admin_tax_status") != "approved_pending_accounting_procedure"):
+            raise HTTPException(409, "Professional and separate Admin approval are required")
+        criteria = {"ticket_id": ticket_id, "replacement_id": body.replacement_id,
+                    "action": "replacement_financial_review", "decision": "approve"}
+        professional = await db.financial_audit.find_one({**criteria, "stage": "professional_tax"}, session=session)
+        admin = await db.financial_audit.find_one({**criteria, "stage": "admin_tax"}, session=session)
+        if not professional or not admin or professional["actor_id"] == admin["actor_id"]:
+            raise HTTPException(409, "Both independent approval records are required")
+        collection = db.orders if ticket["order_kind"] == "grocery" else db.restaurant_orders
+        order = await collection.find_one({"_id": _object_id_or_404(ticket["order_id"], "Order"),
+                                          "customer_id": ticket["user_id"]}, session=session)
+        reference = (order or {}).get("invoice_number") or (order or {}).get("invoice_id")
+        case = next((row for row in (order or {}).get("replacements", []) if row["id"] == body.replacement_id), None)
+        if not isinstance(reference, str) or not reference.strip() or not case or case["state"] == "superseded":
+            raise HTTPException(409, "A current replacement case and original invoice reference are required")
+        key = f"invoice-review-draft:{ticket['order_kind']}:{ticket['order_id']}:{body.replacement_id}"
+        existing = await db.financial_audit.find_one({"_id": key}, session=session)
+        if existing:
+            if existing["reason"] != body.reason or existing["original_invoice_reference"] != reference:
+                raise HTTPException(409, "An immutable correction draft already exists")
+            return {"id": key, "status": existing["status"]}
+        now = now_utc()
+        record = {"_id": key, "action": "replacement_invoice_correction_drafted", "status": "pending_statutory_issuance",
+                  "version": 1, "ticket_id": ticket_id, "order_id": ticket["order_id"], "order_kind": ticket["order_kind"],
+                  "replacement_id": body.replacement_id, "original_invoice_reference": reference,
+                  "original_financials": review["original"], "professional_review_id": str(professional["_id"]),
+                  "admin_approval_id": str(admin["_id"]), "actor_id": user["id"], "reason": body.reason, "created_at": now}
+        await db.restaurant_support.update_one({"_id": oid}, {"$set": {"financial_review.invoice_draft_status": record["status"],
+            "financial_review.updated_at": now}}, session=session)
+        await db.financial_audit.insert_one(record, session=session)
+        return {"id": key, "status": record["status"]}
+
+    return await _run_replacement_transaction(apply)


