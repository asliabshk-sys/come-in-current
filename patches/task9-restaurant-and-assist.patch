+@api.post("/restaurant/orders/{order_id}/replacements/{case_id}/decision")
+async def decide_restaurant_replacement(order_id: str, case_id: str, body: GroceryReplacementDecisionIn, user: dict = Depends(get_current_user)):
+    if user.get("role") != "customer":
+        raise HTTPException(403, "Only the customer can decide on a replacement")
+    if body.action not in {"accept", "reject"} or (body.action == "accept") != bool(body.option_id):
+        raise HTTPException(422, "Choose an offered replacement or reject the options.")
+    oid = _object_id_or_404(order_id, "Order")
+
+    async def apply(session):
+        order = await db.restaurant_orders.find_one({"_id": oid, "customer_id": user["id"]}, session=session)
+        cases = (order or {}).get("replacements", [])
+        case = next((row for row in cases if row["id"] == case_id), None)
+        if not case:
+            raise HTTPException(404, "Replacement request not found")
+        if case.get("decision"):
+            if (case["decision"]["action"], case["decision"]["option_id"]) == (body.action, body.option_id):
+                return case
+            raise HTTPException(409, "A decision was already recorded.")
+        if case["state"] not in {"awaiting_customer", "assist_required"} or order["status"] not in RESTAURANT_REPLACEMENT_ORDER_STATES:
+            raise HTTPException(409, "This offer is no longer open.")
+        reason = _replacement_adjustment_reason(order, "restaurant") or case.get("assist_reason")
+        now = now_utc()
+        updates = {"replacements": cases, "updated_at": now}
+        if body.action == "accept":
+            option = next((row for row in case["options"] if row["id"] == body.option_id), None)
+            if not option:
+                raise HTTPException(422, "Select an offered replacement.")
+            if reason != case.get("assist_reason"):
+                raise HTTPException(409, "Payment or reward terms changed. Ask the restaurant to refresh the offer.")
+            selection = RestaurantOrderLineIn.model_validate(option["selection"])
+            line = await _restaurant_resolve_line(order["restaurant_id"], selection, session=session)
+            if _restaurant_replacement_display(line) != option["item"]:
+                raise HTTPException(409, "The menu changed. Ask the restaurant to refresh the options.")
+            restaurant = await _restaurant_replacement_context(order, session)
+            items = _replacement_items(order, case["line_index"], line)
+            totals = _restaurant_replacement_totals(order, restaurant, items)
+            if not reason:
+                if not totals or totals != option["totals"] or order["total"] != case["original_total"]:
+                    raise HTTPException(409, "The price or tax changed. Ask the restaurant to refresh the options.")
+                # Restaurant stock is represented by menu availability. Write to the same
+                # menu row so concurrent catalogue updates conflict with approval.
+                await db.restaurant_menu.update_one({"_id": ObjectId(line["menu_item_id"])},
+                                                   {"$set": {"replacement_checked_at": now}}, session=session)
+                await db.restaurants.update_one({"_id": restaurant["_id"]},
+                                                {"$set": {"replacement_checked_at": now}}, session=session)
+                updates.update({"items": items, **totals})
+                case["final_totals"] = totals
+                case["state"] = "accepted"
+        elif not reason:
+            case["state"] = "rejected"
+        if reason:
+            case.update({"state": "assist_required", "assist_reason": reason})
+            await _replacement_escalate(session, order, case, "restaurant", case)
+        _replacement_decision(case, order, body, user, now)
+        await db.restaurant_orders.update_one({"_id": oid}, {"$set": updates}, session=session)
+        if case["state"] == "accepted":
+            await _replacement_notify(session, order, case, "Replacement confirmed", f"Your updated order total is ₹{totals['total']:.2f}.", "restaurant")
+        return case
+
+    return await _run_replacement_transaction(apply)
+
