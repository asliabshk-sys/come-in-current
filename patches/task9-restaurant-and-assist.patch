+type RestaurantLine = { menu_item_id: string; name: string; quantity: number; unit_price: number; variant?: { id: string; name?: string } };
+
+export function restaurantReplacementOrder<T extends Omit<ReplacementOrder, "items"> & { items: RestaurantLine[] }>(order: T): ReplacementOrder {
+  return {
+    ...order,
+    items: order.items.map((line) => ({
+      product_id: line.menu_item_id, variant_id: line.variant?.id, name: line.name,
+      unit: line.variant?.name, qty: line.quantity, price: line.unit_price,
+    })),
+  };
