+RESTAURANT_REPLACEMENT_ORDER_STATES = {"pending_payment", "placed", "accepted", "preparing"}
+
+
+class RestaurantUnavailableIn(BaseModel):
+    line_index: int = Field(ge=0, lt=100)
+    menu_item_id: str = Field(min_length=1, max_length=40)
+    refresh_case_id: Optional[str] = Field(default=None, max_length=40)
+    alternatives: List[RestaurantOrderLineIn] = Field(default_factory=list, max_length=5)
+
+
+def _restaurant_replacement_totals(order, restaurant, items):
+    def subtotal(lines):
+        return round(sum(float(line.get("line_total", round(line["unit_price"] * line["quantity"], 2))) for line in lines), 2)
+
+    try:
+        fulfillment = order["fulfillment"]
+        if fulfillment not in {"delivery", "pickup"}:
+            return None
+        original = calculate_restaurant_totals(subtotal(order["items"]), order["delivery_fee"], restaurant.get("tax_rate", 5), fulfillment)
+        if any(order.get(key) != value for key, value in original.items()):
+            return None
+        return calculate_restaurant_totals(subtotal(items), order["delivery_fee"], restaurant.get("tax_rate", 5), fulfillment)
+    except (KeyError, ValueError, TypeError, OverflowError):
+        return None
+
+
+def _restaurant_replacement_display(line):
+    variant = line.get("variant") or {}
+    add_ons = line.get("add_ons") or []
+    return {
+        "product_id": line["menu_item_id"], "variant_id": variant.get("id"), "name": line["name"],
+        "unit": " · ".join(filter(None, [variant.get("name"), *(x.get("name") for x in add_ons)])),
+        "qty": line["quantity"], "price": line["unit_price"], "line_total": round(line["unit_price"] * line["quantity"], 2),
+    }
+
+
+async def _restaurant_replacement_context(order, session):
+    restaurant = await db.restaurants.find_one({"_id": _object_id_or_404(order["restaurant_id"], "Restaurant")}, session=session)
+    if not restaurant:
+        raise HTTPException(404, "Restaurant not found")
+    return restaurant
+
+
+@api.post("/restaurant/orders/{order_id}/replacements")
+async def report_restaurant_unavailable(order_id: str, body: RestaurantUnavailableIn, user: dict = Depends(get_current_user)):
+    if user.get("role") not in {"shopkeeper", "admin"}:
+        raise HTTPException(403, "Only authorized restaurant staff can report unavailable items")
+    oid = _object_id_or_404(order_id, "Order")
+
+    async def apply(session):
+        order = await db.restaurant_orders.find_one({"_id": oid}, session=session)
+        if not order:
+            raise HTTPException(404, "Order not found")
+        restaurant = await _restaurant_replacement_context(order, session)
+        _restaurant_owner(restaurant, user)
+        if user["role"] != "admin" and order.get("restaurant_owner_id") != user["id"]:
+            raise HTTPException(403, "Only this restaurant's owner can update its orders")
+        if order["status"] not in RESTAURANT_REPLACEMENT_ORDER_STATES or not order.get("customer_id"):
+            raise HTTPException(409, "Contact COME-IN Assist for this order.")
+        cases = order.get("replacements", [])
+        if body.refresh_case_id:
+            replay = next((row for row in cases if row.get("supersedes") == body.refresh_case_id), None)
+            if replay:
+                return replay
+        active = next((row for row in cases if row["state"] in GROCERY_REPLACEMENT_OPEN_STATES), None)
+        index = body.line_index
+        items = order["items"]
+        if index >= len(items) or items[index].get("menu_item_id") != body.menu_item_id:
+            raise HTTPException(409, "The order items changed. Refresh the order.")
+        if active and active["line_index"] != index:
+            raise HTTPException(409, "Resolve the existing unavailable item first.")
+        if active and not body.refresh_case_id:
+            return active
+        if body.refresh_case_id and (not active or active["id"] != body.refresh_case_id):
+            raise HTTPException(409, "The replacement request changed. Refresh the order.")
+        if len(cases) >= 40:
+            raise HTTPException(409, "Contact COME-IN Assist for further changes.")
+        original = items[index]
+        display = _restaurant_replacement_display(original)
+        reason = _replacement_adjustment_reason(order, "restaurant")
+        if not _restaurant_replacement_totals(order, restaurant, items):
+            reason = reason or "historical_tax_review"
+        options = []
+        seen = set()
+        for selected in body.alternatives:
+            if selected.quantity != original["quantity"]:
+                raise HTTPException(422, "Use the original quantity for a restaurant replacement.")
+            selection = selected.model_copy(update={"instructions": original.get("instructions", "")})
+            key = _restaurant_line_key(selection)
+            if key in seen:
+                raise HTTPException(422, "Duplicate replacement option.")
+            seen.add(key)
+            line = await _restaurant_resolve_line(order["restaurant_id"], selection, session=session)
+            if (line["menu_item_id"], (line.get("variant") or {}).get("id")) == (body.menu_item_id, display["variant_id"]):
+                raise HTTPException(422, "Choose a different item or variant.")
+            proposed = _restaurant_replacement_display(line)
+            options.append({
+                "id": uuid.uuid4().hex, "item": proposed, "selection": selection.model_dump(),
+                "line_difference": round(proposed["line_total"] - display["line_total"], 2),
+                "totals": None if reason else _restaurant_replacement_totals(order, restaurant, _replacement_items(order, index, line)),
+            })
+        reason = reason or ("no_alternative" if not options else None)
+        now = now_utc()
+        case = {
+            "id": uuid.uuid4().hex, "line_index": index, "original": display, "original_item": original,
+            "original_line_total": display["line_total"], "original_total": order["total"], "options": options,
+            "keep_totals": None, "state": "assist_required" if reason else "awaiting_customer",
+            "assist_reason": reason, "reported_by": user["id"], "reported_at": now, "supersedes": body.refresh_case_id,
+        }
+        if reason:
+            await _replacement_escalate(session, order, case, "restaurant", active)
+        if active:
+            active.update({"state": "superseded", "superseded_at": now})
+        cases.append(case)
+        await db.restaurant_orders.update_one({"_id": oid}, {"$set": {"replacements": cases, "updated_at": now}}, session=session)
+        await _replacement_notify(session, order, case, "A restaurant order item is unavailable",
+                                  f"{display['name']} is unavailable. Review your order for replacement options or support.", "restaurant")
+        return case
+
+    return await _run_replacement_transaction(apply)
+
