+"""Restaurant replacements via HTTP and disposable Mongo transactions."""
+import asyncio
+import os
+from pathlib import Path
+from uuid import uuid4
+
+import pytest
+
+
+def test_restaurant_replacement_approval_and_financial_assist(monkeypatch):
+    if os.environ.get("COMEIN_RUN_LOCAL_PAYMENT_TESTS") != "1":
+        pytest.skip("requires disposable loopback MongoDB")
+    import httpx
+    from bson import ObjectId
+    from motor.motor_asyncio import AsyncIOMotorClient
+    import server
+
+    monkeypatch.setenv("JWT_SECRET", uuid4().hex)
+
+    async def run():
+        mongo = AsyncIOMotorClient("mongodb://127.0.0.1:27018/?replicaSet=rs0", serverSelectionTimeoutMS=3000)
+        db = mongo["comein_disposable_food_replace_" + uuid4().hex]
+        monkeypatch.setattr(server, "db", db)
+        monkeypatch.setattr(server, "client", mongo)
+        try:
+            auth = {}
+            ids = {}
+            for actor, role in {"buyer": "customer", "other": "customer", "seller": "shopkeeper",
+                                "other_seller": "shopkeeper", "admin": "admin"}.items():
+                oid = ObjectId()
+                ids[actor] = str(oid)
+                email = f"{actor}@fixture.example"
+                await db.users.insert_one({"_id": oid, "role": role, "email": email})
+                auth[actor] = {"Authorization": "Bearer " + server.create_access_token(str(oid), role, email)}
+            restaurant, original, option, foreign = [ObjectId() for _ in range(4)]
+            await db.restaurants.insert_one({"_id": restaurant, "owner_id": ids["seller"], "tax_rate": 10})
+            await db.restaurant_menu.insert_many([
+                {"_id": option, "restaurant_id": str(restaurant), "name": "Bowl", "price": 100, "available": True,
+                 "variants": [{"id": "large", "name": "Large", "price": 110}],
+                 "add_ons": [{"id": "dip", "name": "Dip", "price": 10, "variant_ids": ["large"]}]},
+                {"_id": foreign, "restaurant_id": str(ObjectId()), "name": "Foreign", "price": 100, "available": True},
+            ])
+            first = {"menu_item_id": str(original), "name": "Soup", "unit_price": 50, "quantity": 2, "instructions": "No onions"}
+            unaffected = {"menu_item_id": str(ObjectId()), "name": "Side", "unit_price": 25, "quantity": 1, "instructions": "Keep sealed"}
+            selection = {"menu_item_id": str(option), "variant_id": "large", "add_on_ids": ["dip"], "quantity": 2, "price": 1}
+
+            async def order(**extra):
+                return (await db.restaurant_orders.insert_one({
+                    "customer_id": ids["buyer"], "restaurant_id": str(restaurant), "restaurant_owner_id": ids["seller"],
+                    "status": "preparing", "fulfillment": "delivery", "payment_method": "cod", "payment_status": "cod_pending",
+                    "items": [first, unaffected], "subtotal": 125, "tax": 12.5, "delivery_fee": 15, "total": 152.5,
+                    "status_history": [{"status": "preparing"}], **extra,
+                })).inserted_id
+
+            async with httpx.AsyncClient(transport=httpx.ASGITransport(app=server.app), base_url="http://local") as http:
+                async def request(method, path, body=None, actor="buyer"):
+                    return await http.request(method, "/api" + path, json=body, headers=auth.get(actor))
+
+                async def report(oid, alternatives=None, actor="seller", **extra):
+                    return await request("POST", f"/restaurant/orders/{oid}/replacements",
+                                         {"line_index": 0, "menu_item_id": str(original),
+                                          "alternatives": [selection] if alternatives is None else alternatives, **extra}, actor)
+
+                async def decide(oid, case, action="accept", actor="buyer"):
+                    return await request("POST", f"/restaurant/orders/{oid}/replacements/{case['id']}/decision",
+                                         {"action": action, "option_id": case["options"][0]["id"] if action == "accept" else None}, actor)
+
+                oid = await order()
+                assert (await report(oid, actor=None)).status_code == 401
+                assert (await report(oid, actor="other_seller")).status_code == 403
+                assert (await report(oid, alternatives=[{"menu_item_id": str(foreign), "quantity": 2}])).status_code == 409
+                assert (await report(oid, alternatives=[{**selection, "quantity": 1}])).status_code == 422
+                requests = await asyncio.gather(report(oid), report(oid))
+                assert [r.status_code for r in requests] == [200, 200]
+                case = requests[0].json()
+                assert requests[1].json()["id"] == case["id"]
+                assert case["options"][0]["line_difference"] == 140
+                assert case["options"][0]["totals"] == {"subtotal": 265, "tax": 26.5, "delivery_fee": 15, "total": 306.5}
+                assert (await decide(oid, case, actor="other")).status_code == 404
+                assert (await decide(oid, case, actor="admin")).status_code == 403
+                assert (await request("PATCH", f"/restaurant/orders/{oid}/status", {"status": "ready"}, "seller")).status_code == 409
+                await db.restaurant_menu.update_one({"_id": option}, {"$set": {"available": False}})
+                assert (await decide(oid, case)).status_code == 409
+                await db.restaurant_menu.update_one({"_id": option}, {"$set": {"available": True, "variants.0.price": 120}})
+                assert (await decide(oid, case)).status_code == 409
+                await db.restaurant_menu.update_one({"_id": option}, {"$set": {"variants.0.price": 110}})
+                results = await asyncio.gather(decide(oid, case), decide(oid, case))
+                assert [r.status_code for r in results] == [200, 200]
+                assert (await decide(oid, case, "reject")).status_code == 409
+                saved = await db.restaurant_orders.find_one({"_id": oid})
+                assert saved["items"][0]["instructions"] == "No onions"
+                assert saved["items"][0]["unit_price"] == 120 and saved["items"][1] == unaffected
+                assert saved["tax"] == 26.5 and saved["payment_status"] == "cod_pending"
+                assert saved["status_history"] == [{"status": "preparing"}]
+                assert len(saved["replacements"][0]["decision_history"]) == 1
+                assert await db.notifications.count_documents({"data.order_id": str(oid), "data.order_kind": "restaurant"}) == 2
+
+                for extra, reason in (
+                    ({"payment_method": "razorpay", "payment_status": "paid", "gateway_payment_id": "fixture"}, "payment_review"),
+                    ({"invoice_id": "historic", "tax": 9.25}, "historical_tax_review"),
+                    ({"coupon_discount": 25}, "reward_review"),
+                ):
+                    oid = await order(**extra)
+                    case = (await report(oid)).json()
+                    assert case["assist_reason"] == reason and not case["options"][0]["totals"]
+                    assert (await decide(oid, case)).json()["state"] == "assist_required"
+                    assert (await decide(oid, case)).json()["support_id"] == case["support_id"]
+                    tickets = (await request("GET", "/restaurant/support/mine")).json()
+                    assert any(ticket["id"] == case["support_id"] and ticket["status"] == "open" for ticket in tickets)
+                    visible = (await request("GET", "/seller/support", actor="seller")).json()
+                    assert any(ticket["id"] == case["support_id"] for ticket in visible)
+                    assert (await request("GET", "/seller/support", actor="other_seller")).json() == []
+                    assert await db.restaurant_support.count_documents({"order_id": str(oid)}) == 1
+                    saved = await db.restaurant_orders.find_one({"_id": oid})
+                    assert saved["items"] == [first, unaffected] and saved["total"] == 152.5
+                    assert all(saved[key] == value for key, value in extra.items())
+                assert await db.financial_ledger.count_documents({}) == 0
+                assert await db.referral_ledger.count_documents({}) == 0
+
+                oid = await order()
+                case = (await report(oid)).json()
+                assert (await decide(oid, case, "reject")).json()["state"] == "rejected"
+                assert (await decide(oid, case)).status_code == 409
+                refreshed = (await report(oid, alternatives=[], refresh_case_id=case["id"])).json()
+                assert refreshed["assist_reason"] == "no_alternative"
+        finally:
+            await mongo.drop_database(db.name)
+            mongo.close()
+
+    asyncio.run(run())
+
+
+def test_restaurant_replacement_uses_existing_screens():
+    frontend = Path(__file__).resolve().parents[2] / "frontend/app"
+    assert 'staff kind="restaurant" menu={menu}' in (frontend / "restaurant/dashboard.tsx").read_text()
+    assert 'onChange={load} kind="restaurant"' in (frontend / "restaurant/orders/[id].tsx").read_text()
+    notification = (frontend / "notifications.tsx").read_text()
+    assert '"restaurant_replacement"' in notification and 'pathname: "/restaurant/orders/[id]"' in notification
