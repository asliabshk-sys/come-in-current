+DEFAULT_REPLACEMENT_EXPIRY_MINUTES = 15
+REPLACEMENT_EXPIRY_SETTINGS = "replacement-expiry-settings"
+_EXPIRED_REPLACEMENT = object()
+
+
+class ReplacementExpirySettingsIn(BaseModel):
+    default_minutes: int = Field(gt=0, strict=True)
+    minimum_minutes: int = Field(gt=0, strict=True)
+    maximum_minutes: int = Field(gt=0, strict=True)
+    expected_version: int = Field(ge=0, strict=True)
+    reason: str = Field(min_length=5, max_length=500)
+
+
+class ReplacementExpiryAdjustmentIn(BaseModel):
+    offer_id: str = Field(min_length=1, max_length=40)
+    expected_expires_at: datetime
+    duration_minutes: int = Field(gt=0, strict=True)
+    reason: str = Field(min_length=5, max_length=500)
+
+
+async def _replacement_expiry_settings(session=None):
+    stored = await db.financial_policy_drafts.find_one({"_id": REPLACEMENT_EXPIRY_SETTINGS}, session=session)
+    return stored or {"default_minutes": DEFAULT_REPLACEMENT_EXPIRY_MINUTES,
+                      "minimum_minutes": None, "maximum_minutes": None, "version": 0}
+
+
+@api.get("/admin/replacements/expiry-settings")
+async def get_replacement_expiry_settings(_: dict = Depends(require_role("admin"))):
+    return doc_out(await _replacement_expiry_settings())
+
+
+@api.put("/admin/replacements/expiry-settings")
+async def save_replacement_expiry_settings(body: ReplacementExpirySettingsIn, user: dict = Depends(require_role("admin"))):
+    if not body.minimum_minutes <= body.default_minutes <= body.maximum_minutes or len(body.reason.strip()) < 5:
+        raise HTTPException(422, "Set minimum ≤ default ≤ maximum and provide a reason.")
+    try:
+        now_utc() + timedelta(minutes=body.maximum_minutes)
+    except OverflowError:
+        raise HTTPException(422, "The maximum cannot be represented as an expiry timestamp.") from None
+
+    async def apply(session):
+        previous = await _replacement_expiry_settings(session)
+        if previous["version"] != body.expected_version:
+            raise HTTPException(409, "Expiry settings changed. Reload before saving.")
+        fields = ("default_minutes", "minimum_minutes", "maximum_minutes")
+        values = {key: getattr(body, key) for key in fields}
+        now = now_utc()
+        updated = {"_id": REPLACEMENT_EXPIRY_SETTINGS, "record_type": "replacement_expiry",
+                   **values, "version": previous["version"] + 1, "updated_at": now}
+        await db.financial_policy_drafts.replace_one({"_id": REPLACEMENT_EXPIRY_SETTINGS}, updated, upsert=True, session=session)
+        await db.financial_audit.insert_one({"action": "replacement_expiry_settings_updated", "actor_id": user["id"],
+            "previous": {key: previous[key] for key in fields}, "new": values, "version": updated["version"],
+            "created_at": now, "reason": body.reason.strip()}, session=session)
+        return doc_out(updated)
+
+    return await _run_replacement_transaction(apply)
+
+
+def _replacement_scope(kind):
+    return (db.orders, GROCERY_REPLACEMENT_ORDER_STATES) if kind == "grocery" else (db.restaurant_orders, RESTAURANT_REPLACEMENT_ORDER_STATES)
+
+
+async def _publish_replacement_option(session, order, case, option, kind, title, message):
+    policy = await _replacement_expiry_settings(session)
+    # Order visibility and in-app delivery commit together. A failed notice
+    # cannot leave an actionable offer or start its clock.
+    created = now_utc()
+    await _replacement_notify(session, order, case, title, message, kind)
+    available = now_utc()
+    duration = policy["default_minutes"]
+    case["active_offer"] = {"option_id": option["id"], "created_at": created, "available_at": available,
+                            "expires_at": available + timedelta(minutes=duration), "duration_minutes": duration,
+                            "policy_version": policy["version"]}
+
+
+def _archive_replacement_option(case, state, now, actor_id):
+    active = case.pop("active_offer", None)
+    if active:
+        case.setdefault("offer_history", []).append({**active, "status": state, "closed_at": now, "actor_id": actor_id})
+
+
+async def _available_replacement_option(session, order, case, option, kind):
+    """Skip stale alternatives. Confirmation still uses the original decision path."""
+    if order["total"] != case["original_total"] or not 0 <= case["line_index"] < len(order["items"]):
+        return False
+    try:
+        item = option["item"]
+        if kind == "grocery":
+            if _replacement_snapshot(order["items"][case["line_index"]]) != case["original"]:
+                return False
+            lines, shop_id = await _resolve_grocery_lines(
+                [QuoteLineIn(product_id=item["product_id"], variant_id=item.get("variant_id"), qty=item["qty"])], session=session)
+            if shop_id != order["shop_id"] or _replacement_snapshot(lines[0]) != item:
+                return False
+            totals = _replacement_totals(order, case["line_index"], lines[0])
+        else:
+            if _restaurant_replacement_display(order["items"][case["line_index"]]) != case["original"]:
+                return False
+            restaurant = await _restaurant_replacement_context(order, session)
+            selection = RestaurantOrderLineIn.model_validate(option["selection"])
+            line = await _restaurant_resolve_line(order["restaurant_id"], selection, session=session)
+            if _restaurant_replacement_display(line) != item:
+                return False
+            totals = _restaurant_replacement_totals(order, restaurant, _replacement_items(order, case["line_index"], line))
+    except HTTPException as exc:
+        if exc.status_code in {404, 409, 422}:
+            return False
+        raise
+    reason = _replacement_adjustment_reason(order, kind)
+    if reason != case.get("assist_reason") or not totals:
+        return False
+    if option["totals"] is not None:
+        return totals == option["totals"]
+    return _replacement_payment_quotes(order, totals, kind) == {
+        key: option[key] for key in ("collection_quote", "replacement_refund_quote") if key in option
+    }
+
+
+async def _advance_replacement_offer(session, order, case, kind, outcome, actor_id):
+    now = now_utc()
+    _archive_replacement_option(case, outcome, now, actor_id)
+    attempted = {entry["option_id"] for entry in case["offer_history"]}
+    for option in case["options"]:
+        if option["id"] in attempted:
+            continue
+        if await _available_replacement_option(session, order, case, option, kind):
+            await _publish_replacement_option(session, order, case, option, kind, "Another replacement is available",
+                                             "Open your order to review the next option and its deadline.",)
+            break
+        case["offer_history"].append({"option_id": option["id"], "status": "unavailable", "closed_at": now,
+                                      "actor_id": "system"})
+    else:
+        # Preserve explicitly chosen eligible item-removal behavior after a
+        # decline. Escalation itself never changes the line, totals or payment.
+        if outcome == "rejected":
+            _replacement_decision(case, order, GroceryReplacementDecisionIn(action="reject"), {"id": actor_id}, now)
+            case["state"] = "assist_required" if case.get("assist_reason") else "rejected"
+        else:
+            case.update({"state": "assist_required", "assist_reason": case.get("assist_reason") or "no_alternative"})
+        support_case = {**case, "assist_reason": case.get("assist_reason") or "no_alternative"}
+        await _replacement_escalate(session, order, support_case, kind, case)
+        case["support_id"] = support_case["support_id"]
+        if case.get("assist_reason"):
+            await _replacement_financial_review(session, order, case, kind)
+        # An expiry needs a fresh customer notice. A decline is already shown
+        # synchronously in the order UI and has an available Assist link.
+        if outcome == "expired":
+            await _replacement_notify(session, order, case, "Replacement offer expired",
+                                      "Contact COME-IN Assist for this unavailable item. Your order was not cancelled.", kind)
+    collection, _ = _replacement_scope(kind)
+    await collection.update_one({"_id": order["_id"]}, {"$set": {
+        "replacements": order["replacements"], "updated_at": now,
+    }}, session=session)
+    return case
+
+
+async def _managed_replacement_decision(session, order, case, kind, body, user):
+    """Return a handled result or defer to existing acceptance/removal rules."""
+    if not case.get("offer_sequence") or case.get("state") not in GROCERY_REPLACEMENT_OPEN_STATES:
+        return None
+    _, states = _replacement_scope(kind)
+    if order["status"] not in states:
+        return None
+    active = case.get("active_offer")
+    if body.action == "reject" and body.offer_id and any(
+        entry["option_id"] == body.offer_id and entry["status"] == "rejected" for entry in case["offer_history"]
+    ):
+        return case
+    if not active:
+        if body.action == "accept" and not case.get("decision"):
+            raise HTTPException(409, "No replacement option is open. Contact COME-IN Assist.")
+        return None
+    if utc(active["expires_at"]) <= now_utc():
+        await _advance_replacement_offer(session, order, case, kind, "expired", "system")
+        return _EXPIRED_REPLACEMENT
+    if body.action == "reject":
+        if body.option_id or body.offer_id != active["option_id"]:
+            raise HTTPException(409, "Refresh the order before declining the current option.")
+        return await _advance_replacement_offer(session, order, case, kind, "rejected", user["id"])
+    if body.action == "accept" and body.option_id != active["option_id"]:
+        if not any(option["id"] == body.option_id for option in case["options"]):
+            raise HTTPException(422, "Select an offered replacement.")
+        raise HTTPException(409, "Only the current replacement option can be accepted.")
+    return None
+
+
+def _check_active_replacement_deadline(case):
+    active = case.get("active_offer")
+    if active and utc(active["expires_at"]) <= now_utc():
+        raise HTTPException(409, "The offer expired. Refresh the order to check the replacement status.")
+
+
+@api.patch("/admin/replacements/{kind}/{order_id}/{case_id}/expiry")
+async def adjust_replacement_offer_expiry(kind: Literal["grocery", "restaurant"], order_id: str, case_id: str,
+                                         body: ReplacementExpiryAdjustmentIn, user: dict = Depends(require_role("admin"))):
+    if body.expected_expires_at.utcoffset() is None or len(body.reason.strip()) < 5:
+        raise HTTPException(422, "Provide the expiry with its timezone and a reason.")
+    oid = _object_id_or_404(order_id, "Order")
+    collection, states = _replacement_scope(kind)
+
+    async def apply(session):
+        order = await collection.find_one({"_id": oid}, session=session)
+        case = next((entry for entry in (order or {}).get("replacements", []) if entry["id"] == case_id), None)
+        if not case:
+            raise HTTPException(404, "Replacement request not found.")
+        active = case.get("active_offer")
+        now = now_utc()
+        if (not active or case.get("decision") or case["state"] not in GROCERY_REPLACEMENT_OPEN_STATES
+                or order["status"] not in states or active["option_id"] != body.offer_id or utc(active["expires_at"]) <= now
+                or utc(active["expires_at"]) != body.expected_expires_at):
+            raise HTTPException(409, "Only the current pending, unexpired offer can be adjusted.")
+        policy = await _replacement_expiry_settings(session)
+        if policy["minimum_minutes"] is None or not policy["minimum_minutes"] <= body.duration_minutes <= policy["maximum_minutes"]:
+            raise HTTPException(422, "Configure Admin expiry limits and select a duration within them.")
+        try:
+            deadline = utc(active["available_at"]) + timedelta(minutes=body.duration_minutes)
+        except OverflowError:
+            raise HTTPException(422, "The adjusted expiry timestamp is outside the supported range.") from None
+        if deadline <= now:
+            raise HTTPException(422, "The adjusted expiry must be in the future.")
+        if deadline == utc(active["expires_at"]):
+            return case
+        previous = {"duration_minutes": active["duration_minutes"], "expires_at": active["expires_at"]}
+        active.update({"duration_minutes": body.duration_minutes, "expires_at": deadline})
+        await _replacement_notify(session, order, case, "Replacement deadline updated",
+                                  "Open your order to review the new deadline.", kind)
+        await collection.update_one({"_id": oid}, {"$set": {"replacements": order["replacements"], "updated_at": now}}, session=session)
+        await db.financial_audit.insert_one({"action": "replacement_offer_expiry_adjusted", "order_id": order_id,
+            "order_kind": kind, "replacement_id": case_id, "offer_id": body.offer_id, "actor_id": user["id"],
+            "created_at": now, "reason": body.reason.strip(), "previous": previous,
+            "new": {"duration_minutes": body.duration_minutes, "expires_at": deadline}}, session=session)
+        return case
+
+    return await _run_replacement_transaction(apply)
+
+
+async def _expire_due_replacement_offers(kind):
+    collection, states = _replacement_scope(kind)
+    due = {"state": {"$in": list(GROCERY_REPLACEMENT_OPEN_STATES)},
+           "active_offer.expires_at": {"$lte": now_utc()}}
+    rows = await collection.find({"status": {"$in": list(states)}, "replacements": {"$elemMatch": due}},
+                                 {"_id": 1}).limit(50).to_list(50)
+    for row in rows:
+        async def apply(session):
+            order = await collection.find_one({"_id": row["_id"], "status": {"$in": list(states)}}, session=session)
+            for case in (order or {}).get("replacements", []):
+                active = case.get("active_offer")
+                if active and not case.get("decision") and case["state"] in GROCERY_REPLACEMENT_OPEN_STATES and utc(active["expires_at"]) <= now_utc():
+                    await _advance_replacement_offer(session, order, case, kind, "expired", "system")
+
+        try:
+            await _run_replacement_transaction(apply)
+        except Exception:
+            logger.exception("Replacement expiry could not be committed; order %s will be retried", row["_id"])
+
+
+async def _replacement_expiry_worker():
+    while True:
+        await asyncio.sleep(5)
+        try:
+            for kind in ("grocery", "restaurant"):
+                await _expire_due_replacement_offers(kind)
+        except Exception:
+            logger.exception("Replacement expiry scan failed; retrying")
+
