+function ReplacementExpirySettings() {
+  const styles = useStyles();
+  const [policy, setPolicy] = useState<{ default_minutes: number; minimum_minutes: number | null; maximum_minutes: number | null; version: number } | null>(null);
+  const [reason, setReason] = useState("");
+  const [notice, setNotice] = useState("");
+  const [busy, setBusy] = useState(false);
+  const path = "/admin/replacements/expiry-settings";
+
+  const load = async () => {
+    try { setPolicy(await api.get<NonNullable<typeof policy>>(path)); }
+    catch (error: any) { setNotice(error?.message || "Could not load replacement expiry settings."); }
+  };
+
+  return <View style={styles.card}>
+    <ActionBtn label="Load replacement expiry settings" onPress={load} />
+    {policy ? <>
+      {(["default_minutes", "minimum_minutes", "maximum_minutes"] as const).map((field) =>
+        <TextInput key={field} accessibilityLabel={field.replaceAll("_", " ")} placeholder={field.replaceAll("_", " ")}
+          style={styles.input} inputMode="numeric" value={policy[field] == null ? "" : String(policy[field])}
+          onChangeText={(value) => {
+            if (/^\d*$/.test(value)) {
+              setPolicy((current) => current ? { ...current, [field]: value ? Number(value) : null } : current);
+            }
+          }} />)}
+      <TextInput accessibilityLabel="Expiry settings reason" placeholder="Reason for changing expiry settings" style={styles.input} value={reason} onChangeText={setReason} />
+      <ActionBtn label="Save replacement expiry settings" onPress={async () => {
+        if (busy) return;
+        setBusy(true);
+        try {
+          setPolicy(await api.put<NonNullable<typeof policy>>(path, { default_minutes: policy.default_minutes, minimum_minutes: policy.minimum_minutes,
+            maximum_minutes: policy.maximum_minutes, expected_version: policy.version, reason: reason.trim() }));
+          setNotice("Settings saved for newly issued options.");
+        } catch (error: any) { setNotice(error?.message || "Could not save replacement expiry settings."); }
+        finally { setBusy(false); }
+      }} />
+    </> : null}
+    {notice ? <Text accessibilityLiveRegion="polite" style={styles.cardMeta}>{notice}</Text> : null}
+  </View>;
+}
