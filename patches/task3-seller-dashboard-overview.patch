+"""Static contracts for the Task 3 seller-dashboard increment.
+
+These tests prove route wiring and privacy boundaries only. They do not claim
+an Expo/device session, provider-backed AI, bank verification, or a transfer.
+"""
+from pathlib import Path
+
+
+ROOT = Path(__file__).parents[2]
+
+
+def test_seller_overview_reuses_authorized_existing_apis_without_demo_metrics():
+    dashboard = (ROOT / "frontend/app/seller/dashboard.tsx").read_text()
+    assert 'api.get<Shop | null>("/shops/mine")' in dashboard
+    assert 'api.get<DashboardData>(`/earnings/mine?shop_id=${encodeURIComponent(current.id)}`)' in dashboard
+    assert 'api.get<Order[]>(`/shops/${encodeURIComponent(current.id)}/orders`)' in dashboard
+    assert 'api.get<SupportTicket[]>("/seller/support")' in dashboard
+    assert "They are never demo values" in dashboard
+    assert "do not initiate settlement, payment, refund or stock changes" in dashboard
+    assert 'user.role !== "shopkeeper"' in dashboard
+
+
+def test_seller_dashboard_navigation_reuses_existing_seller_surfaces():
+    dashboard = (ROOT / "frontend/app/seller/dashboard.tsx").read_text()
+    account = (ROOT / "frontend/app/(tabs)/account.tsx").read_text()
+    profile = (ROOT / "frontend/app/become-seller.tsx").read_text()
+    for route in ('"/seller/orders"', '"/seller/products"', '"/seller-earnings"', '"/seller/support"', '"/seller/help"', '"/become-seller"'):
+        assert route in dashboard
+    assert 'router.push("/seller/dashboard")' in account
+    assert 'router.push("/seller/help")' in account
+    assert 'router.push("/seller/dashboard")' in profile
+
+
+def test_seller_help_is_bounded_and_does_not_claim_unconfigured_ai():
+    help_screen = (ROOT / "frontend/app/seller/help.tsx").read_text()
+    assert "An AI provider is not configured or claimed here." in help_screen
+    assert "It cannot make refunds, change bank details, publish ads, or perform actions for you." in help_screen
+    assert "never send passwords, OTPs, API keys or full bank numbers" in help_screen
+    assert 'router.push("/seller/support")' in help_screen
+    assert 'user.role !== "shopkeeper"' in help_screen
