+import Feather from "@react-native-vector-icons/feather";
+import { useRouter } from "expo-router";
+import { Pressable, ScrollView, StyleSheet, Text, View } from "react-native";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+
+import { useAuth } from "@/src/store/auth";
+import { makeStyles, radius, spacing, useTheme } from "@/src/theme";
+
+const GUIDES = [
+  ["Add or update a product", "Use Products to add real names, price, unit, stock and category. Prices and stock are checked again during checkout.", "/seller/products"],
+  ["Import a catalogue", "Use Products → Import. Review every staged record, correct missing information, and approve only valid products before applying.", "/seller/products"],
+  ["Manage orders", "Use Orders to accept or decline new orders and progress only the status actions offered by the dashboard.", "/seller/orders"],
+  ["Understand earnings", "Earnings shows authorized sales, settlement records and masked bank details. A settlement request does not transfer money.", "/seller-earnings"],
+  ["Handle order issues", "Support Tickets contains only tickets for your own Grocery or Restaurant orders. Do not request customer passwords, OTPs or bank details.", "/seller/support"],
+] as const;
+
+/** A bounded help center. It intentionally does not impersonate CHAND or claim an AI provider is configured. */
+export default function SellerHelpScreen() {
+  const router = useRouter(); const insets = useSafeAreaInsets(); const { user } = useAuth(); const { colors } = useTheme(); const styles = useStyles();
+  if (!user || user.role !== "shopkeeper") return <View style={styles.centered}><Text style={styles.message}>Seller access is required for Seller Help.</Text><Pressable style={styles.button} onPress={() => router.replace("/(tabs)/account")}><Text style={styles.buttonText}>Back to Account</Text></Pressable></View>;
+  return <View style={styles.root}>
+    <View style={[styles.header, { paddingTop: insets.top + spacing.sm }]}><Pressable accessibilityLabel="Back" style={styles.icon} onPress={() => router.back()}><Feather name="arrow-left" size={19} color={colors.onSurface} /></Pressable><View style={{ flex: 1 }}><Text style={styles.title}>Seller Help</Text><Text style={styles.subtitle}>Guidance for Come-In seller operations</Text></View></View>
+    <ScrollView contentContainerStyle={styles.content}>
+      <View style={styles.notice}><Feather name="shield" size={18} color={colors.brandPrimary} /><Text style={styles.noticeText}>This Help Center uses approved in-app guidance. An AI provider is not configured or claimed here. It cannot make refunds, change bank details, publish ads, or perform actions for you.</Text></View>
+      <Text style={styles.sectionTitle}>Common tasks</Text>
+      {GUIDES.map(([title, detail, route]) => <Pressable key={title} style={styles.card} onPress={() => router.push(route)}><View style={{ flex: 1 }}><Text style={styles.cardTitle}>{title}</Text><Text style={styles.cardText}>{detail}</Text></View><Feather name="chevron-right" size={18} color={colors.muted} /></Pressable>)}
+      <Text style={styles.sectionTitle}>Need human support?</Text>
+      <View style={styles.card}><View style={{ flex: 1 }}><Text style={styles.cardTitle}>Order-linked support tickets</Text><Text style={styles.cardText}>Use Seller Support to view and update authorized customer/order tickets. For product setup, imports or account questions, keep details in the authorized support path and never send passwords, OTPs, API keys or full bank numbers.</Text></View></View>
+      <Pressable style={styles.button} onPress={() => router.push("/seller/support")}><Text style={styles.buttonText}>Open Seller Support</Text></Pressable>
+    </ScrollView>
+  </View>;
+}
+
