+async def _validate_pending_payment_review(session, ticket, review, stage):
+    """Reconcile a proposed review with the current order before recording approval."""
+    kind = ticket["order_kind"]
+    grocery = kind == "grocery"
+    collection = db.orders if grocery else db.restaurant_orders
+    oid = _object_id_or_404(ticket["order_id"], "Order")
+    order = await collection.find_one({"_id": oid, "customer_id": ticket["user_id"]}, session=session)
+    states = GROCERY_REPLACEMENT_ORDER_STATES if grocery else RESTAURANT_REPLACEMENT_ORDER_STATES
+    case = next((row for row in (order or {}).get("replacements", [])
+                 if row["id"] == review["replacement_id"]), None)
+    if (not order or not case or case["state"] != "assist_required"
+            or order["status"] not in states or order.get("refund_status")
+            or _replacement_adjustment_reasons(order, kind) != ["payment_review"]
+            or _replacement_original_financials(order) != review["original"]
+            or (case.get("decision") or {}).get("action") != review["decision"]):
+        raise HTTPException(409, "The order or financial terms changed. Refresh the review.")
+    index = case["line_index"]
+    if stage == "refund":
+        totals = await _replacement_removal_totals(session, order, index, kind)
+        if not totals or any(review["removal_quote"].get(key) != value for key, value in totals.items()):
+            raise HTTPException(409, "The remaining items or removal total changed.")
+    else:
+        option = next((row for row in case["options"] if row["id"] == review["option_id"]), None)
+        if not option or option.get("collection_quote") != review["collection_quote"]:
+            raise HTTPException(409, "The original collection quote changed.")
+        if grocery:
+            item = option["item"]
+            lines, shop_id = await _resolve_grocery_lines(
+                [QuoteLineIn(product_id=item["product_id"], qty=item["qty"], variant_id=item.get("variant_id"))], session=session,
+            )
+            if shop_id != order["shop_id"] or _replacement_snapshot(lines[0]) != item:
+                raise HTTPException(409, "The replacement or catalogue price changed.")
+            totals = _replacement_totals(order, index, lines[0])
+        else:
+            restaurant = await _restaurant_replacement_context(order, session)
+            line = await _restaurant_resolve_line(
+                order["restaurant_id"], RestaurantOrderLineIn.model_validate(option["selection"]), session=session,
+            )
+            if _restaurant_replacement_display(line) != option["item"]:
+                raise HTTPException(409, "The replacement or catalogue price changed.")
+            totals = _restaurant_replacement_totals(order, restaurant, _replacement_items(order, index, line))
+        if not totals or totals["total"] != review["collection_quote"]["total"]:
+            raise HTTPException(409, "The replacement total changed.")
+    # Write to the same order inside the approval transaction to serialize
+    # approval with order cancellation, repricing, or refund state changes.
+    await collection.update_one({"_id": oid}, {"$set": {"replacement_financial_reviewed_at": now_utc()}}, session=session)
+
