+@api.get("/admin/replacements/migration")
+async def replacement_migration_status(_: dict = Depends(require_role("admin"))):
+    statuses = {"grace": 0, "migrated": 0, "excluded": 0}
+    failed = 0
+    eligible = 0
+    review = []
+    for kind in ("grocery", "restaurant"):
+        collection, _ = _replacement_scope(kind)
+        pipeline = [{"$match": {"replacements.legacy_migration.campaign": REPLACEMENT_MIGRATION_CAMPAIGN}},
+                    {"$unwind": "$replacements"},
+                    {"$match": {"replacements.legacy_migration.campaign": REPLACEMENT_MIGRATION_CAMPAIGN}}]
+        groups = await collection.aggregate([*pipeline, {"$group": {
+            "_id": "$replacements.legacy_migration.status", "count": {"$sum": 1},
+            "failed": {"$sum": {"$cond": [{"$ifNull": ["$replacements.legacy_migration.last_failure", False]}, 1, 0]}},
+            "eligible": {"$sum": {"$cond": [{"$ifNull": ["$replacements.legacy_migration.notified_at", False]}, 1, 0]}},
+        }}]).to_list(None)
+        for group in groups:
+            statuses[group["_id"]] += group["count"]
+            failed += group["failed"]
+            eligible += group["eligible"]
+        rows = await collection.aggregate([*pipeline, {"$sort": {"replacements.legacy_migration.updated_at": -1}},
+            {"$limit": 25}, {"$project": {"case_id": "$replacements.id", "migration": "$replacements.legacy_migration"}}]).to_list(25)
+        review.extend({**doc_out(row), "kind": kind} for row in rows)
+    audit = await db.financial_audit.find({"action": "replacement_legacy_migration", "campaign": REPLACEMENT_MIGRATION_CAMPAIGN},
+                                          {"source_financials": 0}).sort("created_at", -1).limit(50).to_list(50)
+    return {"campaign": REPLACEMENT_MIGRATION_CAMPAIGN, "statuses": statuses, "failed": failed,
+            "eligible": eligible, "recent": review, "audit": [doc_out(row) for row in audit]}
