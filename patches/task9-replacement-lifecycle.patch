+async def _migrate_legacy_replacement(session, order, case, kind):
+    migration = case["legacy_migration"]
+    if (order["status"] != migration["source_status"] or case["state"] != migration["source_case_status"]
+            or _replacement_original_financials(order) != migration["source_financials"]
+            or [option["id"] for option in case.get("options", [])] != migration["option_ids"]):
+        eligible, reason = [], "changed_during_grace"
+    else:
+        eligible, reason = await _legacy_replacement_options(session, order, case, kind)
+    if reason:
+        return await _record_replacement_migration(session, order, case, kind, "system", "excluded", reason=reason)
+    case.update({"offer_sequence": True, "offer_history": []})
+    eligible_ids = {option["id"] for option in eligible}
+    now = now_utc()
+    for option in case["options"]:
+        if option["id"] not in eligible_ids:
+            case["offer_history"].append({"option_id": option["id"], "status": "unavailable", "actor_id": "system", "closed_at": now})
+    await _publish_replacement_option(session, order, case, eligible[0], kind,
+                                    "Your timed replacement offer is active",
+                                    "Open your order to review the available option. It is valid for 15 minutes.",
+                                    migration=True)
+    return await _record_replacement_migration(session, order, case, kind, "system", "migrated",
+                                               migrated_at=case["active_offer"]["available_at"], last_failure=None)
+
+
+async def _process_legacy_replacement_migration(kind):
+    collection, _ = _replacement_scope(kind)
+    now = now_utc()
+    due = {"legacy_migration.status": "grace", "legacy_migration.next_attempt_at": {"$lte": now}}
+    orders = await collection.find({"replacements": {"$elemMatch": due}}, {"_id": 1}).limit(50).to_list(50)
+    for row in orders:
+        async def apply(session, failure=False):
+            order = await collection.find_one({"_id": row["_id"]}, session=session)
+            for case in (order or {}).get("replacements", []):
+                migration = case.get("legacy_migration")
+                if not migration or migration["status"] != "grace" or utc(migration["next_attempt_at"]) > now_utc():
+                    continue
+                if failure:
+                    await _record_replacement_migration(session, order, case, kind, "system", "grace",
+                        next_attempt_at=now_utc() + timedelta(minutes=1), last_failure="activation_transaction_failed")
+                else:
+                    await _migrate_legacy_replacement(session, order, case, kind)
+
+        try:
+            await _run_replacement_transaction(apply)
+        except Exception:
+            logger.exception("Legacy replacement migration failed for order %s", row["_id"])
+            await _run_replacement_transaction(lambda session: apply(session, failure=True))
+
