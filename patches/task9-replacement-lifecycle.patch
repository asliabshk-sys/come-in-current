+@api.post("/admin/replacements/{kind}/{order_id}/{case_id}/manual-resolution")
+async def resolve_protected_replacement(kind: Literal["grocery", "restaurant"], order_id: str, case_id: str,
+                                        body: ReplacementManualResolutionIn, user: dict = Depends(require_role("admin"))):
+    reason = body.reason.strip()
+    if len(reason) < 5:
+        raise HTTPException(422, "Document why the existing order can be fulfilled.")
+    collection, _ = _replacement_scope(kind)
+    oid = _object_id_or_404(order_id, "Order")
+
+    async def apply(session):
+        order = await collection.find_one({"_id": oid}, session=session)
+        case = next((row for row in (order or {}).get("replacements", []) if row["id"] == case_id), None)
+        if not case:
+            raise HTTPException(404, "Replacement request not found.")
+        if case.get("manual_resolution"):
+            return case["manual_resolution"]
+        if (order["status"] not in {"preparing", "ready"} or case["state"] != "assist_required"
+                or not case.get("fulfillment_locked_at") or (case.get("decision") or {}).get("action") == "accept"
+                or not ObjectId.is_valid(case.get("support_id"))):
+            raise HTTPException(409, "Only a protected unresolved replacement can be closed here.")
+        _validate_replacement_original(order, case, kind)
+        ticket = await db.restaurant_support.find_one({"_id": ObjectId(case["support_id"]), "user_id": order["customer_id"],
+            "order_id": order_id, "order_kind": kind, "status": {"$in": ["resolved", "closed"]}}, session=session)
+        if not ticket:
+            raise HTTPException(409, "Resolve the linked COME-IN Assist ticket first.")
+        # Touch the resolved ticket in this transaction so a concurrent reopen conflicts.
+        now = now_utc()
+        await db.restaurant_support.update_one({"_id": ticket["_id"]},
+            {"$push": {"history": {"status": ticket["status"], "at": now, "updated_by": user["id"],
+                                    "actor_role": user["role"], "action": "replacement_closed_existing_fulfillment"}}}, session=session)
+        resolution = {"resolved_at": now, "support_id": case["support_id"]}
+        case.update({"state": "resolved", "manual_resolution": resolution})
+        await db.financial_audit.insert_one({"action": "replacement_manual_resolution", "order_id": order_id,
+            "order_kind": kind, "replacement_id": case_id, "previous": "assist_required", "new": "resolved",
+            "actor_id": user["id"], "reason": reason, **resolution},
+            session=session)
+        await _replacement_notify(session, order, case, "Replacement review resolved",
+                                  "Assist completed the review. Your existing order items and total are unchanged.", kind)
+        await collection.update_one({"_id": oid}, {"$set": {"replacements": order["replacements"], "updated_at": now}}, session=session)
+        return resolution
+
+    return await _run_replacement_transaction(apply)
