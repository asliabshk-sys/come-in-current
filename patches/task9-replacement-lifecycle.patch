+async def _legacy_replacement_options(session, order, case, kind):
+    if order["status"] not in _replacement_scope(kind)[1]:
+        return [], "order_stage_ineligible"
+    if case["state"] != "awaiting_customer" or case.get("decision") or case.get("decision_history"):
+        return [], "offer_has_decision_or_is_closed"
+    if case.get("offer_sequence") or case.get("active_offer"):
+        return [], "already_uses_timed_policy"
+    if case.get("expires_at"):
+        if not isinstance(case["expires_at"], datetime):
+            return [], "legacy_expiry_ambiguous"
+        if utc(case["expires_at"]) <= now_utc():
+            return [], "legacy_offer_expired"
+    if not isinstance(case.get("reported_at"), datetime) or not case.get("options"):
+        return [], "legacy_record_incomplete"
+    try:
+        _validate_replacement_original(order, case, kind)
+        eligible = [option for option in case["options"]
+                    if await _available_replacement_option(session, order, case, option, kind)]
+    except (KeyError, TypeError, ValueError, IndexError):
+        return [], "legacy_record_incomplete"
+    except HTTPException as exc:
+        if exc.status_code != 409:
+            raise
+        return [], "order_snapshot_changed"
+    return eligible, None if eligible else "no_current_eligible_options"
+
+
+async def _record_replacement_migration(session, order, case, kind, actor, state, **details):
+    now = now_utc()
+    migration = case.get("legacy_migration") or {"campaign": REPLACEMENT_MIGRATION_CAMPAIGN,
+                                               "legacy_reported_at": case.get("reported_at")}
+    previous = migration.get("status")
+    migration.update({"status": state, "updated_at": now, **details})
+    case["legacy_migration"] = migration
+    if state != "grace":
+        migration.pop("next_attempt_at", None)
+    collection, _ = _replacement_scope(kind)
+    await collection.update_one({"_id": order["_id"]}, {"$set": {"replacements": order["replacements"]}}, session=session)
+    await db.financial_audit.insert_one({
+        "action": "replacement_legacy_migration", "campaign": REPLACEMENT_MIGRATION_CAMPAIGN,
+        "order_kind": kind, "order_id": str(order["_id"]), "replacement_id": case["id"],
+        "actor_id": actor, "previous": previous, "new": state, "created_at": now, **details,
+    }, session=session)
+    return migration
+
