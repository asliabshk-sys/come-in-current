+@api.post("/admin/replacements/migration/{kind}/{order_id}/{case_id}")
+async def enroll_legacy_replacement(kind: Literal["grocery", "restaurant"], order_id: str, case_id: str,
+                                   user: dict = Depends(require_role("admin"))):
+    collection, _ = _replacement_scope(kind)
+    oid = _object_id_or_404(order_id, "Order")
+
+    async def apply(session):
+        order = await collection.find_one({"_id": oid}, session=session)
+        case = next((row for row in (order or {}).get("replacements", []) if row["id"] == case_id), None)
+        if not case:
+            raise HTTPException(404, "Replacement request not found.")
+        if case.get("legacy_migration"):
+            return case["legacy_migration"]
+        _, reason = await _legacy_replacement_options(session, order, case, kind)
+        if reason:
+            return await _record_replacement_migration(session, order, case, kind, user["id"], "excluded", reason=reason)
+        await _replacement_notify(session, order, case, "Replacement offer policy is changing",
+                                  "Your current offer remains available under its existing terms for the migration grace period. "
+                                  "After 24 hours we will recheck it and notify you if a timed offer is available.", kind)
+        notified = now_utc()
+        grace_until = notified + REPLACEMENT_MIGRATION_GRACE
+        return await _record_replacement_migration(session, order, case, kind, user["id"], "grace",
+            notified_at=notified, grace_until=grace_until, next_attempt_at=grace_until,
+            source_status=order["status"], source_case_status=case["state"],
+            source_financials=_replacement_original_financials(order),
+            option_ids=[option["id"] for option in case["options"]])
+
+    return await _run_replacement_transaction(apply)
