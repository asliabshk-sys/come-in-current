+  if (!user || user.role !== "admin") return <View style={styles.centered}><Text style={styles.message}>Admin access is required.</Text></View>;
+  if (loading) return <View style={styles.centered}><ActivityIndicator color={colors.brandPrimary} /></View>;
+  return <View style={styles.root}><View style={[styles.header, { paddingTop: insets.top + spacing.sm }]}><Pressable accessibilityLabel="Back" style={styles.icon} onPress={() => router.back()}><Feather name="arrow-left" size={19} color={colors.onSurface} /></Pressable><Text style={styles.title}>Membership Management</Text></View><ScrollView contentContainerStyle={styles.content}>
+    <Text style={styles.notice}>Only server-verified captured payments are counted as revenue. Activation is unavailable until payment confirmation; this screen never fabricates payment success.</Text>{notice ? <Text style={styles.error}>{notice}</Text> : null}
+    <View style={styles.grid}>{[["Requests", summary?.total_requests], ["Pending", summary?.payment_pending], ["Confirmed", summary?.payment_confirmed], ["Active", summary?.active], ["Verified revenue", inr(summary?.verified_revenue_paise)]].map(([label, value]) => <View key={String(label)} style={styles.metric}><Text style={styles.label}>{label}</Text><Text style={styles.value}>{String(value ?? 0)}</Text></View>)}</View>
+    {items.map((item) => <View key={item.id} style={styles.card}><Text style={styles.cardTitle}>Shop {item.shop_id}</Text><Text style={styles.meta}>{item.status} · {inr(item.price_paise)}</Text>{item.status === "payment_confirmed" ? <Pressable style={styles.button} onPress={() => void decide(item, "activate")}><Text style={styles.buttonText}>Activate verified membership</Text></Pressable> : null}{item.status === "active" ? <Pressable style={styles.secondary} onPress={() => void decide(item, "suspend")}><Text style={styles.secondaryText}>Suspend</Text></Pressable> : null}</View>)}
+  </ScrollView></View>;
