+  const load = useCallback(async () => { if (user?.role !== "shopkeeper") return; const current = await api.get<Shop | null>("/shops/mine"); setShop(current); const campaigns = await api.get<Advertisement[]>("/advertisements/mine"); setRows(campaigns); }, [user?.role]);
