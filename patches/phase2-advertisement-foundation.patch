+"""Source-level contracts for Phase 2 advertisement safety boundaries."""
+from pathlib import Path
+
+from chand_advertisement_adapter import review_advertisement
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SERVER = (ROOT / "server.py").read_text()
+
+
+def test_advertisement_routes_keep_chand_and_admin_publication_separate():
+    assert '@api.post("/advertisements/{advertisement_id}/chand-review")' in SERVER
+    assert '@api.patch("/admin/advertisements/{advertisement_id}")' in SERVER
+    assert 'admin_approval_required": True' in SERVER
+    assert 'CHAND review must complete safely before final admin approval' in SERVER
+
+
+def test_advertisement_upload_is_a_bounded_verified_poster_path():
+    assert 'AD_POSTER_MAX_BYTES = 2 * 1024 * 1024' in SERVER
+    assert 'Poster bytes do not match the declared file type' in SERVER
+    assert 'Poster dimensions could not be verified' in SERVER
+    assert 'f"{APP_NAME}/advertisements/{advertisement_id}/' in SERVER
+
+
+def test_advertisement_authorization_and_event_deduplication_are_declared():
+    assert 'Depends(require_role("shopkeeper"))' in SERVER
+    assert 'You can only access your own advertisement' in SERVER
+    assert 'advertisement_events.create_index([("advertisement_id", 1), ("user_id", 1), ("event_type", 1), ("day", 1)], unique=True)' in SERVER
+    assert 'Only attributable authenticated events are recorded' in SERVER
+
+
+def test_unconfigured_chand_advertisement_review_never_claims_a_safe_decision(monkeypatch):
+    for name in ("COMEIN_AI_PROVIDER", "COMEIN_AI_BASE_URL", "COMEIN_AI_API_KEY", "COMEIN_AI_MODEL"):
+        monkeypatch.delenv(name, raising=False)
+    result = review_advertisement({"title": "Fresh groceries", "business_name": "A Shop", "destination": "/shops", "placement": "home_banner"})
+    assert result["status"] == "NOT_CONFIGURED"
+    assert result["decision"] == "needs_review"
+
+
+def test_advertisement_adapter_rejects_an_untrusted_or_invalid_provider_decision(monkeypatch):
+    monkeypatch.setenv("COMEIN_AI_PROVIDER", "openai_compatible")
+    monkeypatch.setenv("COMEIN_AI_BASE_URL", "https://provider.invalid/v1")
+    monkeypatch.setenv("COMEIN_AI_API_KEY", "unit-test-key")
+    monkeypatch.setenv("COMEIN_AI_MODEL", "test-model")
+
+    class Response:
+        def raise_for_status(self): pass
+        def json(self): return {"choices": [{"message": {"content": "{\\\"decision\\\": \\\"publish_now\\\"}"}}]}
+
+    result = review_advertisement({"title": "Sale", "business_name": "A Shop", "destination": "/shops", "placement": "home_banner"}, requester=lambda *args, **kwargs: Response())
+    assert result["status"] == "FAILED"
+    assert result["decision"] == "needs_review"
