+"""Contracts for the Phase 2 membership lifecycle and payment boundary."""
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SERVER = (ROOT / "server.py").read_text()
+FRONTEND = ROOT.parents[0] / "frontend"
+
+
+def test_membership_lifecycle_is_persisted_and_expiry_aware():
+    assert 'MEMBERSHIP_PRICE_PAISE = 29900' in SERVER
+    assert 'MEMBERSHIP_DURATION_DAYS = 30' in SERVER
+    assert '"status": "active"' in SERVER
+    assert '"expires_at": {"$gt": now}' in SERVER
+    assert 'memberships.create_index([("shop_id", 1), ("idempotency_key", 1)], unique=True)' in SERVER
+
+
+def test_membership_never_treats_a_request_or_signature_as_payment_success():
+    assert '@api.post("/shops/{shop_id}/membership/payment-intent")' in SERVER
+    assert '@api.post("/shops/{shop_id}/membership/payment-verify")' in SERVER
+    assert 'Payment could not be confirmed with the gateway; membership remains unpaid' in SERVER
+    assert 'payment.get("status") != "captured"' in SERVER
+    assert 'Membership needs verified payment confirmation before activation' in SERVER
+    assert 'hmac.compare_digest(expected, body.razorpay_signature)' in SERVER
+
+
+def test_membership_admin_reporting_and_seller_ui_keep_status_truthful():
+    assert '@api.get("/admin/memberships/report")' in SERVER
+    assert 'Revenue is recognized only for server-verified captured payments' in SERVER
+    seller_ui = (FRONTEND / "app" / "seller" / "membership.tsx").read_text()
+    assert '₹299' in seller_ui
+    assert 'for 30 days' in seller_ui
+    assert 'Payment is not complete and benefits are not active' in seller_ui
+    assert 'server-side signature and captured-payment verification' in seller_ui
