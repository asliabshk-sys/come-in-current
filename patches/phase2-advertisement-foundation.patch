+def _advertisement_out(advertisement: dict, *, public: bool = False) -> dict:
+    result = doc_out(advertisement)
+    if public:
+        for field in ("owner_id", "shop_id", "ai_review", "admin_reason", "poster_storage_path"):
+            result.pop(field, None)
+    return result
