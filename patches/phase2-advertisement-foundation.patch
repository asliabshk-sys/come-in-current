+@api.post("/shops/{shop_id}/membership/payment-intent")
+async def create_membership_payment_intent(shop_id: str, user: dict = Depends(require_role("shopkeeper"))):
+    """Create one gateway order for a pending membership; retries reuse it safely."""
+    shop = await _get_shop_or_404(shop_id); _assert_shop_owner(shop, user)
+    settings = _razorpay_settings()
+    key_id, secret = settings.key_id, settings.key_secret
+    if not key_id or not secret:
+        raise HTTPException(status_code=503, detail="Membership payments are not configured")
+    row = await db.memberships.find_one({"shop_id": shop_id, "owner_id": user["id"]}, sort=[("created_at", -1)])
+    if not row or row.get("status") != "payment_pending":
+        raise HTTPException(status_code=409, detail="Create a pending membership request before starting payment")
+    if row.get("gateway_order_id"):
+        return _membership_payment_intent_out(row, key_id)
+    import requests as http_requests
+    receipt = f"MEM-{str(row['_id'])[-12:]}"
+    try:
+        response = await asyncio.to_thread(lambda: http_requests.post(
+            "https://api.razorpay.com/v1/orders", auth=(key_id, secret), timeout=15,
+            json={"amount": int(row["price_paise"]), "currency": "INR", "receipt": receipt,
+                  "notes": {"comein_membership_id": str(row["_id"]), "shop_id": shop_id}},
+        ))
+        payload = response.json()
+        if response.status_code >= 400 or not payload.get("id") or payload.get("amount") != int(row["price_paise"]) or payload.get("currency") != "INR":
+            raise RuntimeError("Gateway membership intent mismatch")
+    except Exception as exc:
+        logger.warning("Membership gateway intent unavailable: %s", type(exc).__name__)
+        raise HTTPException(status_code=502, detail="Payment gateway is unavailable; no membership payment was created") from exc
+    written = await db.memberships.update_one(
+        {"_id": row["_id"], "status": "payment_pending", "gateway_order_id": {"$exists": False}},
+        {"$set": {"gateway": "razorpay", "gateway_order_id": payload["id"], "updated_at": now_utc()}},
+    )
+    if written.modified_count != 1:
+        fresh = await db.memberships.find_one({"_id": row["_id"]})
+        if fresh and fresh.get("gateway_order_id"):
+            return _membership_payment_intent_out(fresh, key_id)
+        raise HTTPException(status_code=409, detail="Membership payment intent changed; refresh and retry")
+    await db.membership_audit.insert_one({"membership_id": str(row["_id"]), "actor_id": user["id"], "event": "payment_intent_created", "created_at": now_utc()})
+    return _membership_payment_intent_out(await db.memberships.find_one({"_id": row["_id"]}), key_id)
+
