+async def _advertisement_or_404(advertisement_id: str) -> dict:
+    try:
+        oid = ObjectId(advertisement_id)
+    except Exception as exc:
+        raise HTTPException(status_code=404, detail="Advertisement not found") from exc
+    advertisement = await db.advertisements.find_one({"_id": oid})
+    if not advertisement:
+        raise HTTPException(status_code=404, detail="Advertisement not found")
+    return advertisement
