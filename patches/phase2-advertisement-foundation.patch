+import { useAuth } from "@/src/store/auth";
+import { makeStyles, radius, spacing, useTheme } from "@/src/theme";
+
+type Summary = { total_requests: number; active: number; payment_pending: number; payment_confirmed: number; verified_revenue_paise: number };
+type Membership = { id: string; shop_id: string; status: string; price_paise: number; created_at?: string };
+const inr = (paise = 0) => new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR" }).format(paise / 100);
+
+export default function AdminMembershipsScreen() {
+  const { user } = useAuth(); const router = useRouter(); const insets = useSafeAreaInsets(); const { colors } = useTheme(); const styles = useStyles();
+  const [summary, setSummary] = useState<Summary | null>(null); const [items, setItems] = useState<Membership[]>([]); const [notice, setNotice] = useState(""); const [loading, setLoading] = useState(true);
+  const load = useCallback(async () => { const [report, rows] = await Promise.all([api.get<Summary>("/admin/memberships/report"), api.get<Membership[]>("/admin/memberships")]); setSummary(report); setItems(rows); }, []);
+  useEffect(() => { if (!user || user.role !== "admin") return; const run = async () => { try { await load(); } catch (e: any) { setNotice(e?.message || "Membership reporting could not be loaded."); } finally { setLoading(false); } }; void run(); }, [load, user]);
