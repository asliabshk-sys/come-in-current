+def _assert_advertisement_owner(advertisement: dict, user: dict) -> None:
+    if user.get("role") == "admin":
+        return
+    if user.get("role") != "shopkeeper" or advertisement.get("owner_id") != user.get("id"):
+        raise HTTPException(status_code=403, detail="You can only access your own advertisement")
+
+
+def _assert_designated_advertisement_owner(user: dict) -> None:
+    """Publication is deliberately narrower than ordinary admin authority."""
+    owner_email = (os.environ.get("ADVERTISEMENT_OWNER_EMAIL") or "").strip().lower()
+    if user.get("role") != "admin" or not owner_email or user.get("email", "").strip().lower() != owner_email:
+        raise HTTPException(status_code=403, detail="Only the designated advertisement owner can publish a campaign")
