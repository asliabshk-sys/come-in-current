+def _restaurant_line_key(line):
+    return (line.menu_item_id, line.variant_id, tuple(sorted(line.add_on_ids)), line.instructions)
+
+
+def _restaurant_price_option(value):
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or not 0 <= value <= 100000:
+        raise HTTPException(409, "Menu price is no longer valid")
+    return float(value)
+
+
+async def _restaurant_resolve_line(restaurant_id, line):
+    if not ObjectId.is_valid(line.menu_item_id):
+        raise HTTPException(409, "Menu item is no longer available")
+    item = await db.restaurant_menu.find_one({"_id": ObjectId(line.menu_item_id), "restaurant_id": restaurant_id})
+    if not item or not item.get("available", True):
+        raise HTTPException(409, "Menu item is no longer available")
+    variants = {str(v["id"]): v for v in (item.get("variants") or []) if isinstance(v, dict) and v.get("id")}
+    selected = None
+    price = _restaurant_price_option(item.get("price"))
+    if line.variant_id:
+        variant = variants.get(line.variant_id)
+        if not variant or not variant.get("available", True):
+            raise HTTPException(409, "Selected variant is no longer available")
+        price = _restaurant_price_option(variant.get("price"))
+        selected = {"id": line.variant_id, "name": variant.get("name", "Variant"), "price": price}
+    elif variants:
+        raise HTTPException(409, "A current variant selection is required")
+    options = {str(x["id"]): x for x in (item.get("add_ons") or []) if isinstance(x, dict) and x.get("id")}
+    add_ons = []
+    if len(set(line.add_on_ids)) != len(line.add_on_ids):
+        raise HTTPException(409, "Duplicate add-on selection")
+    for identifier in line.add_on_ids:
+        option = options.get(identifier)
+        compatible = option.get("variant_ids") if option else None
+        if not option or not option.get("available", True) or (compatible is not None and (not isinstance(compatible, list) or line.variant_id not in compatible)):
+            raise HTTPException(409, "Selected add-on is no longer available for this selection")
+        add_ons.append({"id": identifier, "name": option.get("name", "Add-on"),
+                        "price": _restaurant_price_option(option.get("price", 0))})
+    unit = round(price + sum(option["price"] for option in add_ons), 2)
+    return {"menu_item_id": line.menu_item_id, "name": item["name"], "quantity": line.quantity,
+            "unit_price": unit, "line_total": round(unit * line.quantity, 2), "variant": selected,
+            "add_ons": add_ons, "instructions": line.instructions, "image_url": item.get("image_url")}
+
+
+async def _restaurant_quote(restaurant, lines, fulfillment):
+    if not restaurant.get(f"{fulfillment}_available", True):
+        raise HTTPException(409, f"{fulfillment.capitalize()} is unavailable")
+    if not lines:
+        raise HTTPException(422, "Your restaurant cart is empty")
+    restaurant_id = str(restaurant["_id"])
+    items = [await _restaurant_resolve_line(restaurant_id, line) for line in lines]
+    subtotal = sum(item["line_total"] for item in items)
+    if subtotal < float(restaurant.get("min_order", 0)):
+        raise HTTPException(400, f"Minimum order is ₹{restaurant.get('min_order', 0)}")
+    totals = calculate_restaurant_totals(subtotal, float(restaurant.get("delivery_fee", 0)),
+                                         float(restaurant.get("tax_rate", 5)), fulfillment)
+    snapshot = {"restaurant_id": restaurant_id, "fulfillment": fulfillment,
+                "items": [{k: v for k, v in item.items() if k != "image_url"} for item in items], **totals}
+    fingerprint = hashlib.sha256(json.dumps(snapshot, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+    return {"items": items, **totals, "fingerprint": fingerprint}
+
+
+@api.post("/restaurant/cart/quote")
+async def quote_restaurant_cart(body: RestaurantQuoteIn, user: dict = Depends(get_current_user)):
+    restaurant = await _restaurant_or_404(body.restaurant_id)
+    if restaurant.get("status") != "approved" or not restaurant.get("available", False):
+        raise HTTPException(409, "Restaurant is not accepting orders")
+    return await _restaurant_quote(restaurant, body.items, body.fulfillment)
+
+
+@api.post("/restaurant/orders/{order_id}/repeat")
+async def repeat_restaurant_order(order_id: str, body: RestaurantRepeatIn,
+                                  user: dict = Depends(require_role("customer"))):
+    order = await db.restaurant_orders.find_one({"_id": _object_id_or_404(order_id, "Order"), "customer_id": user["id"]})
+    if not order:
+        raise HTTPException(404, "Order not found")
+    if order.get("status") not in {"delivered", "picked_up"}:
+        raise HTTPException(409, "Only delivered or picked-up restaurant orders can be repeated")
+    restaurant_id = order["restaurant_id"]
+    restaurant = await _restaurant_or_404(restaurant_id)
+    if restaurant.get("status") != "approved" or not restaurant.get("available", False):
+        raise HTTPException(409, "This restaurant is not accepting orders")
+    cart = await db.restaurant_carts.find_one({"user_id": user["id"]})
+    if cart and cart.get("repeat_request_id") == body.request_id:
+        if cart.get("repeat_order_id") != order_id:
+            raise HTTPException(409, "This repeat request belongs to another order")
+        return cart["repeat_result"]
+    local = body.local_cart
+    if ((cart and cart.get("items") and cart.get("restaurant_id") != restaurant_id)
+            or (local and local.items and local.restaurant_id != restaurant_id)):
+        raise HTTPException(409, "Your food cart has items from another restaurant. Resolve it in your cart first.")
+
+    try:
+        existing = [RestaurantOrderLineIn.model_validate(row) for row in (cart or {}).get("items", [])]
+    except ValidationError as exc:
+        raise HTTPException(409, "Review invalid selections in your existing food cart") from exc
+    if local and local.items and existing and local.items != existing:
+        raise HTTPException(409, "Your saved and device carts differ. Review your food cart before repeating.")
+    if local and not existing:
+        existing = local.items
+    merged = {}
+    for line in existing:
+        try:
+            await _restaurant_resolve_line(restaurant_id, line)
+        except HTTPException as exc:
+            raise HTTPException(409, "Review unavailable selections in your existing food cart") from exc
+        key = _restaurant_line_key(line)
+        quantity = line.quantity + (merged[key].quantity if key in merged else 0)
+        if quantity > 99:
+            raise HTTPException(409, "Review quantities in your existing food cart")
+        merged[key] = line.model_copy(update={"quantity": quantity})
+    skipped, changes, added = [], [], 0
+    for previous in order.get("items", []):
+        name = previous.get("name", "Menu item") if isinstance(previous, dict) else "Menu item"
+        try:
+            if not isinstance(previous, dict) or type(previous.get("quantity")) is not int:
+                raise ValueError("Invalid historical quantity")
+            variant = previous.get("variant")
+            add_ons = previous.get("add_ons", [])
+            line = RestaurantOrderLineIn(
+                menu_item_id=previous["menu_item_id"], quantity=previous["quantity"],
+                variant_id=variant["id"] if variant is not None else previous.get("variant_id"),
+                add_on_ids=[item["id"] for item in add_ons] if "add_ons" in previous else previous.get("add_on_ids", []),
+                instructions=previous.get("instructions") or "",
+            )
+            current = await _restaurant_resolve_line(restaurant_id, line)
+            key = _restaurant_line_key(line)
+            quantity = line.quantity + (merged[key].quantity if key in merged else 0)
+            if quantity > 99 or (key not in merged and len(merged) >= 100):
+                raise HTTPException(409, "Cart quantity or item limit would be exceeded")
+        except HTTPException as exc:
+            skipped.append({"name": name, "reason": exc.detail})
+            continue
+        except (ValueError, KeyError, TypeError):
+            skipped.append({"name": name, "reason": "Saved selections could not be verified"})
+            continue
+        merged[key] = line.model_copy(update={"quantity": quantity})
+        old_price = previous.get("unit_price")
+        if isinstance(old_price, (int, float)) and old_price != current["unit_price"]:
+            changes.append({"name": name, "previous": old_price, "current": current["unit_price"]})
+        added += line.quantity
+
+    result = {"added": added, "skipped": skipped, "price_changes": changes}
+    if not added:
+        return result
+    query = ({"_id": cart["_id"], "updated_at": cart.get("updated_at"), "items": cart.get("items", [])} if cart
+             else {"user_id": user["id"], "updated_at": {"$exists": False}})
+    try:
+        written = await db.restaurant_carts.update_one(query, {"$set": {
+            "user_id": user["id"], "restaurant_id": restaurant_id,
+            "items": [line.model_dump() for line in merged.values()], "updated_at": now_utc(),
+            "repeat_request_id": body.request_id, "repeat_order_id": order_id, "repeat_result": result,
+        }}, upsert=not cart)
+    except DuplicateKeyError:
+        written = None
+    if not written or (written.matched_count != 1 and written.upserted_id is None):
+        latest = await db.restaurant_carts.find_one({"user_id": user["id"]})
+        if latest and latest.get("repeat_request_id") == body.request_id and latest.get("repeat_order_id") == order_id:
+            return latest["repeat_result"]
+        raise HTTPException(409, "Your food cart changed. Review it before repeating the order.")
+    return result
+
