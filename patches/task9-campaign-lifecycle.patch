+class GroceryCouponStatusIn(BaseModel):
+    status: Literal["active", "paused", "closed"]
+    expected_status: Literal["active", "paused"]
+    reason: str = Field(min_length=5, max_length=500)
+
+
+@api.get("/admin/financial/grocery-coupons")
+async def list_grocery_coupon_campaigns(_: dict = Depends(require_role("admin"))):
+    return [doc_out(row) async for row in db.financial_policy_drafts.find(
+        {"activation.code": {"$exists": True}},
+        {"_id": 1, "activation.code": 1, "status": 1, "budget_paise": 1, "spent_paise": 1,
+         "redemptions": 1, "starts_at": 1, "expires_at": 1},
+    ).sort("activated_at", -1).limit(100)]
+
+
+@api.patch("/admin/financial/grocery-coupons/{code}")
+async def change_grocery_coupon_status(code: str, body: GroceryCouponStatusIn, user: dict = Depends(require_role("admin"))):
+    if not re.fullmatch(r"[A-Z0-9][A-Z0-9_-]{2,31}", code):
+        raise HTTPException(404, "Coupon campaign not found")
+
+    async def apply(session):
+        key = f"coupon:{code}"
+        source = await db.financial_policy_drafts.find_one({"_id": key}, session=session)
+        if not source:
+            raise HTTPException(404, "Coupon campaign not found")
+        current = source["status"]
+        if current == body.status:
+            return {"code": code, "status": current}
+        if current != body.expected_status:
+            raise HTTPException(409, "Coupon campaign state changed")
+        now = now_utc()
+        if body.status == "active" and utc(source["expires_at"]) <= now:
+            raise HTTPException(409, "Expired coupon campaigns cannot resume")
+        response = await db.financial_policy_drafts.update_one({"_id": key, "status": current},
+            {"$set": {"status": body.status, "status_updated_at": now}}, session=session)
+        if response.modified_count != 1:
+            raise HTTPException(409, "Coupon campaign state changed")
+        await db.financial_audit.insert_one({"action": "grocery_coupon_status_changed", "coupon_code": code,
+            "from_status": current, "to_status": body.status, "reason": body.reason, "actor_id": user["id"],
+            "created_at": now}, session=session)
+        return {"code": code, "status": body.status}
+
+    return await _run_replacement_transaction(apply)
+
+
