+def _replacement_review_amount(review, stage):
+    quote_key, amount_key, required_decision = (
+        (("removal_quote", "potential_refund_paise", "keep_unavailable") if review.get("decision") == "keep_unavailable"
+         else ("replacement_refund_quote", "potential_refund_paise", "accept")) if stage == "refund"
+        else ("collection_quote", "difference_paise", "accept")
+    )
+    amount_paise = (review.get(quote_key) or {}).get(amount_key)
+    if review.get("decision") != required_decision or type(amount_paise) is not int or amount_paise <= 0:
+        raise HTTPException(409, "A positive server quote and matching customer decision are required.")
+    return amount_paise
+
