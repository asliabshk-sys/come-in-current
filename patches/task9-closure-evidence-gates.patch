+"""Offline Razorpay request and independently fetched response fixtures."""
+import hashlib
+import hmac
+import json
+
+import pytest
+
+from integrations.replacement_collection import (
+    collection_order_request,
+    reconcile_collection,
+    reconcile_collection_event,
+)
+
+
+@pytest.fixture
+def provider_records():
+    operation = "replacement:restaurant:" + "a" * 24 + ":fixture:collection"
+    intent = collection_order_request(operation, 15400, "pay_original")
+    order = dict(intent, id="order_replacement", status="paid", amount_paid=15400)
+    payment = {"id": "pay_replacement", "order_id": order["id"], "amount": 15400,
+               "currency": "INR", "status": "captured"}
+    return operation, intent, order, payment
+
+
+def test_collection_pending_failure_and_capture(provider_records):
+    operation, intent, order, payment = provider_records
+    assert intent == collection_order_request(operation, 15400, "pay_original")
+    assert len(intent["receipt"]) == 40
+    assert intent["receipt"] != collection_order_request(operation.replace(":fixture:", ":second:"), 15400, "pay_original")["receipt"]
+    pending = dict(order, status="attempted", amount_paid=0)
+    assert reconcile_collection(intent, pending) == "awaiting_payment"
+    assert reconcile_collection(intent, pending, dict(payment, status="failed")) == "payment_failed"
+    assert reconcile_collection(intent, pending, dict(payment, status="authorized")) == "awaiting_payment"
+    assert reconcile_collection(intent, pending, payment) == "reconciliation_required"
+    assert reconcile_collection(intent, order) == "reconciliation_required"
+    assert reconcile_collection(intent, order, payment) == "capture_observed"
+
+
+@pytest.mark.parametrize("field,value", [
+    ("id", "pay_original"), ("order_id", "order_other"), ("amount", 15401), ("currency", "USD"),
+])
+def test_collection_refuses_wrong_payment(provider_records, field, value):
+    _, intent, order, payment = provider_records
+    with pytest.raises(ValueError, match="does not match"):
+        reconcile_collection(intent, order, dict(payment, **{field: value}))
+
+
+def test_collection_requires_exact_order_balance_and_reference(provider_records):
+    _, intent, order, payment = provider_records
+    for bad_order in (dict(order, amount_paid=15500), dict(order, notes={}), dict(order, receipt="foreign")):
+        with pytest.raises(ValueError):
+            reconcile_collection(intent, bad_order, payment)
+
+
+def test_signed_event_matches_fetched_entities_and_replays_without_mutation(provider_records):
+    _, intent, order, payment = provider_records
+    raw = json.dumps({"event": "payment.captured", "payload": {"payment": {"entity": payment}}}).encode()
+    secret = "fixture-only-key"
+    signature = hmac.new(secret.encode(), raw, hashlib.sha256).hexdigest()
+    args = dict(raw=raw, signature=signature, secret=secret, event_id="evt_fixture")
+    for _ in range(2):
+        assert reconcile_collection_event(intent, order, payment, **args) == "capture_observed"
+    with pytest.raises(ValueError, match="signature"):
+        reconcile_collection_event(intent, order, payment, **dict(args, signature="bad"))
+    with pytest.raises(ValueError, match="disagree"):
+        reconcile_collection_event(intent, order, dict(payment, id="pay_other"), **args)
+    assert order["status"] == "paid" and payment["id"] == "pay_replacement"
