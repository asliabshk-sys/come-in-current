+"""Razorpay wire contract for replacement collections, with no network calls."""
+import hashlib
+import re
+
+from payment_webhook import verified_event
+
+_PROVIDER_ID = re.compile(r"[A-Za-z0-9_-]{1,128}")
+_OPERATION = re.compile(r"replacement:(grocery|restaurant):[a-f0-9]{24}:[A-Za-z0-9_-]{1,40}:collection")
+
+
+def collection_order_request(reference: str, amount_paise: int, original_payment_id: str) -> dict:
+    """Prepare a distinct provider order, bound to the existing capture."""
+    if (not isinstance(reference, str) or not _OPERATION.fullmatch(reference)
+            or type(amount_paise) is not int or amount_paise <= 0):
+        raise ValueError("Invalid replacement collection operation")
+    if not isinstance(original_payment_id, str) or not _PROVIDER_ID.fullmatch(original_payment_id):
+        raise ValueError("Invalid original capture identifier")
+    return {
+        "amount": amount_paise,
+        "currency": "INR",
+        "receipt": "repl_" + hashlib.sha256(reference.encode()).hexdigest()[:35],
+        "notes": {"replacement_reference": reference, "original_payment_id": original_payment_id},
+    }
+
+
+def reconcile_collection(request: dict, order: dict, payment: dict | None = None) -> str:
+    """Compare server-fetched provider entities, without mutating local state."""
+    if (not isinstance(order, dict) or not isinstance(order.get("id"), str) or not _PROVIDER_ID.fullmatch(order["id"])
+            or order.get("receipt") != request["receipt"] or order.get("notes") != request["notes"]
+            or type(order.get("amount")) is not int or order["amount"] != request["amount"]
+            or order.get("currency") != request["currency"]):
+        raise ValueError("Provider order does not match the replacement operation")
+    order_status = order.get("status")
+    amount_paid = order.get("amount_paid")
+    if (order_status not in {"created", "attempted", "paid"} or type(amount_paid) is not int
+            or amount_paid != (request["amount"] if order_status == "paid" else 0)):
+        raise ValueError("Inconsistent provider order balance")
+    if payment is None:
+        return "reconciliation_required" if order_status == "paid" else "awaiting_payment"
+    if not isinstance(payment, dict):
+        raise ValueError("Invalid provider payment")
+    payment_id = payment.get("id")
+    if (not isinstance(payment_id, str) or not _PROVIDER_ID.fullmatch(payment_id)
+            or payment_id == request["notes"]["original_payment_id"] or payment.get("order_id") != order["id"]
+            or type(payment.get("amount")) is not int or payment["amount"] != request["amount"]
+            or payment.get("currency") != request["currency"]):
+        raise ValueError("Provider payment does not match the replacement order")
+    if payment.get("status") == "captured" and order_status == "paid":
+        return "capture_observed"
+    if payment.get("status") == "failed" and order_status != "paid":
+        return "payment_failed"
+    if payment.get("status") in {"created", "authorized"} and order_status != "paid":
+        return "awaiting_payment"
+    return "reconciliation_required"
+
+
+def reconcile_collection_event(request: dict, order: dict, payment: dict, *, raw: bytes,
+                               signature: str, secret: str, event_id: str) -> str:
+    """Require both signed event identity and matching independently fetched data."""
+    event = verified_event(raw, signature, secret, event_id)
+    if event["event"] not in {"payment.captured", "payment.failed"}:
+        raise ValueError("Event is outside the replacement collection contract")
+    if not isinstance(payment, dict):
+        raise ValueError("Invalid provider payment")
+    entity = event["payload"]["payment"]["entity"]
+    if any(entity.get(field) != payment.get(field) for field in ("id", "order_id", "amount", "currency", "status")):
+        raise ValueError("Webhook and provider payment disagree")
+    return reconcile_collection(request, order, payment)
