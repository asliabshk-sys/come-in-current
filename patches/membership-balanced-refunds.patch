+"""Proposed operational rules. Gateway execution requires explicit enablement."""
+import os
+from datetime import timedelta
+
+from premium_exposure import utc
+
+
+def enabled(name, default=False):
+    return os.getenv(name, "true" if default else "false").strip().lower() == "true"
+
+
+def outage_threshold():
+    return timedelta(hours=int(os.getenv("MEMBERSHIP_OUTAGE_HOURS", "48")))
+
+
+def impact(outage, membership, now):
+    start = utc(membership.get("starts_at"))
+    end = utc(membership.get("expires_at"))
+    if not start or not end:
+        return timedelta(0)
+    return max(timedelta(0), min(end, utc(outage.get("recovered_at")) or now, now)
+               - max(start, utc(outage["started_at"])))
+
+
+def permitted(case, membership, now, outage=None):
+    reason = case["reason"]
+    if reason == "duplicate":
+        return case["_id"] != membership.get("gateway_payment_id")
+    if case["_id"] != membership.get("gateway_payment_id"):
+        return False
+    if reason in {"pre_activation", "wrong_purchase", "not_activated"}:
+        return enabled("MEMBERSHIP_PRE_ACTIVATION_REFUNDS", True) and not membership.get("starts_at")
+    if reason == "technical":
+        return bool(outage and impact(outage, membership, now) >= outage_threshold())
+    if reason == "suspension":
+        return membership.get("suspension_finding") in {"mistaken", "technical_or_admin_error"}
+    return False
