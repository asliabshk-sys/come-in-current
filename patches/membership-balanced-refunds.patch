+            raise HTTPException(409, "Refund is no longer under review")
+        member = await db.memberships.find_one({"_id": ObjectId(row["membership_id"])}, session=session)
+        await _membership_lock(row["shop_id"], session)
+        if body.action == "review":
+            return await _set_membership_refund(row, "UNDER_REVIEW", user["id"], reason, session)
+        if body.action == "reject":
+            return await _set_membership_refund(row, "REJECTED", user["id"], reason, session)
+        now = now_utc()
+        if body.action == "activate":
+            if (row["reason"] != "not_activated" or member["status"] != "payment_confirmed"
+                    or member.get("gateway_payment_id") != payment_id or member.get("refund_hold")
+                    or await _membership_entitlement(row["shop_id"], session=session)
+                    or await db.memberships.find_one({"shop_id": row["shop_id"], "refund_hold": True}, session=session)):
+                return await _set_membership_refund(row, "UNDER_REVIEW", user["id"],
+                    reason + " · Activation unavailable", session, activation_attempted=True)
+            await db.memberships.update_one({"_id": member["_id"]}, {"$set": {"status": "active", "starts_at": now,
+                "expires_at": now + timedelta(days=MEMBERSHIP_DURATION_DAYS)}}, session=session)
+            await _membership_audit(member, user["id"], "activated_during_refund_review", session, reason=reason)
+            return await _set_membership_refund(row, "REJECTED", user["id"], reason, session, remedy="activation")
+        outage = await db.membership_outages.find_one({"_id": row["outage_id"]}, session=session) if row.get("outage_id") else None
+        if not membership_refund_policy.permitted(row, member, now, outage):
+            raise HTTPException(409, "The proposed policy does not permit this remedy")
+        if body.action == "extend":
+            if row["reason"] not in {"technical", "suspension"} or not body.extension_days or not member.get("expires_at"):
+                raise HTTPException(422, "An eligible extension and duration are required")
+            shop = await db.shops.find_one({"_id": ObjectId(row["shop_id"])}, session=session)
+            if not shop or shop.get("status") != "approved" or member["status"] not in {"active", "suspended"}:
+                raise HTTPException(409, "Shop and membership must be eligible for restoration")
+            active = await _membership_entitlement(row["shop_id"], session=session)
+            if active and active["_id"] != member["_id"]:
+                raise HTTPException(409, "Another entitlement is active")
+            expiry = max(now, utc(member["expires_at"])) + timedelta(days=body.extension_days)
+            await db.memberships.update_one({"_id": member["_id"]}, {"$set": {"expires_at": expiry, "status": "active"}}, session=session)
+            await _membership_audit(member, user["id"], "extended_after_review", session, reason=reason)
+            return await _set_membership_refund(row, "APPROVED", user["id"], reason, session, remedy="extension")
+        amount = body.amount_paise if body.amount_paise is not None else row["captured_paise"]
+        if amount > row["captured_paise"] or (amount < row["captured_paise"] and row["reason"] not in {"technical", "suspension"}):
+            raise HTTPException(422, "Refund amount is outside policy")
+        if row["reason"] == "not_activated" and not row.get("activation_attempted"):
