+async def _membership_refund_gateway(row, settings, submit, *, activation=False):
+    payment_id = row["_id"]
+    url = f"https://api.razorpay.com/v1/payments/{payment_id}"
+    auth = (settings.key_id, settings.key_secret)
+    response = await asyncio.to_thread(requests.get, url, auth=auth, timeout=15)
+    response.raise_for_status()
+    payment = response.json()
+    if (not isinstance(payment, dict) or payment.get("id") != payment_id
+            or payment.get("order_id") != row["gateway_order_id"] or payment.get("currency") != "INR"
+            or payment.get("status") not in {"captured", "refunded"} or type(payment.get("amount")) is not int
+            or payment["amount"] != row["captured_paise"]):
+        raise ValueError("Provider capture association does not match")
+    refunds = await asyncio.to_thread(_fetch_razorpay_refunds, payment_id, *auth)
+    if activation and (refunds or payment.get("amount_refunded", 0) or payment.get("status") != "captured"):
+        raise ValueError("Capture is no longer eligible for activation")
+    matching = [refund for refund in refunds if refund.get("receipt") == row["receipt"]
+                or (row.get("gateway_refund_id") and refund.get("id") == row["gateway_refund_id"])]
+    if len(matching) > 1:
+        raise ValueError("Multiple matching refunds require manual reconciliation")
+    if matching:
+        return matching[0]
+    if not submit:
+        return None
+    if refunds or payment.get("amount_refunded", 0) or payment.get("status") != "captured":
+        raise ValueError("Existing gateway refund requires manual reconciliation")
+    response = await asyncio.to_thread(requests.post, url + "/refund", auth=auth, timeout=15,
+                                      json={"amount": row["amount_paise"], "receipt": row["receipt"]})
+    response.raise_for_status()
+    return response.json()
+
