+async def _set_membership_refund(row, state, actor, reason, session=None, **details):
+    updates = {"state": state, "updated_at": now_utc(), "decision_reason": reason, **details}
+    result = await db.membership_refunds.update_one({"_id": row["_id"], "state": row["state"],
+                                                    "updated_at": row.get("updated_at")},
+        {"$set": updates, "$push": {"history": _refund_transition(state, actor, reason)}}, session=session)
+    if result.modified_count != 1:
+        raise HTTPException(409, "Refund changed; reload before retrying")
+    return {**row, **updates}
