+@api.post("/admin/membership-refunds/{payment_id}/{operation}")
+async def execute_membership_refund(payment_id: str, operation: Literal["process", "reconcile"],
+                                    user: dict = Depends(require_role("admin"))):
+    if not membership_refund_policy.enabled("MEMBERSHIP_REFUNDS_ENABLED"):
+        raise HTTPException(503, "Membership gateway refunds are disabled pending policy approval")
+    settings = _razorpay_settings()
+    row = await _load_membership_refund(payment_id)
+    submit = operation == "process"
+    if submit:
+        if row["state"] != "APPROVED" or row.get("remedy") != "refund":
+            raise HTTPException(409, "Only a newly approved refund can be processed")
+        async def claim(session):
+            await _membership_lock(row["shop_id"], session)
+            member = await db.memberships.find_one({"_id": ObjectId(row["membership_id"])}, session=session)
+            outage = await db.membership_outages.find_one({"_id": row["outage_id"]}, session=session) if row.get("outage_id") else None
+            if not membership_refund_policy.permitted(row, member, now_utc(), outage):
+                raise HTTPException(409, "Membership eligibility changed since approval")
+            if row.get("full_entitlement_refund") and not member.get("refund_hold"):
+                await db.memberships.update_one({"_id": member["_id"]}, {"$set": {"refund_hold": True}}, session=session)
+                await _membership_audit(member, user["id"], "refund_hold", session)
+            return await _set_membership_refund(row, "PROCESSING", user["id"], "Gateway request claimed", session)
+        row = await run_transaction(client, claim)
+        await _notify_membership_refund(row)
+    elif row["state"] != "PROCESSING":
+        raise HTTPException(409, "Only a processing refund can be reconciled")
+    try:
+        result = await _membership_refund_gateway(row, settings, submit)
+        updated = await _record_membership_refund_result(row, result, user["id"]) if result else row
+    except Exception as exc:
+        raise HTTPException(502, "Refund remains processing; reconcile with the gateway before acting") from exc
+    if updated["state"] != row["state"]:
+        await _notify_membership_refund(updated)
+    return _refund_view(updated, True)
+
+
+@api.post("/admin/membership-outages")
+async def record_membership_outage(body: MembershipOutageIn, user: dict = Depends(require_role("admin"))):
+    now = now_utc()
+    started, recovered = utc(body.started_at), utc(body.recovered_at)
+    if started > now or (recovered and not started < recovered <= now) or len(body.evidence.strip()) < 8:
+        raise HTTPException(422, "Verified outage dates and evidence are required")
+    key = hashlib.sha256(f"{body.service}:{started.isoformat()}".encode()).hexdigest()
+    interval = {"service": body.service, "started_at": started, "recovered_at": recovered,
+                "evidence": body.evidence.strip(), "verified_by": user["id"]}
+    await db.membership_outages.update_one({"_id": key}, {"$setOnInsert": interval}, upsert=True)
+    if recovered:
+        await db.membership_outages.update_one({"_id": key, "recovered_at": None}, {"$set": {
+            "recovered_at": recovered, "recovery_evidence": body.evidence.strip(), "recovered_by": user["id"]}})
+    outage = await db.membership_outages.find_one({"_id": key})
+    affected = 0
+    query = {"starts_at": {"$lt": outage.get("recovered_at") or now}, "expires_at": {"$gt": started},
+             "payment_confirmed_at": {"$exists": True}, "gateway_payment_id": {"$type": "string"}}
+    async for member in db.memberships.find(query):
+        if membership_refund_policy.impact(outage, member, now) >= membership_refund_policy.outage_threshold():
+            case, created = await _new_membership_refund(member, member["gateway_payment_id"], "technical",
+                                         "Verified service outage", user["id"], None, key)
+            if created:
+                await _notify_new_membership_refund(case)
+            elif case["reason"] == "technical" and not case.get("outage_id"):
+                await db.membership_refunds.update_one({"_id": case["_id"], "outage_id": None,
+                    "state": {"$in": ["REQUESTED", "UNDER_REVIEW"]}},
+                    {"$set": {"outage_id": key}, "$push": {"history": _refund_transition(case["state"], user["id"], "Verified outage linked")}})
+            affected += 1
+    return {**doc_out(outage), "eligible_memberships": affected,
+            "verified_duration_seconds": ((utc(outage.get("recovered_at")) or now) - utc(outage["started_at"])).total_seconds()}


