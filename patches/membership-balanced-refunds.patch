+            if state == "SUCCESSFUL":
+                changes.update(status="cancelled", refunded_at=now_utc())
+            await db.memberships.update_one({"_id": member["_id"]}, {"$set": changes}, session=session)
+            await _membership_audit(member, actor, "refund_" + state.lower(), session)
+        return updated
+
+    return await run_transaction(client, persist)
+
