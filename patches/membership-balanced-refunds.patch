+import { useCallback, useEffect, useState } from "react";
+import { Pressable, Text, TextInput, View } from "react-native";
+
+import { api } from "@/src/lib/api";
+import { makeStyles, radius, spacing } from "@/src/theme";
+
+type Payment = { id?: string; payment_verified?: boolean; created_at?: string };
+type Case = { id?: string; membership_id: string; shop_id: string; state: string; remedy?: string; reason: string; decision_reason?: string; gateway_refund_id?: string; created_at: string };
+const reasons = {
+  pre_activation: "Cancel before activation", wrong_purchase: "Wrong shop or purchase",
+  not_activated: "Paid but not activated", technical: "Technical outage",
+  suspension: "Suspension review", change_of_mind: "Change of mind",
+};
+
+export function MembershipRefunds({ shopId, payments = [], admin = false }: { shopId?: string; payments?: Payment[]; admin?: boolean }) {
+  const styles = useStyles();
+  const root = admin ? "/admin/membership-refunds" : `/shops/${encodeURIComponent(shopId || "")}/membership/refunds`;
+  const [rows, setRows] = useState<Case[]>([]);
+  const [membershipId, setMembershipId] = useState("");
+  const [reason, setReason] = useState<keyof typeof reasons>("pre_activation");
+  const [explanation, setExplanation] = useState("");
+  const [amount, setAmount] = useState("");
+  const [days, setDays] = useState("");
+  const [filter, setFilter] = useState({ shop_id: "", payment_id: "", state: "", start: "", end: "" });
+  const [query, setQuery] = useState("");
+  const [outage, setOutage] = useState({ service: "", started_at: "", recovered_at: "", evidence: "" });
+  const [details, setDetails] = useState("");
+  const [notice, setNotice] = useState("");
+  const [busy, setBusy] = useState(false);
+  const load = useCallback(async () => {
+    if (admin || shopId) setRows(await api.get<Case[]>(root + (query ? `?${query}` : "")));
+  }, [admin, query, root, shopId]);
+  useEffect(() => {
+    const timer = setTimeout(() => void load().catch(() => setNotice("Refund history could not be loaded.")), 0);
+    return () => clearTimeout(timer);
+  }, [load]);
+  const perform = async (work: () => Promise<unknown>) => {
+    if (busy) return;
+    setBusy(true); setNotice("");
+    try { await work(); await load(); }
+    catch (error) { setNotice((error as { message?: string })?.message || "Refund action could not be completed."); }
+    finally { setBusy(false); }
+  };
+  const action = (row: Case, command: string) => void perform(async () => {
+    const target = `${root}/${encodeURIComponent(row.id || "")}`;
+    if (command === "Details") {
+      const data = await api.get<{ membership?: { status: string }; outage?: { service: string; evidence: string }; usage?: number }>(target);
+      setDetails(`Membership: ${data.membership?.status || "Unavailable"} · Impressions: ${data.usage ?? "Unavailable"}${data.outage ? ` · ${data.outage.service}: ${data.outage.evidence}` : ""}`);
+      return;
+    }
+    if (command === "process" || command === "reconcile") {
+      await api.post(`${target}/${command}`, {});
+      return;
+    }
+    if ((amount && !/^\d+$/.test(amount)) || (days && !/^\d+$/.test(days))) throw new Error("Enter whole paise and days.");
+    await api.patch(target, { action: command, reason: explanation, amount_paise: amount ? Number(amount) : undefined, extension_days: days ? Number(days) : undefined });
+  });
+  const button = (label: string, onPress: () => void, disabled = false) => (
+    <Pressable key={label} accessibilityRole="button" disabled={disabled || busy} style={styles.button} onPress={onPress}><Text style={styles.text}>{label}</Text></Pressable>
+  );
+  return <View style={styles.panel}>
+    <Text style={styles.title}>Membership refunds</Text>
+    <Text style={styles.text}>Proposed policy, subject to owner approval and legal review. Approved requests require gateway confirmation.</Text>
+    {notice ? <Text accessibilityRole="alert" style={styles.text}>{notice}</Text> : null}
+    {admin ? <>
+      {(Object.keys(filter) as (keyof typeof filter)[]).map(key => <TextInput key={key} accessibilityLabel={key} placeholder={key === "start" || key === "end" ? `${key} YYYY-MM-DD (UTC)` : key} value={filter[key]} onChangeText={value => setFilter({ ...filter, [key]: value })} style={styles.input} />)}
+      {button("Filter refunds", () => {
+        const params = new URLSearchParams();
+        for (const [key, value] of Object.entries(filter)) if (value.trim()) params.set(key, key === "start" || key === "end" ? `${value.trim()}T00:00:00Z` : value.trim());
+        setQuery(params.toString());
+      })}
+      <Text style={styles.title}>Record a verified outage</Text>
+      <Text style={styles.text}>Service: highlight, search, discovery, or entitlement. Supply UTC timestamps and a monitoring or incident reference.</Text>
+      {(Object.keys(outage) as (keyof typeof outage)[]).map(key => <TextInput key={key} accessibilityLabel={key} placeholder={key} value={outage[key]} onChangeText={value => setOutage({ ...outage, [key]: value })} style={styles.input} />)}
+      {button("Record verified outage", () => void perform(async () => {
+        const result = await api.post<{ eligible_memberships: number }>("/admin/membership-outages", { ...outage, recovered_at: outage.recovered_at || undefined });
+        setNotice(`${result.eligible_memberships} memberships met the outage threshold.`);
+      }), !outage.service || !outage.started_at || outage.evidence.trim().length < 8)}
+      <TextInput accessibilityLabel="Decision reason" placeholder="Decision reason" value={explanation} onChangeText={setExplanation} maxLength={500} style={styles.input} />
+      <TextInput accessibilityLabel="Refund amount in paise" placeholder="Refund amount in paise (optional)" value={amount} onChangeText={setAmount} keyboardType="number-pad" style={styles.input} />
+      <TextInput accessibilityLabel="Extension days" placeholder="Extension days (optional)" value={days} onChangeText={setDays} keyboardType="number-pad" style={styles.input} />
+    </> : <>
+      {payments.filter(row => row.payment_verified && row.id).map(row => <Pressable key={row.id} accessibilityRole="button" accessibilityState={{ selected: membershipId === row.id }} onPress={() => setMembershipId(row.id || "")} style={styles.button}><Text style={styles.text}>{membershipId === row.id ? "Selected · " : ""}{row.created_at ? new Date(row.created_at).toLocaleDateString() : "Verified payment"} · {row.id}</Text></Pressable>)}
+      {membershipId ? <>
+        {(Object.keys(reasons) as (keyof typeof reasons)[]).map(key => button(`${reason === key ? "✓ " : ""}${reasons[key]}`, () => setReason(key)))}
+        <TextInput accessibilityLabel="Refund explanation" placeholder="Short explanation" value={explanation} onChangeText={setExplanation} maxLength={500} style={styles.input} />
+        {button("Request refund review", () => void perform(() => api.post(root, { membership_id: membershipId, reason, explanation })), explanation.trim().length < 3)}
+      </> : null}
+    </>}
+    {details ? <Text style={styles.text}>{details}</Text> : null}
+    {rows.map((row, index) => <View key={row.id || `${row.membership_id}:${index}`} style={styles.panel}>
+      <Text style={styles.title}>{row.state.replaceAll("_", " ")} · {row.reason.replaceAll("_", " ")}</Text>
+      <Text style={styles.text}>{new Date(row.created_at).toLocaleDateString()}{admin ? ` · Shop ${row.shop_id} · Payment ${row.id}` : ""}</Text>
+      {row.decision_reason && <Text style={styles.text}>{row.decision_reason}</Text>}
+      {row.gateway_refund_id && <Text style={styles.text}>Gateway refund {row.gateway_refund_id}</Text>}
+      {admin && <>
+        {button("Details", () => action(row, "Details"))}
+        {["REQUESTED", "UNDER_REVIEW"].includes(row.state) && ["review", "approve", "reject", "extend", ...(row.reason === "not_activated" ? ["activate"] : [])].map(command => button(command, () => action(row, command), explanation.trim().length < 3))}
+        {row.state === "APPROVED" && row.remedy === "refund" && button("Process approved refund", () => action(row, "process"))}
+        {row.state === "PROCESSING" && button("Reconcile gateway status", () => action(row, "reconcile"))}
+      </>}
+    </View>)}
+  </View>;
+}
+
+const useStyles = makeStyles(colors => ({
+  panel: { backgroundColor: colors.surface, borderColor: colors.border, borderWidth: 1, borderRadius: radius.md, padding: spacing.md, gap: spacing.sm },
+  title: { color: colors.onSurface, fontSize: 14, fontWeight: "800" },
+  text: { color: colors.onSurface, fontSize: 12 },
+  input: { color: colors.onSurface, borderColor: colors.border, borderWidth: 1, borderRadius: radius.sm, padding: spacing.sm },
+  button: { backgroundColor: colors.surfaceSecondary, borderRadius: radius.sm, padding: spacing.sm },
+}));
