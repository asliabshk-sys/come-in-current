+"""Proposed policy and authenticated local Mongo integration with a fake gateway."""
+import asyncio
+from datetime import datetime, timedelta, timezone
+import os
+from types import SimpleNamespace
+from uuid import uuid4
+
+import pytest
+
+from membership_refund_policy import impact, permitted
+
+
+def test_balanced_policy_uses_verified_overlap_and_suspension_finding():
+    now = datetime.now(timezone.utc)
+    member = {"gateway_payment_id": "pay_initial", "starts_at": now - timedelta(days=8),
+              "expires_at": now + timedelta(days=10)}
+    case = {"_id": "pay_initial", "reason": "technical"}
+    incident = {"started_at": now - timedelta(hours=48)}
+    assert impact(incident, member, now) == timedelta(hours=48)
+    assert permitted(case, member, now, incident)
+    assert not permitted(case, member, now, {**incident, "recovered_at": now - timedelta(seconds=1)})
+    assert not permitted(case, member, now)
+    for reason in ("pre_activation", "wrong_purchase", "not_activated", "change_of_mind"):
+        assert not permitted({**case, "reason": reason}, member, now)
+    for reason in ("pre_activation", "wrong_purchase", "not_activated"):
+        assert permitted({**case, "reason": reason}, {**member, "starts_at": None}, now)
+    assert permitted({"_id": "pay_extra", "reason": "duplicate"}, member, now)
+    assert not permitted({**case, "reason": "duplicate"}, member, now)
+    for finding in ("mistaken", "technical_or_admin_error", "verified_misconduct", "investigating"):
+        assert permitted({**case, "reason": "suspension"}, {**member, "suspension_finding": finding}, now) == (finding in {"mistaken", "technical_or_admin_error"})
+
+
+def test_refunds_http_transactions_and_mock_gateway(monkeypatch):
+    if os.getenv("COMEIN_RUN_LOCAL_PAYMENT_TESTS") != "1":
+        pytest.skip("requires disposable local MongoDB replica set")
+    import httpx
+    from bson import ObjectId
+    from motor.motor_asyncio import AsyncIOMotorClient
+    import server
+
+    monkeypatch.setenv("JWT_SECRET", uuid4().hex)
+    monkeypatch.setattr(server, "_razorpay_settings", lambda: SimpleNamespace(key_id="fixture", key_secret="fixture"))
+    captures, refunds, posts = {}, {}, []
+    outcomes = {}
+
+    def response(value):
+        return SimpleNamespace(json=lambda: value, raise_for_status=lambda: None)
+
+    def get(url, **kw):
+        assert url.startswith("https://api.razorpay.com/v1/payments/")
+        return response(captures[url.rsplit("/", 1)[1]])
+
+    def post(url, *, json, **kw):
+        assert url.startswith("https://api.razorpay.com/v1/payments/") and url.endswith("/refund")
+        payment = url.split("/")[-2]
+        posts.append(payment)
+        record = {"id": "rf_" + payment, "payment_id": payment, **json, "status": outcomes.get(payment, "pending")}
+        refunds[payment] = [record]
+        if payment == "pay_duplicate":
+            raise TimeoutError("mocked response loss")
+        return response(record)
+
+    monkeypatch.setattr(server.requests, "get", get)
+    monkeypatch.setattr(server.requests, "post", post)
+    monkeypatch.setattr(server, "_fetch_razorpay_refunds", lambda payment, *auth: refunds.get(payment, []))
+
+    async def scenario():
+        mongo = AsyncIOMotorClient("mongodb://127.0.0.1:27018/?replicaSet=rs0", serverSelectionTimeoutMS=3000)
+        name = "comein_disposable_membership_refund_" + uuid4().hex[:16]
+        db = mongo[name]
+        monkeypatch.setattr(server, "db", db)
+        monkeypatch.setattr(server, "client", mongo)
+        try:
+            headers, users = {}, {}
+            for role in ("seller", "other", "admin"):
+                actor = ObjectId()
+                users[role] = str(actor)
+                permission = "admin" if role == "admin" else "shopkeeper"
+                await db.users.insert_one({"_id": actor, "role": permission})
+                headers[role] = {"Authorization": "Bearer " + server.create_access_token(str(actor), permission, f"{role}@local.test")}
+            shop = ObjectId()
+            await db.shops.insert_one({"_id": shop, "owner_id": users["seller"], "status": "approved"})
+
+            async def new_member(name, *, active=False, finding=None):
+                now = server.now_utc()
+                row = {"_id": ObjectId(), "shop_id": str(shop), "owner_id": users["seller"],
+                       "price_paise": 29900, "gateway_payment_id": name, "gateway_order_id": "order_" + name,
+                       "payment_confirmed_at": now, "status": "active" if active else "payment_confirmed"}
+                if active:
+                    row.update(starts_at=now - timedelta(days=5), expires_at=now + timedelta(days=25))
+                if finding:
+                    row.update(suspension_finding=finding, status="suspended")
+                captures[name] = {"id": name, "order_id": row["gateway_order_id"], "amount": 29900,
+                                  "currency": "INR", "status": "captured"}
+                await db.memberships.insert_one(row)
+                return row
+
+            async with httpx.AsyncClient(transport=httpx.ASGITransport(app=server.app), base_url="http://local") as http:
+                root = f"/api/shops/{shop}/membership/refunds"
+                admin = "/api/admin/membership-refunds"
+
+                async def call(method, path, who="admin", body=None):
+                    return await http.request(method, path, headers=headers.get(who), json=body)
+
+                async def request(row, reason="pre_activation", who="seller", **extra):
+                    return await call("POST", root, who, {"membership_id": str(row["_id"]), "reason": reason,
+                                                          "explanation": "Documented test request", **extra})
+
+                async def decide(payment, action="approve", **extra):
+                    return await call("PATCH", f"{admin}/{payment}", body={"action": action, "reason": "Documented local decision", **extra})
+
+                pending = await new_member("pay_pending")
+                assert (await request(pending, who="other")).status_code == 403
+                assert (await call("GET", admin, "seller")).status_code == 403
+                duplicate = await asyncio.gather(request(pending, state="SUCCESSFUL"), request(pending))
+                assert all(r.status_code == 200 and r.json()["state"] == "REQUESTED" for r in duplicate)
+                assert await db.membership_refunds.count_documents({}) == 1
+                assert (await decide("pay_pending", amount_paise=29901)).status_code == 422
+                assert (await decide("pay_pending", amount_paise=500)).status_code == 422
+                approvals = await asyncio.gather(decide("pay_pending"), decide("pay_pending"))
+                assert sorted(r.status_code for r in approvals) == [200, 409]
+                monkeypatch.delenv("MEMBERSHIP_REFUNDS_ENABLED", raising=False)
+                assert (await call("POST", admin + "/pay_pending/process")).status_code == 503
+                monkeypatch.setenv("MEMBERSHIP_REFUNDS_ENABLED", "true")
+                processing = await asyncio.gather(*(call("POST", admin + "/pay_pending/process") for _ in range(2)))
+                assert sorted(r.status_code for r in processing) == [200, 409]
+                assert posts == ["pay_pending"]
+                assert (await db.memberships.find_one({"_id": pending["_id"]}))["refund_hold"]
+                refunds["pay_pending"][0]["status"] = "processed"
+                captures["pay_pending"]["status"] = "refunded"
+                assert (await call("POST", admin + "/pay_pending/reconcile")).json()["state"] == "SUCCESSFUL"
+                assert (await db.memberships.find_one({"_id": pending["_id"]}))["status"] == "cancelled"
+                assert (await call("POST", admin + "/pay_pending/process")).status_code == 409
+
+                original = await new_member("pay_original", active=True)
+                duplicate_entity = {**captures["pay_original"], "id": "pay_duplicate"}
+                captures["pay_duplicate"] = duplicate_entity
+                await asyncio.gather(*(server._confirm_membership_capture(original, duplicate_entity, "pay_duplicate", "local_webhook") for _ in range(2)))
+                assert (await decide("pay_duplicate")).status_code == 200
+                assert (await call("POST", admin + "/pay_duplicate/process")).status_code == 502
+                refunds["pay_duplicate"][0]["status"] = "processed"
+                assert (await call("POST", admin + "/pay_duplicate/reconcile")).json()["state"] == "SUCCESSFUL"
+                assert (await db.memberships.find_one({"_id": original["_id"]}))["status"] == "active"
+                assert posts.count("pay_duplicate") == 1
+
+                assert (await request(original)).status_code == 409
+                assert (await request(original, "change_of_mind")).status_code == 200
+                assert (await decide("pay_original")).status_code == 409
+                assert (await decide("pay_original", "reject")).status_code == 200
+                mistaken = await new_member("pay_mistaken", active=True, finding="mistaken")
+                assert (await request(mistaken, "suspension")).status_code == 200
+                assert (await decide("pay_mistaken", amount_paise=1000)).status_code == 200
+                outcomes["pay_mistaken"] = "failed"
+                assert (await call("POST", admin + "/pay_mistaken/process")).json()["state"] == "FAILED"
+                assert not (await db.memberships.find_one({"_id": mistaken["_id"]})).get("refund_hold")
+
+                outage = {"service": "search", "started_at": (server.now_utc() - timedelta(hours=50)).isoformat(),
+                          "evidence": "Local monitoring fixture"}
+                assert (await call("POST", "/api/admin/membership-outages", "seller", outage)).status_code == 403
+                extension = await new_member("pay_extension", active=True)
+                first = (await call("POST", "/api/admin/membership-outages", body=outage)).json()
+                again = (await call("POST", "/api/admin/membership-outages", body=outage)).json()
+                assert first["id"] == again["id"] and first["verified_duration_seconds"] >= 48 * 3600
+                assert await db.membership_outages.count_documents({}) == 1
+                detail = (await call("GET", admin + "/pay_extension")).json()
+                assert detail["outage"]["id"] == first["id"]
+                await db.memberships.update_one({"_id": original["_id"]}, {"$set": {"expires_at": server.now_utc()}})
+                assert (await decide("pay_extension", "extend", extension_days=2)).json()["remedy"] == "extension"
+                assert (await db.memberships.find_one({"_id": extension["_id"]}))["expires_at"] > extension["expires_at"].replace(tzinfo=None)
+                rollback = await new_member("pay_rollback")
+                await request(rollback)
+                async def fail_audit(*args, **kwargs):
+                    raise RuntimeError("local transaction rollback")
+                with monkeypatch.context() as temporary:
+                    temporary.setattr(server, "_membership_audit", fail_audit)
+                    with pytest.raises(RuntimeError, match="local transaction rollback"):
+                        await decide("pay_rollback")
+                assert (await db.membership_refunds.find_one({"_id": "pay_rollback"}))["state"] == "REQUESTED"
+                assert not (await db.memberships.find_one({"_id": rollback["_id"]})).get("refund_hold")
+                assert await db.notifications.count_documents({"kind": "membership_refund"}) > 0
+                history = (await call("GET", root, "seller")).json()
+                assert all("gateway_order_id" not in item and "history" not in item for item in history)
+        finally:
+            await mongo.drop_database(name)
+            mongo.close()
+
+    asyncio.run(scenario())
