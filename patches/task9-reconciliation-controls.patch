+@api.get("/admin/financial/grocery-coupons/{code}/reconciliation")
+async def grocery_coupon_reconciliation(code: str, _: dict = Depends(require_role("admin"))):
+    if not re.fullmatch(r"[A-Z0-9][A-Z0-9_-]{2,31}", code):
+        raise HTTPException(404, "Coupon campaign not found")
+
+    async def read(session):
+        campaign = await db.financial_policy_drafts.find_one({"_id": f"coupon:{code}"}, session=session)
+        if not campaign:
+            raise HTTPException(404, "Coupon campaign not found")
+        audit = {row["_id"]: row async for row in db.financial_audit.aggregate([
+            {"$match": {"coupon_code": code, "action": {"$in": ["grocery_coupon_spent", "grocery_coupon_released"]}}},
+            {"$group": {"_id": "$action", "paise": {"$sum": "$amount_paise"}, "count": {"$sum": 1}}},
+        ], session=session)}
+        spend = audit.get("grocery_coupon_spent", {"paise": 0, "count": 0})
+        release = audit.get("grocery_coupon_released", {"paise": 0, "count": 0})
+        receipts = await db.orders.aggregate([
+            {"$match": {"coupon_redemption.code": code, "coupon_redemption.state": "spent"}},
+            {"$group": {"_id": None, "paise": {"$sum": "$coupon_redemption.discount_paise"}, "count": {"$sum": 1}}},
+        ], session=session).to_list(1)
+        active = receipts[0] if receipts else {"paise": 0, "count": 0}
+        spent, count = campaign["spent_paise"], campaign["redemptions"]
+        reconciled = (0 <= spent <= campaign["budget_paise"] and 0 <= count <= campaign["max_redemptions"]
+                      and spent == spend["paise"] - release["paise"] == active["paise"]
+                      and count == spend["count"] - release["count"] == active["count"])
+        return {"code": code, "status": "balanced" if reconciled else "review_required",
+                "funding_allocation_basis_points": campaign["funding_allocation_basis_points"],
+                "budget_paise": campaign["budget_paise"], "spent_paise": spent,
+                "remaining_paise": campaign["budget_paise"] - spent,
+                "active_redemptions": count, "receipt_paise": active["paise"], "receipt_count": active["count"],
+                "audit_spent_paise": spend["paise"], "audit_released_paise": release["paise"]}
+
+    return await _run_replacement_transaction(read)


