+@api.post("/admin/advertisements/{advertisement_id}/delivery-review")
+async def record_advertisement_delivery_review(advertisement_id: str, body: AdvertisementDeliveryReviewIn,
+                                               user: dict = Depends(require_role("admin"))):
+    oid = _object_id_or_404(advertisement_id, "Advertisement")
+    reason = body.reason.strip()
+    if len(reason) < 5:
+        raise HTTPException(422, "A review reason is required")
+
+    async def apply(session):
+        ad = await db.advertisements.find_one({"_id": oid}, session=session)
+        if not ad:
+            raise HTTPException(404, "Advertisement not found")
+        key = f"delivery-review:{oid}"
+        previous = await db.advertisement_audit.find_one({"_id": key}, session=session)
+        if previous:
+            if previous["reason"] != reason:
+                raise HTTPException(409, "A delivery review snapshot is already recorded")
+            return doc_out(previous)
+        terms = ad.get("commercial_terms") or {}
+        now = now_utc()
+        if (terms.get("model") != "fixed_duration" or not terms.get("accepted_at")
+                or not terms.get("delivery_target_impressions") or utc(ad["ends_at"]) > now
+                or not ad.get("poster_sha256")
+                or (ad.get("owner_approval") or {}).get("poster_sha256") != ad["poster_sha256"]):
+            raise HTTPException(409, "An ended campaign with an accepted fixed-duration target is required")
+        metrics = await _advertisement_delivery_metrics(ad, session=session)
+        budget = ad.get("commercial_budget") or {}
+        expected = terms["rate_paise"]
+        booked = budget.get("amount_paise") if budget.get("status") == "spent" else None
+        status = ("pending_compensation_policy" if metrics["contract_delivery"]["status"] != "target_met"
+                  else "target_met")
+        record = {"_id": key, "advertisement_id": str(oid), "event": "delivery_review_recorded",
+                  "actor_id": user["id"], "reason": reason, "created_at": now, "status": status,
+                  "terms_version": terms["version"], "starts_at": ad["starts_at"], "ends_at": ad["ends_at"],
+                  "delivery": metrics["contract_delivery"], "impressions": metrics["impressions"],
+                  "clicks": metrics["clicks"], "accepted_fixed_fee_paise": expected, "booked_paise": booked,
+                  "booking_difference_paise": booked - expected if booked is not None else None,
+                  "evidence_reference": budget.get("evidence_reference"),
+                  "financial_action_confirmed": False}
+        # Serialize with the existing fixed-fee and campaign lifecycle writes.
+        await db.advertisements.update_one({"_id": oid}, {"$set": {"delivery_review_recorded_at": now}}, session=session)
+        await db.advertisement_audit.insert_one(record, session=session)
+        return doc_out(await db.advertisement_audit.find_one({"_id": key}, session=session))
+
+    return await _run_replacement_transaction(apply)


