+@api.get("/admin/replacements/migration/{kind}/{order_id}/{case_id}")
+async def preview_legacy_replacement(kind: Literal["grocery", "restaurant"], order_id: str, case_id: str,
+                                     _: dict = Depends(require_role("admin"))):
+    collection, _ = _replacement_scope(kind)
+    oid = _object_id_or_404(order_id, "Order")
+
+    async def review(session):
+        order = await collection.find_one({"_id": oid}, session=session)
+        case = next((row for row in (order or {}).get("replacements", []) if row["id"] == case_id), None)
+        if not case:
+            raise HTTPException(404, "Replacement request not found.")
+        migration = case.get("legacy_migration")
+        if migration:
+            reason = migration.get("reason")
+            status = ("ambiguous" if reason in _AMBIGUOUS_REPLACEMENT_MIGRATION_REASONS else
+                      "excluded" if migration["status"] == "excluded" else "already_enrolled")
+        else:
+            _, reason = await _legacy_replacement_options(session, order, case, kind)
+            status = ("eligible" if not reason else
+                      "ambiguous" if reason in _AMBIGUOUS_REPLACEMENT_MIGRATION_REASONS else "excluded")
+        return {"status": status, "reason": reason, "counts": {
+                    value: int(status == value) for value in ("eligible", "excluded", "ambiguous", "already_enrolled")
+                }, "grace_hours": int(REPLACEMENT_MIGRATION_GRACE.total_seconds() // 3600),
+                "activation_minutes": DEFAULT_REPLACEMENT_EXPIRY_MINUTES}
+
+    return await _run_replacement_transaction(review)
+
