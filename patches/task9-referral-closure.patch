diff --git a/backend/tests/test_referral_task9_review_integration.py b/backend/tests/test_referral_task9_review_integration.py
new file mode 100644
--- /dev/null
+++ b/backend/tests/test_referral_task9_review_integration.py
@@ -0,0 +1,115 @@
+"""Verifies Task 9 referral accounting with real isolated transactions."""
+import asyncio
+import os
+from uuid import uuid4
+
+import pytest
+
+
+def test_concurrent_referral_qualification_and_threshold_rollback(monkeypatch):
+    if os.environ.get("COMEIN_RUN_LOCAL_PAYMENT_TESTS") != "1":
+        pytest.skip("requires disposable loopback MongoDB")
+    import httpx
+    from bson import ObjectId
+    from motor.motor_asyncio import AsyncIOMotorClient
+    import server
+
+    monkeypatch.setenv("JWT_SECRET", uuid4().hex)
+
+    async def scenario():
+        mongo = AsyncIOMotorClient("mongodb://127.0.0.1:27018/?replicaSet=rs0", serverSelectionTimeoutMS=3000)
+        db = mongo["comein_disposable_t9ref_" + uuid4().hex]
+        monkeypatch.setattr(server, "db", db)
+        monkeypatch.setattr(server, "client", mongo)
+        try:
+            await db.referrals.create_index("referred_user_id", unique=True)
+            await db.referral_rewards.create_index("reward_key", unique=True)
+            admin, seller, referrer = (ObjectId() for _ in range(3))
+            auth = {}
+            for actor, oid, role in (("admin", admin, "admin"), ("seller", seller, "shopkeeper"), ("referrer", referrer, "customer")):
+                email = f"{actor}@fixture.example"
+                await db.users.insert_one({"_id": oid, "role": role, "email": email})
+                auth[actor] = {"Authorization": "Bearer " + server.create_access_token(str(oid), role, email)}
+            with pytest.raises(server.HTTPException) as self_referral:
+                await server._record_referral_registration({"_id": referrer}, str(referrer), "fixture")
+            assert self_referral.value.status_code == 422
+
+            for _ in range(8):
+                early_order, early_customer = ObjectId(), ObjectId()
+                await db.orders.insert_one({"_id": early_order, "customer_id": str(early_customer),
+                                            "status": "delivered", "payment_status": "paid", "total": 100})
+                await db.referrals.insert_one({
+                    "referrer_id": str(referrer), "referred_user_id": str(early_customer), "status": "qualified",
+                    "qualifying_order_id": str(early_order), "qualifying_order_kind": "grocery", "reviewed_at": server.now_utc(),
+                })
+
+            async def candidate(kind, total=100, **extra):
+                owner, order = ObjectId(), ObjectId()
+                await db.users.insert_one({"_id": owner, "role": "customer", "address": "Shared household"})
+                await server._record_referral_registration({"_id": referrer}, str(owner), "fixture")
+                with pytest.raises(server.HTTPException) as duplicate:
+                    await server._record_referral_registration({"_id": referrer}, str(owner), "fixture")
+                assert duplicate.value.status_code == 409
+                collection = db.orders if kind == "grocery" else db.restaurant_orders
+                record = {"_id": order, "customer_id": str(owner), "total": total,
+                          "status": "delivered", "payment_status": "paid",
+                          "replacements": [{"state": "accepted", "id": "synthetic"}], **extra}
+                await collection.insert_one(record)
+                await server._refresh_referral_order_candidate(record, kind)
+                return await db.referrals.find_one({"referred_user_id": str(owner)})
+
+            grocery = await candidate("grocery")
+            restaurant = await candidate("restaurant", 120)
+            below = await candidate("grocery", 99.99)
+            refunded = await candidate("restaurant", refund_status="refunded")
+            assert below["status"] == refunded["status"] == "registered"
+
+            async with httpx.AsyncClient(transport=httpx.ASGITransport(app=server.app), base_url="http://local") as http:
+                payload = {"decision": "approve", "contact_verified": True, "contact_verification_method": "email",
+                           "payment_confirmed": True, "refund_return_checks_passed": True}
+
+                async def approve(referral, actor="admin"):
+                    return await http.patch(f"/api/admin/referrals/{referral['_id']}/review", json=payload, headers=auth[actor])
+
+                assert (await approve(grocery, "seller")).status_code == 403
+                original = server._maybe_create_referral_reward
+
+                async def interrupted(*args, **kwargs):
+                    await original(*args, **kwargs)
+                    raise RuntimeError("fixture interruption before transaction commit")
+
+                with monkeypatch.context() as failure:
+                    failure.setattr(server, "_maybe_create_referral_reward", interrupted)
+                    assert (await approve(grocery)).status_code == 503
+                assert (await db.referrals.find_one({"_id": grocery["_id"]}))["status"] == "pending_review"
+                assert await db.referral_audit.count_documents({"action": "referral_qualified"}) == 0
+                assert await db.referral_rewards.count_documents({}) == 0
+
+                results = await asyncio.gather(approve(grocery), approve(restaurant))
+                assert [row.status_code for row in results] == [200, 200]
+                assert (await approve(grocery)).status_code == 409
+                reward = await db.referral_rewards.find_one({"referrer_id": str(referrer)})
+                assert reward["status"] == "pending_verification"
+                assert reward["amount"] == server.REFERRAL_REWARD_INR
+                assert len(reward["qualifying_referral_ids"]) == server.REFERRAL_TARGET
+                assert await db.referral_rewards.count_documents({}) == 1
+                assert await db.referral_audit.count_documents({"action": "reward_threshold_reached"}) == 1
+                assert await db.referral_ledger.count_documents({}) == 0
+                reward_url = f"/api/admin/referral-rewards/{reward['_id']}"
+                order_oid = ObjectId(restaurant["qualifying_order_id"])
+                await db.restaurant_orders.update_one({"_id": order_oid}, {"$set": {"refund_status": "refunded"}})
+                assert (await http.patch(reward_url, json={"decision": "approve"}, headers=auth["admin"])).status_code == 422
+                assert await db.referral_ledger.count_documents({}) == 0
+                await db.restaurant_orders.update_one({"_id": order_oid}, {"$unset": {"refund_status": ""}})
+                credit = await asyncio.gather(*(http.patch(reward_url, json={"decision": "approve"}, headers=auth["admin"]) for _ in range(2)))
+                assert sorted(result.status_code for result in credit) == [200, 409]
+                entry = await db.referral_ledger.find_one({"reward_id": str(reward["_id"])})
+                assert entry["status"] == "approved" and entry["amount"] == server.REFERRAL_REWARD_INR
+                assert await db.referral_ledger.count_documents({}) == 1
+                assert await db.notifications.count_documents({"kind": "referral_reward", "data.reward_id": str(reward["_id"])}) == 1
+
+        finally:
+            await mongo.drop_database(db.name)
+            mongo.close()
+
+    asyncio.run(scenario())
