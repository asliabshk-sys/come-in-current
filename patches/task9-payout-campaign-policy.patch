+@api.put("/admin/advertisements/{advertisement_id}/commercial-terms")
+async def configure_advertisement_terms(advertisement_id: str, body: AdvertisementCommercialTermsIn,
+                                        user: dict = Depends(require_role("admin"))):
+    if body.daily_budget_paise > body.total_budget_paise:
+        raise HTTPException(422, "Daily cap exceeds the total budget")
+    if body.model == "fixed_duration" and body.rate_paise > body.daily_budget_paise:
+        raise HTTPException(422, "The agreed fixed fee must fit within the daily and total caps")
+    oid = _object_id_or_404(advertisement_id, "Advertisement")
+
+    async def apply(session):
+        ad = await db.advertisements.find_one({"_id": oid}, session=session)
+        if not ad:
+            raise HTTPException(404, "Advertisement not found")
+        previous = ad.get("commercial_terms", {})
+        if previous.get("accepted_at") or ad["status"] in {"approved", "removed"}:
+            raise HTTPException(409, "Accepted, published or removed campaigns cannot be repriced")
+        terms = {**body.model_dump(), "version": previous.get("version", 0) + 1, "updated_at": now_utc(),
+                 "starts_at": ad["starts_at"], "ends_at": ad["ends_at"], "placement": ad["placement"]}
+        await db.advertisements.update_one({"_id": oid}, {"$set": {"commercial_terms": terms}}, session=session)
+        await db.advertisement_audit.insert_one({"advertisement_id": advertisement_id, "event": "commercial_terms_configured",
+            "actor_id": user["id"], "terms": terms, "created_at": now_utc()}, session=session)
+        return terms
+
+    return await _run_replacement_transaction(apply)
