+@api.post("/admin/advertisements/{advertisement_id}/fixed-budget")
+async def adjust_advertisement_fixed_budget(advertisement_id: str, body: AdvertisementBudgetActionIn,
+                                            user: dict = Depends(require_role("admin"))):
+    """Book the accepted fixed fee once. This does not move money or spend from raw events."""
+    oid = _object_id_or_404(advertisement_id, "Advertisement")
+
+    async def apply(session):
+        ad = await db.advertisements.find_one({"_id": oid}, session=session)
+        if not ad:
+            raise HTTPException(404, "Advertisement not found")
+        terms = ad.get("commercial_terms") or {}
+        if not terms.get("accepted_at") or terms.get("model") != "fixed_duration":
+            raise HTTPException(409, "Accepted fixed-duration terms required")
+        budget = ad.get("commercial_budget") or {}
+        expected = {"reserve": "reserved", "record_verified_spend": "spent", "release": "released"}[body.action]
+        if budget.get("status") == expected:
+            if body.action == "record_verified_spend" and budget.get("evidence_reference") != (body.evidence_reference or "").strip():
+                raise HTTPException(409, "Fixed fee already recorded against different evidence")
+            return budget
+        now = now_utc()
+        if body.action == "reserve":
+            if (budget or ad["status"] != "approved" or not utc(ad["starts_at"]) <= now < utc(ad["ends_at"])
+                    or not ad.get("poster_sha256") or ad.get("owner_approval", {}).get("poster_sha256") != ad["poster_sha256"]):
+                raise HTTPException(409, "An active, moderated campaign with an unused budget is required")
+            amount = terms["rate_paise"]
+            if amount > min(terms["daily_budget_paise"], terms["total_budget_paise"]):
+                raise HTTPException(409, "The fixed fee exceeds the budget")
+            budget = {"amount_paise": amount, "reserved_at": now, "version": terms["version"]}
+        elif budget.get("status") != "reserved":
+            raise HTTPException(409, "No open reservation")
+        if body.action == "record_verified_spend":
+            reference = (body.evidence_reference or "").strip()
+            if not reference:
+                raise HTTPException(422, "An independently verified payment or invoice reference is required")
+            key = hashlib.sha256(reference.casefold().encode()).hexdigest()
+            try:
+                await db.advertisement_audit.insert_one({"_id": f"campaign-evidence:{key}", "event": "commercial_evidence_claimed",
+                    "advertisement_id": advertisement_id, "actor_id": user["id"], "created_at": now}, session=session)
+            except DuplicateKeyError as exc:
+                raise HTTPException(409, "Evidence reference already used") from exc
+            budget["evidence_reference"] = reference
+        budget.update({"status": expected, "remaining_paise": terms["total_budget_paise"] - (
+            budget["amount_paise"] if expected in {"reserved", "spent"} else 0), "updated_at": now})
+        await db.advertisements.update_one({"_id": oid}, {"$set": {"commercial_budget": budget}}, session=session)
+        await db.advertisement_audit.insert_one({"advertisement_id": advertisement_id,
+            "event": f"commercial_budget_{expected}", "actor_id": user["id"], "reason": body.reason,
+            "budget": budget, "created_at": now}, session=session)
+        return budget
+
+    return await _run_replacement_transaction(apply)


