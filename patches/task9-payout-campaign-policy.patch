+@api.put("/admin/earnings/payout-schedule")
+async def save_payout_schedule(body: PayoutScheduleIn, user: dict = Depends(require_role("admin"))):
+    if body.cycle_start.utcoffset() is None:
+        raise HTTPException(422, "Cycle start requires a timezone")
+    config = body.model_dump(exclude={"expected_version"})
+    config["eligible_statuses"] = sorted(config["eligible_statuses"])
+    config["cycle_start"] = config["cycle_start"].astimezone(timezone.utc)
+
+    async def apply(session):
+        key = "seller-payout-schedule"
+        previous = await db.financial_policy_drafts.find_one({"_id": key}, session=session) or {}
+        if previous.get("version", 0) != body.expected_version:
+            raise HTTPException(409, "Schedule version changed; reload before saving")
+        now = now_utc()
+        state = {"_id": key, "record_type": "payout_schedule", **config, "version": body.expected_version + 1,
+                 "updated_at": now, "actor_id": user["id"]}
+        await db.financial_policy_drafts.replace_one({"_id": key}, state, upsert=True, session=session)
+        await db.financial_audit.insert_one({"action": "seller_payout_schedule_updated", "actor_id": user["id"],
+            "version": state["version"], "configuration": config, "created_at": now}, session=session)
+        return doc_out(state)
+
+    return await _run_replacement_transaction(apply)
+
+
+def _completed_payout_cutoff(schedule, now):
+    start = utc(schedule["cycle_start"])
+    hold = timedelta(days=schedule["reconciliation_days"])
+    length = timedelta(days=schedule["cycle_days"])
+    days_since_processing = (now.weekday() - schedule["processing_weekday"]) % 7
+    run_day = (now - timedelta(days=days_since_processing)).date()
+    last_run = datetime.combine(run_day, start.timetz())
+    if last_run > now:
+        last_run -= timedelta(days=7)
+    cycles = (last_run - hold - start) // length
+    return start + cycles * length if cycles >= 1 else None
+
+
+async def _scheduled_payout_rows(rows, beneficiary_type, beneficiary_id):
+    rows = [row for row in rows if row.get("commission") == 0]
+    schedule = await db.financial_policy_drafts.find_one({"_id": "seller-payout-schedule"})
+    if not schedule:
+        return rows, {}
+    cutoff = _completed_payout_cutoff(schedule, now_utc())
+    eligible = {entry["order_id"] async for entry in db.financial_ledger.find({
+        "beneficiary_type": beneficiary_type, "beneficiary_id": beneficiary_id, "event_type": "order_finalized",
+        "recorded_at": {"$lt": cutoff}, "commission_amount": 0,
+    }, {"order_id": 1})} if cutoff else set()
+    rows = [row for row in rows if row["order_id"] in eligible and row["status"] in schedule["eligible_statuses"]]
+    return rows, {"schedule_version": schedule["version"], "cycle_cutoff": cutoff,
+                  "minimum_payout_paise": schedule["minimum_payout_paise"]}
+
